/* ===== Design Tokens (figma_design.md) ===== */
page {
  --color-page: #F8F3EA;
  --color-surface: #FFFEFB;
  --color-primary: #C0472A;
  --color-primary-soft: #EAA091;
  --color-ink: #4A2D23;
  --color-text: #7A5540;
  --color-muted: #B8904A;
  --color-placeholder: #DBCDBB;
  --color-border: #EDE0C8;
  --color-cream: #EDE5D2;

  /* difficulty labels */
  --diff-extreme-bg: #F5DDD5;
  --diff-extreme-text: #C0472A;
  --diff-normal-bg: #F2E4C0;
  --diff-normal-text: #C26B0C;
  --diff-easy-bg: #D8EAD8;
  --diff-easy-text: #4A7C59;

  /* ===== 行程状态墙（2026-09-20 首页行程化改版）=====
     口径来自 UI/V.0.2 设计稿与 demo/ticket-board-home 的既有迭代：
     状态标签用「浅底 + 深字」的对称色，底色走低饱和暖调，与难度标签同一族。
     ⚠️ 历史区的「没抢到」**不用红色**——红色是行动召唤色，
     历史里的失败已经无法挽回，用行动色只会让用户以为还能做点什么。 */
  --state-pending-bg: #F5DDD5;      /* 待抢：还没到点，最需要盯着 → 朱砂 */
  --state-pending-text: #C0472A;
  --state-bookable-bg: #F5D9A8;     /* 可抢：该动手了 → 金 */
  --state-bookable-text: #8A5A12;
  --state-success-bg: #D8EAD8;      /* 已成 */
  --state-success-text: #3E7D4F;
  --state-failed-bg: #F5DDD5;       /* 未成 */
  --state-failed-text: #C0472A;
  --state-unmarked-bg: #EDE5D2;     /* 开过票了：中性态，不判失败 */
  --state-unmarked-text: #7A5540;
  --state-free-bg: #EDE5D2;         /* 免预约 */
  --state-free-text: #7A5540;
  --state-history-bg: #EFE8DA;      /* 历史区灰化 */
  --state-history-text: #A89882;

  /* ⚠️ `--bubble-bg` / `--bubble-text` 已于 2026-09-23 删除：
     回填气泡按 UI/28.png 重做成卡片内的**一行**（无底色），这两个 token 再无使用方。 */
  --text-faint: #B09878;            /* 气泡提示语 / 「忽略」：浅一档的正文色 */
  --snackbar-bg: rgba(51,41,31,.92);

  /* ===== 行程项卡（2026-09-22 按 Figma UI/V.0.2 重取）=====
     ⚠️ 这几个是设计稿里的**新色**，与上面那批不是同一套取值，别为了「复用」硬套：
        `--color-text`/`--color-ink` 偏深，chip 文字和景点名要用更浅的一档；
        `--color-page` 虽然数值等于 chip 底色，但语义是「页面底色」，
        chip 借它用会在改页面底色时被一起改掉。 */
  --chip-muted-bg: #F8F3EA;         /* 中性 chip 底：提醒状态 / 未标记 / 免预约 */
  --chip-muted-text: #936F5B;       /* 中性 chip 字 */
  --chip-gold-bg: #F2E4C0;          /* 待抢票 / 日期徽标 */
  --chip-gold-text: #C26B0C;
  --chip-green-bg: #D8EAD8;         /* 可抢票 / 已约到 */
  --chip-green-text: #4A7C59;
  --chip-red-bg: #F5DDD5;           /* 未抢到 */
  --chip-red-text: #C0472A;
  --text-strong: #5E3D32;           /* 景点名 / 日期分段标题（比 --color-ink 浅一档） */
  --action-green: #4A7C59;          /* 副行「立即抢票」等行动文本 */
  --divider-strong: #DDD0B5;        /* 日期分段标题那条横线 */
  --snackbar-paper: #F2E4C0;        /* 撤销条：纸感金底（区别于旧的深色条） */

  /* shadows */
  --shadow-card: 0 2rpx 8rpx rgba(100,60,20,0.08);
  --shadow-input: 0 2rpx 16rpx rgba(100,60,20,0.08);
  --shadow-tabbar: 0 4rpx 12rpx rgba(100,60,20,0.10);

  background-color: var(--color-page);
  color: var(--color-ink);
  font-family: 'PingFang SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ===== Global Utilities ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--color-page);
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 16rpx;
}

.card {
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}

.text-primary { color: var(--color-primary); }
.text-ink { color: var(--color-ink); }
.text-muted { color: var(--color-muted); }
.text-placeholder { color: var(--color-placeholder); }

/* hide scrollbar */
::-webkit-scrollbar { display: none; }
