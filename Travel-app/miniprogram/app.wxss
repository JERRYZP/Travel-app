/* ===== Design Tokens (figma_design.md) ===== */
page {
  --color-page: #F8F3EA;
  --color-surface: #FFFEFB;
  --color-primary: #C0472A;
  --color-primary-soft: #EAA091;
  --color-ink: #4A2D23;
  --color-text: #7A5540;
  --color-muted: #B8904A;
  --color-placeholder: #DBCDBB;
  --color-border: #EDE0C8;
  --color-cream: #EDE5D2;

  /* difficulty labels */
  --diff-extreme-bg: #F5DDD5;
  --diff-extreme-text: #C0472A;
  --diff-normal-bg: #F2E4C0;
  --diff-normal-text: #C26B0C;
  --diff-easy-bg: #D8EAD8;
  --diff-easy-text: #4A7C59;

  /* shadows */
  --shadow-card: 0 2rpx 8rpx rgba(100,60,20,0.08);
  --shadow-input: 0 2rpx 16rpx rgba(100,60,20,0.08);
  --shadow-tabbar: 0 4rpx 12rpx rgba(100,60,20,0.10);

  background-color: var(--color-page);
  color: var(--color-ink);
  font-family: 'PingFang SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ===== Global Utilities ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--color-page);
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 16rpx;
}

.card {
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}

.text-primary { color: var(--color-primary); }
.text-ink { color: var(--color-ink); }
.text-muted { color: var(--color-muted); }
.text-placeholder { color: var(--color-placeholder); }

/* hide scrollbar */
::-webkit-scrollbar { display: none; }
