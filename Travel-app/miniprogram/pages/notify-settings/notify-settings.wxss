.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back { position: absolute; left: 20rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 30rpx; font-weight: 600; color: var(--color-ink); }

.page-body { padding: 32rpx 30rpx 120rpx; }

.intro { margin-bottom: 32rpx; }
.intro-title { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-ink); }
.intro-desc { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--color-muted); }

.auth-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.auth-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.auth-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.auth-icon {
  width: 64rpx; height: 64rpx; border-radius: 20rpx;
  background: var(--color-primary);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.auth-icon-warm { background: #FBF5E6; }  /* 金色时钟+红点角标，配浅暖底 */
.auth-icon-green { background: #D8EAD8; }  /* 绿图标配浅绿底 */
.auth-info { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.auth-label { font-size: 28rpx; font-weight: 600; color: var(--color-ink); }
.auth-hint { font-size: 22rpx; color: var(--color-muted); line-height: 1.4; }
.quota-num { font-size: 32rpx; font-weight: 700; color: #C0472A; }
.auth-health-summary { color: #7A5540; }
.auth-status { font-size: 24rpx; flex-shrink: 0; }
.auth-status.ok { color: #4A7C59; }
.auth-status.warn { color: #B8860B; }
.auth-status.off { color: #C0472A; }

.auth-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.auth-actions .auth-btn { flex: 1; margin-top: 0; }
.auth-btn {
  height: 72rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.auth-btn.secondary { background: var(--color-cream); color: var(--color-text); }
.auth-btn.disabled { background: var(--color-placeholder); }

.tips-card {
  background: var(--color-cream);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 32rpx;
}
.tips-title { display: block; font-size: 26rpx; font-weight: 600; color: var(--color-ink); margin-bottom: 12rpx; }
.tips-item { display: block; font-size: 22rpx; color: var(--color-text); line-height: 1.6; }
