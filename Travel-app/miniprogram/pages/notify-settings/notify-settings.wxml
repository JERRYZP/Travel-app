<view class="navbar" style="height: {{statusBarHeight + navBarHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-content" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="onBack">
      <svg-icon name="back-thick" size="18px" />
    </view>
    <text class="navbar-title">通知设置</text>
  </view>
</view>
<view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="page-body">
  <view class="intro">
    <text class="intro-title">按次获取提醒，放票前不缺席</text>
    <text class="intro-desc">每次授权 = 1 条放票提醒，可多次点击“续收 +1”</text>
  </view>

  <!-- ① 微信系统通知权限 -->
  <view class="auth-card">
    <view class="auth-row">
      <view class="auth-left">
        <view class="auth-icon auth-icon-warm"><svg-icon name="bell-fill" size="20px" /></view>
        <view class="auth-info">
          <text class="auth-label">微信通知权限</text>
          <text class="auth-hint">手机系统设置 → 通知 → 微信，关闭会收不到提醒</text>
        </view>
      </view>
      <view class="auth-status {{systemOk ? 'ok' : 'off'}}">{{systemOk ? '已开启' : '未开启'}}</view>
    </view>
    <view wx:if="{{!systemOk}}" class="auth-btn" bindtap="onOpenSystem">
      <text>去开启</text>
    </view>
  </view>

  <!-- ② 小程序订阅消息授权 -->
  <view class="auth-card">
    <view class="auth-row">
      <view class="auth-left">
        <view class="auth-icon auth-icon-green"><svg-icon name="chat-bubble" size="20px" /></view>
        <view class="auth-info">
          <text class="auth-label">{{templateName}}</text>
          <text class="auth-hint">{{templateDesc}}；微信为一次性订阅，剩余不足时提交会再次确认</text>
          <text wx:if="{{templateReady}}" class="auth-hint">本地记录可发次数：<text class="quota-num">{{subscribeQuota}}</text></text>
        </view>
      </view>
      <view class="auth-status {{subscribeOk ? 'ok' : 'off'}}">{{quotaLabel}}</view>
    </view>
    <!-- 对齐优剪模式：每个模板单独续收，同时保留微信授权设置入口 -->
    <view class="auth-actions">
      <view class="auth-btn {{templateReady ? '' : 'disabled'}}" bindtap="onRequestSubscribe">
        <text>{{templateReady ? '续收 +1' : '通道准备中'}}</text>
      </view>
      <view class="auth-btn secondary" bindtap="onOpenSubscribeSetting">
        <text>微信授权设置</text>
      </view>
    </view>
  </view>

  <!-- 说明 -->
  <view class="tips-card">
    <text class="tips-title">提醒机制说明</text>
    <text class="tips-item">· 微信订阅消息为「一次性订阅」：每次授权对应可发送 1 条放票提醒；可多次点击“续收 +1”积累，若微信侧拒收或耗尽会自动归零。</text>
    <text class="tips-item">· 短信提醒将在下个迭代上线，敬请期待。</text>
  </view>
</view>
