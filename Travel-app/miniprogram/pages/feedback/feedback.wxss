.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back { position: absolute; left: 20rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 30rpx; font-weight: 600; color: var(--color-ink); }

.page-body { padding: 32rpx 30rpx 120rpx; }

.form-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.form-label-row { display: flex; align-items: center; justify-content: space-between; }
.form-label { font-size: 26rpx; font-weight: 600; color: var(--color-ink); }
.form-count { font-size: 22rpx; color: var(--color-muted); }

.type-options { display: flex; gap: 20rpx; margin-top: 20rpx; }
.type-option {
  flex: 1;
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 24rpx;
  background: var(--color-page);
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  font-size: 26rpx; color: var(--color-ink);
}
.type-option.active { border-color: #B8904A; background: #FBF5E6; }
.radio {
  width: 30rpx; height: 30rpx; border-radius: 15rpx;
  border: 2rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
}
.radio.checked { background: #B8904A; border-color: #B8904A; }

.form-textarea {
  width: 100%; height: 220rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--color-page);
  border-radius: 16rpx;
  font-size: 26rpx; color: var(--color-ink);
}
.form-input {
  width: 100%;
  margin-top: 20rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--color-page);
  border-radius: 16rpx;
  font-size: 26rpx; color: var(--color-ink);
}
.form-placeholder { color: var(--color-placeholder); }

.submit-btn {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  width: 380rpx; height: 80rpx; margin: 48rpx auto 0;
  background: var(--color-primary); border-radius: 24rpx;
  color: #fff; font-size: 28rpx; font-weight: 600;
}
.submit-btn.disabled { opacity: 0.6; }
