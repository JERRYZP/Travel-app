<wxs module="asset" src="../../utils/cloud-assets.wxs"></wxs>
<wxs module="u" src="../../utils/format.wxs"></wxs>
<!-- 自定义导航栏：单形态，不再有双 Tab。
     ⚠️ 导航栏高度不读 app.js 的 navBarHeight（那是用胶囊按钮位置反推的，
     基础库把胶囊顶对齐之后会算出偏大的值）；导航块固定 88rpx，
     只有状态栏那一段跟着机型走 —— 它没有设计值，就是设备状态栏高度。
     ⚠️ 底色由 `navOpacity` 逐帧给出（滚 50px、透明度 0→1）。
        这里**不能**写死 `background: var(--color-page)`：写死就没有淡入，
        只能靠加 `.navbar-solid` 类在某一帧硬切，那会「啪」地闪一下。
        背景只此一处，写在 wxss 里两条都会打架。 -->
<view class="navbar" style="background-color: rgba(248, 243, 234, {{navOpacity}});">
  <view class="navbar-status" style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-content">
    <text class="navbar-title">行程·提醒</text>
  </view>
</view>

<!-- ⚠️ `pageTop` = 标题下沿（**不是**导航栏底边）。
     导航块 88rpx 是给胶囊按钮留的常规高度，标题在其中垂直居中，
     所以底边到标题下沿还空着约 21.5rpx —— 当前正文直接与标题下沿对齐，
     不再额外留白。
     现在只让出「(88 − 标题行高) / 2」那一截，不再补额外间距。
     导航栏是 fixed、正文必须让出它的高度，否则第一块内容会钻到标题底下；
     这里只让导航块的内缩，**不让横幅的高度**——横幅就在正文里，占位归它自己。 -->
<view class="page-body" style="padding-top: {{pageTop}}rpx;">

  <!-- 授权额度预警：只承载 48 小时内真正会影响送达的问题；可当天关闭。 -->
  <view wx:if="{{showReminderQuotaWarning}}" class="quota-warning-banner">
    <text class="qw-text">{{reminderQuotaWarning.text}}</text>
    <text class="qw-go" catchtap="onQuotaWarningOpen">去补齐</text>
    <view class="qw-close" catchtap="onQuotaWarningDismiss">
      <svg-icon name="close" size="12px" />
    </view>
  </view>

  <!-- 放票横幅：**在文档流里**（不是吸顶），跟着内容一起往上滑。
       ⚠️ 不要改回 `position: fixed`：那是「挡住行程卡」和「间距永远凑不准」
          两个问题的共同根源，原因写在 wxss 的 `.sticky-banner` 上。
       ⚠️ 与摘要卡之间**没有间距**（2026-09-23 用户要求去掉，原先的 16rpx
          margin-bottom 已删）；横幅当前 `margin-top: 0`，与标题下沿直接对齐。
          2026-09-28 顶部基准不再额外留白，别再按旧口径加 margin。 -->
  <!-- ⚠️ 没有 `&& !hideBanner` 这类收起条件：它跟着内容滚，滑下去自然被导航栏盖住。
       按滚动阈值把它摘出文档流会让下面的内容跳一个横幅高，别再加回来。 -->
  <view wx:if="{{banner}}" class="sticky-banner {{showReminderQuotaWarning ? 'sticky-banner--after-warning' : ''}}">
    <release-banner banner="{{banner}}" bind:open="onBannerOpen" />
  </view>

  <!-- ===== 空态：一个行程项都没有 → 创建引导（沿用 UI-009） ===== -->
  <block wx:if="{{!loading && trips.length === 0 && history.length === 0}}">
    <view class="empty-onboard">
      <view class="empty-hero-card">
        <!-- ⚠️ 空态头图走**包内小图**，不走云存储：这是新用户落地的第一屏，
             押在一次网络请求上就等于把「第一眼」交给弱网。
             ⚠️ 也**不能**写成 `{{asset.home('empty-hero-bg.png')}}`：`cloud-assets.wxs`
             的 home() 只吃运行时变量，编译期还会按字面量参数额外解析一次本地路径
             `/images/...`，本地没这个文件就是 `Error: ENOENT`（2026-09-30 踩过）。 -->
        <image class="empty-hero-bg" src="/images/home/empty-hero-bg.jpg" mode="aspectFill" />
        <view class="empty-hero-content">
          <image class="empty-hero-logo" src="/images/home/empty-hero-logo.png" mode="aspectFit" />
          <view class="empty-hero-copy">
            <text class="empty-hero-title">把每张票的放票时间盯住</text>
            <text class="empty-hero-sub">选好出行日和想去景点，直接算清哪天几点抢</text>
          </view>
        </view>
      </view>

      <!-- 用真实规则生成的结果预览替代三步说明：先让用户看见产品会产出什么。 -->
      <view class="empty-proof-card">
        <view class="ep-head">
          <text class="ep-head-title">案例展示</text>
          <text class="ep-head-tag">景点真实规则展示</text>
        </view>

        <view class="ep-journey">
          <view class="ep-stop">
            <view class="ep-stop-label-row">
              <svg-icon name="plan-gold" size="14px" />
              <text class="ep-stop-label">出行计划</text>
            </view>
            <text class="ep-stop-value">{{emptyReleaseSample.visitText}}</text>
          </view>
          <view class="ep-stop">
            <view class="ep-stop-label-row">
              <svg-icon name="clock-gold" size="14px" />
              <text class="ep-stop-label">开抢时间</text>
            </view>
            <text class="ep-stop-value">{{emptyReleaseSample.releaseText}}</text>
          </view>
          <view class="ep-stop">
            <view class="ep-stop-label-row">
              <svg-icon name="chat-linear" size="14px" />
              <text class="ep-stop-label">提前提醒</text>
            </view>
            <text class="ep-stop-value">{{emptyReleaseSample.remindText}}</text>
          </view>
        </view>

        <view class="ep-sample-entry" bindtap="onOpenReminderSamples">
          <svg-icon class="ep-wechat-icon" name="wechat-linear" size="28px" />
          <view class="ep-sample-copy">
            <view class="ep-sample-title-row">
              <text class="ep-sample-title">微信提示样式示例</text>
              <text class="ep-sample-action">点击查看</text>
            </view>
            <text class="ep-sample-desc">查看通知中心/锁屏界面、提醒卡片详情、微信内提醒</text>
          </view>
          <svg-icon name="chevron-right" size="14px" />
        </view>

        <view class="empty-cta" bindtap="onAddTrip">添加我的第一个行程</view>
        <text class="empty-trust">*只做提醒，不代抢 · 预约直达官网渠道</text>
      </view>
    </view>

    <view wx:if="{{emptyReleaseRows.length}}" class="empty-hot">
      <view class="empty-hot-head">
        <view class="empty-hot-head-copy">
          <text class="empty-hot-title">近期热门景点放票</text>
          <text class="empty-hot-note">按规则推算 · 不代表官方库存</text>
        </view>
        <view class="empty-hot-all" bindtap="onOpenAllSpots">
          <text class="empty-hot-all-text">全部景点</text>
          <svg-icon name="chevron-right" size="12px" />
        </view>
      </view>
      <view class="empty-hot-list">
        <view
          wx:for="{{emptyReleaseRows}}"
          wx:key="spotId"
          class="empty-hot-row"
          bindtap="onEmptySpotTap"
          data-id="{{item.spotId}}"
        >
          <image class="empty-hot-img" src="{{asset.spot(item.spotId)}}" mode="aspectFill" lazy-load="{{true}}" />
          <view class="empty-hot-main">
            <text class="empty-hot-name">{{item.name}}</text>
            <text class="empty-hot-status {{item._releaseTone}}">{{item._releaseStatusText}}</text>
          </view>
          <text wx:if="{{item._difficultyText}}" class="empty-hot-diff diff-{{item._difficultyKey}}">{{item._difficultyText}}</text>
          <svg-icon name="chevron-right-gold" size="14px" />
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 骨架层（2026-09-30）=====
       只在「没有本地缓存 + 正在等云端」时出现：没有它，冷启动的那几秒
       就是一片白底加一个转圈。这里画的是**对所有人成立**的内容 ——
       案例展示来自包内本地切片、近期热门景点同理，不谎称「你没有行程」
       （那要等云端确认，见上面空态块的 !loading）。
       ⚠️ 必须是 `wx:elif` —— 它是空态块与下面行程墙 `wx:else` 的同一条链。
       改回 `wx:if` 会让 wx:else 改绑到这一块，空态和行程墙同时渲染。 -->
  <block wx:elif="{{loading && !previewNewUser}}">
    <view class="home-skeleton">
      <view class="empty-proof-card">
        <view class="ep-head">
          <text class="ep-head-title">案例展示</text>
          <text class="ep-head-tag">景点真实规则展示</text>
        </view>
        <view class="ep-journey">
          <view class="ep-stop">
            <view class="ep-stop-label-row">
              <svg-icon name="plan-gold" size="14px" />
              <text class="ep-stop-label">出行计划</text>
            </view>
            <text class="ep-stop-value">{{emptyReleaseSample.visitText}}</text>
          </view>
          <view class="ep-stop">
            <view class="ep-stop-label-row">
              <svg-icon name="clock-gold" size="14px" />
              <text class="ep-stop-label">开抢时间</text>
            </view>
            <text class="ep-stop-value">{{emptyReleaseSample.releaseText}}</text>
          </view>
          <view class="ep-stop">
            <view class="ep-stop-label-row">
              <svg-icon name="chat-linear" size="14px" />
              <text class="ep-stop-label">提前提醒</text>
            </view>
            <text class="ep-stop-value">{{emptyReleaseSample.remindText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{emptyReleaseRows.length}}" class="empty-hot">
        <view class="empty-hot-head">
          <view class="empty-hot-head-copy">
            <text class="empty-hot-title">近期热门景点放票</text>
            <text class="empty-hot-note">按规则推算 · 不代表官方库存</text>
          </view>
        </view>
        <view class="empty-hot-list">
          <view
            wx:for="{{emptyReleaseRows}}"
            wx:key="spotId"
            class="empty-hot-row"
            bindtap="onEmptySpotTap"
            data-id="{{item.spotId}}"
          >
            <image class="empty-hot-img" src="{{asset.spot(item.spotId)}}" mode="aspectFill" lazy-load="{{true}}" />
            <view class="empty-hot-main">
              <text class="empty-hot-name">{{item.name}}</text>
              <text class="empty-hot-status {{item._releaseTone}}">{{item._releaseStatusText}}</text>
            </view>
            <text wx:if="{{item._difficultyText}}" class="empty-hot-diff diff-{{item._difficultyKey}}">{{item._difficultyText}}</text>
          </view>
        </view>
      </view>

      <view class="skel-loading">
        <van-loading size="32rpx" color="#B8904A" />
        <text class="skel-loading-text">正在读取你的行程…</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 全局摘要卡：只给最近的一趟，其他行程在各自的分段标题上显示紧凑进度。
         卡底部的「即将提醒」胶囊来自 stickyBanner.pills（服务端拼文案）。 -->
    <trip-summary-card trip="{{primaryTrip}}" pills="{{bannerPills}}" bind:pill="onBannerPillTap" />

    <!-- 分段墙：未结束行程按开始日期升序纵向排列，不做横向 Tab -->
    <view wx:for="{{trips}}" wx:key="_id" wx:for-item="trip">
      <!-- ⚠️ 下面这些 bind: 少一条，对应功能就是**彻底静默失效**（不报错、不提示）：
           - bind:menutoggle 漏了 → 点卡片三点菜单没反应（2026-09-21 用户报的就是这个）
           - bind:recoveritems 漏了 → 「约其他日」点不开
           - bind:missedreason 漏了 → 点「查看原因」没反应
           组件那边 triggerEvent 了不代表页面收得到，加事件时必须回这里补绑定。 -->
      <trip-section
        trip="{{trip}}"
        menu-id="{{menuId}}"
        menu-date="{{menuDate}}"
        dismissed="{{dismissed}}"
        recoverable-ids="{{recoverableIds}}"
        weak="{{trip._weak}}"
        bind:menutoggle="onCardMenuToggle"
        bind:missedreason="onMissedReason"
        bind:datemenu="onDateMenu"
        bind:datemenuclose="onMenuClose"
        bind:removedate="onRemoveDate"
        bind:menuclose="onMenuClose"
        bind:spot="onSpot"
        bind:mark="onMark"
        bind:editreminder="onEditReminder"
        bind:remove="onRemoveItem"
        bind:result="onResult"
        bind:dismiss="onDismissBubble"
        bind:dismissrecover="onDismissRecover"
        bind:recover="onRecover"
      />
    </view>

    <!-- 历史行程：一行收纳，点开平铺；卡片同款但灰化、无操作按钮 -->
    <view wx:if="{{history.length > 0}}" class="history">
      <view class="history-head" bindtap="onToggleHistory">
        <text class="hh-title">过往行程 ({{history.length}})</text>
        <svg-icon name="{{historyOpen ? 'chevron-up' : 'chevron-down'}}" size="14px" />
      </view>
      <block wx:if="{{historyOpen}}">
        <view wx:for="{{history}}" wx:key="_id" wx:for-item="trip">
          <trip-section trip="{{trip}}" history="{{true}}" />
        </view>
      </block>
    </view>

    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <van-loading size="40rpx" color="#B8904A" />
    </view>
  </block>

  <view wx:if="{{previewNewUser}}" class="dev-preview-notice">
    <text>开发预览：当前只是新用户空态，云端数据没有删除</text>
    <text class="dev-preview-exit" bindtap="onExitNewUserPreview">退出预览</text>
  </view>
</view>

<!-- 悬浮新增提醒。
     ⚠️ 只在**已有行程**时出现：空态本身已经有一个居中的「+ 新增提醒」，
     再叠一个就是同屏两个一模一样的入口。
     也带上 !loading —— 加载期间 isBlank 还没算出来（仍是初值 false），
     不加的话新用户一进页面会先看到悬浮按钮闪一下再消失。
     ⚠️ 再加 !previewNewUser：开发预览是空态，`isBlank` 虽是 true，
     但这里保留它只是为了让「预览态」与「真空态」未来分叉时不至于漏改。 -->
<view wx:if="{{!loading && !isBlank && !previewNewUser}}" class="fab-btn" bindtap="onAddTrip">
  <svg-icon name="plus-white" size="18px" />
  <text>新增提醒</text>
</view>

<!-- 景点详情浮窗（首页入口不渲染底部操作栏：首页即提醒动线的起点） -->
<spot-popup
  show="{{showSpotPopup}}"
  spot-id="{{popupSpotId}}"
  show-actions="{{false}}"
  show-share="{{true}}"
  bind:close="onSpotPopupClose"
  bind:loaded="onSpotPopupLoaded"
/>

<!-- 提醒样式示例：当前页直接弹出，不从设置页中转 -->
<reminder-sample-sheet show="{{showSampleSheet}}" bind:close="onCloseReminderSamples" />

<!-- 标记结果（次入口：补标走这里；主入口是卡片上的可抢态气泡） -->
<result-sheet
  show="{{showResultSheet}}"
  spot-name="{{sheetSpotName}}"
  current="{{sheetCurrent}}"
  bind:confirm="onResultConfirm"
  bind:close="onResultClose"
/>

<!-- 约其他日（日历选择器：已有行程日期浅色背景，该景点已有日期禁用） -->
<date-picker-sheet
  show="{{showDateSheet}}"
  spot-name="{{sheetSpotName}}"
  title="约其他日"
  trip-dates="{{dateTripDates}}"
  booked-dates="{{dateBookedDates}}"
  min-date="{{dateMinDate}}"
  bind:confirm="onRecoverConfirm"
  bind:close="onDateSheetClose"
/>

<!-- 撤销条（4 秒，非系统 Toast）。文案是**分段**的：只有结果词按 tone 着色 -->
<snackbar
  show="{{snackbar.show}}"
  lead="{{snackbar.lead}}"
  highlight="{{snackbar.highlight}}"
  tail="{{snackbar.tail}}"
  tone="{{snackbar.tone}}"
  duration="{{undoSeconds}}"
  bind:undo="onUndo"
  bind:expire="onUndoExpire"
/>

<!-- 底部导航 -->
<tabbar active="home" />
