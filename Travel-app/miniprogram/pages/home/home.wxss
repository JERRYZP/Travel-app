/* ===== 自定义导航栏 ===== */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 90;
  background: transparent;
  overflow: hidden;
}
.navbar::after {
  content: '';
  position: absolute;
  top: 0; right: -40rpx;
  width: 360rpx; height: 100%;
  background: radial-gradient(ellipse at 70% 30%, rgba(234,160,145,0.12), transparent 70%);
  pointer-events: none;
}
.navbar-content {
  display: flex;
  align-items: center;
  padding-left: 30rpx;
  position: relative;
}
.navbar-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
  white-space: nowrap;
}
/* 2026-09-20：导航栏双 Tab（提醒任务 / 添加提醒）已随首页行程化移除。
   首页只有行程状态墙一种形态；新增提醒走底部悬浮入口，不再让用户每次进首页
   先做一次「看哪个视图」的选择。 */

/* ===== 页面主体 =====
   视觉基准 402px：左右内边距 16px = 30rpx，底部为悬浮按钮与导航条留出空间。 */
.page-body {
  padding: 24rpx 30rpx calc(240rpx + env(safe-area-inset-bottom));
  position: relative;
  background: var(--color-page);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 吸顶横幅：跨全部当前/未来行程取全局最近的一条放票。
   固定在导航栏之下；滚动超过一屏后收起，避免长期占位。 */
.sticky-banner {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  z-index: 88;
}
.sticky-banner .rb { margin-bottom: 0; }

/* 分段吸顶时撑高的占位，防止内容跳动 */
.section-spacer { width: 100%; }

/* ===== 空态 =====
   没有任何行程项时给一个能直接动手的入口，
   而不是一张写着「暂无数据」的空卡片。 */
.empty-hero {
  padding: 140rpx 40rpx 48rpx;
  text-align: center;
}
.eh-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-ink);
}
.eh-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.7;
}
.empty-cta {
  margin: 32rpx auto 0;
  width: 400rpx;
  text-align: center;
  background: var(--color-primary);
  color: #FDF6EE;
  font-size: 30rpx;
  font-weight: 600;
  padding: 26rpx 0;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 22rpx rgba(150,51,31,.28);
}
.empty-cta:active { opacity: .88; }

/* ===== 历史行程：一行收纳，点开平铺 ===== */
.history {
  margin-top: 48rpx;
  border-top: 1rpx solid var(--color-border);
  padding-top: 24rpx;
}
.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 16rpx;
}
.hh-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-muted);
}

/* ===== 悬浮新增入口 ===== */
.fab-btn {
  position: fixed;
  right: 30rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 110;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--color-primary);
  color: #FDF6EE;
  font-size: 27rpx;
  font-weight: 600;
  padding: 22rpx 34rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 22rpx rgba(150,51,31,.32);
}
.fab-btn:active { opacity: .88; }

/* ===== 通用 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
