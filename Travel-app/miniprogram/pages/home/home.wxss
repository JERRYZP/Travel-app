/* ===== 自定义导航栏 ===== */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 90;
  overflow: hidden;
  /* ⚠️ 底色**由模板内联给出**（`rgba(248,243,234, navOpacity)`），这里不写 background：
     写一条静态值就会盖掉内联，导航栏就永远是同一个颜色、没有淡入。
     页面主题色 #F8F3EA 的三个通道值在模板里是写死的常量，
     改主题色要连同那里一起改（wxss 变量在内联 style 里用不了）。 */
}
/* 状态栏那一段没有设计值 —— 它就是设备状态栏高度，由模板内联给出
   （截图实测 iPhone 15 约 48.5px，比常见状态栏高，导航栏整块被它往下推）。 */
.navbar-status { flex-shrink: 0; }
/* ⚠️ 这里原有一条 `.navbar::after` 的暖色光晕（radial-gradient），2026-09-23 删除：
   导航栏现在是不透明的页面底色，光晕铺在它上面只会比页面底色更亮一点点，
   等于又画出一条肉眼可见的色带——而「填底」的全部意义就是让顶部别有色带。 */
/* 导航块高度 = 常规导航栏的 44px（给胶囊按钮留的高度，比标题高得多）。
   ⚠️ 它**不是间距的基准**：正文从「标题下沿」开始，所以
   home.js 的 `pageTopOf()` 要把上面约 21.5rpx 的内缩减掉。
   改这个高度 = 改标题位置 = 必须回去复核那一条。 */
.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  position: relative;
}
.navbar-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
  white-space: nowrap;
}
/* 2026-09-20：导航栏双 Tab（提醒任务 / 添加提醒）已随首页行程化移除。
   首页只有行程状态墙一种形态；新增提醒走底部悬浮入口，不再让用户每次进首页
   先做一次「看哪个视图」的选择。 */

/* ===== 页面主体 =====
   视觉基准 402px：左右内边距 16px = 30rpx，底部为悬浮按钮与导航条留出空间。 */
.page-body {
  /* ⚠️ padding-top 由模板内联给出（= 标题下沿）：导航栏是 fixed 的、
     不占文档流，正文不让位就会钻到标题底下。它**只让导航块的内缩，不让横幅的高度**——
     横幅就在这个容器里，高度它自己占。
     左右 30rpx 在这里定；横幅因为已经在这个容器内，不再自己留左右白。 */
  padding: 16rpx 30rpx calc(240rpx + env(safe-area-inset-bottom));
  position: relative;
  background: var(--color-page);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 授权额度预警：在原放票横幅之前，优先提醒“提醒可能收不到”。 */
.quota-warning-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 0;
  margin-bottom: 16rpx;
  padding: 16rpx 16rpx 16rpx 20rpx;
  background: #FFF3D8;
  border: 1rpx solid #E8C77C;
  border-radius: 14rpx;
}
.qw-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.45;
  color: #8A5A12;
}
.qw-go {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.qw-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: .55;
}

/* 放票横幅：**在文档流里**，跟着内容一起滚，不吸顶。
   ⚠️ 曾经是 `position: fixed`（「吸顶横幅」），三个坑一起犯：
     ① 它钉在导航栏下面，用户往下滑时它挡住的是行程卡（2026-09-22 报的）；
     ② 它和页面正文**从一开始就不在同一个坐标系**里，间距得靠
        「挪内容」或「挪自己」去凑 —— 无论怎么凑，只要导航栏高度一变就全错位；
     ③ 页面在顶部不能滚动（见 `.navbar`），于是它永远钉在那儿挡着。
   现在它就是正文的第一块，和标题下沿直接对齐：
     上面不再额外留 4px
     下面原本有 16rpx margin-bottom（2026-09-23 用户要求去掉，横幅与下方内容不再留间隔）
   左右不再自己留白：它已经在 `.page-body` 的水平内边距里了，
   再加 margin 会变成左右各 30px。 */
.sticky-banner { margin-top: 0; } /* 2026-09-25 用户要求增大 6px：上移补偿从 -16rpx 收到 -4rpx */
.sticky-banner--after-warning { margin-top: 0; }
.sticky-banner .rb { margin-bottom: 0; }

.dev-preview-notice {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin-bottom: 20rpx; padding: 18rpx 22rpx;
  background: #FFF3D8; border: 1rpx dashed #D7A84F; border-radius: 16rpx;
  color: #8A5A12; font-size: 22rpx; line-height: 1.5;
}
.dev-preview-exit { flex: none; color: #C0472A; font-weight: 600; }

/* 分段吸顶时撑高的占位，防止内容跳动 */
.section-spacer { width: 100%; }

/* ===== 空态 =====
   没有任何行程项时给一个能直接动手的入口，
   而不是一张写着「暂无数据」的空卡片。 */
.empty-hero {
  padding: 30rpx 20rpx 28rpx;
  text-align: center;
}
.eh-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--color-ink);
}
.eh-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.empty-proof-card {
  padding: 24rpx;
  background: var(--color-surface);
  border-radius: 26rpx;
  box-shadow: var(--shadow-card);
}
.ep-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ep-head-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--color-ink);
}
.ep-head-tag {
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  background: var(--diff-extreme-bg);
  color: var(--color-primary);
  font-size: 19rpx;
  line-height: 1.3;
}

.ep-journey {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}
.ep-stop {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ep-stop + .ep-stop { border-left: 1rpx solid var(--color-border); }
.ep-stop-label {
  font-size: 19rpx;
  line-height: 1.4;
  color: #AA927C;
}
.ep-stop-value {
  margin-top: 2rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-strong);
  text-align: center;
  word-break: break-all;
}

.ep-sample-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 19rpx 20rpx;
  border: 1rpx solid #ECD8CF;
  border-radius: 18rpx;
  background: #FCF6EF;
}
.ep-sample-copy { min-width: 0; }
.ep-sample-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-ink);
}
.ep-sample-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #AA927C;
}
.ep-note {
  display: block;
  margin-top: 12rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--color-placeholder);
  text-align: center;
}

.empty-cta {
  margin: 28rpx auto 0;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  background: var(--color-primary);
  color: #FDF6EE;
  font-size: 30rpx;
  font-weight: 600;
  padding: 25rpx 0;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 22rpx rgba(150,51,31,.28);
}
.empty-cta:active { opacity: .88; }
.empty-trust {
  display: block;
  margin-top: 14rpx;
  color: #AA927C;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.empty-hot { margin-top: 34rpx; }
.empty-hot-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 2rpx 16rpx;
}
.empty-hot-head-copy { min-width: 0; }
.empty-hot-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--color-ink);
}
.empty-hot-note {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 1.4;
  color: var(--color-placeholder);
}
.empty-hot-all {
  flex: none;
  display: flex;
  align-items: center;
  gap: 2rpx;
  padding: 8rpx 0 4rpx 16rpx;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}
.empty-hot-all-text { text-decoration: underline; }
.empty-hot-list {
  overflow: hidden;
  background: var(--color-surface);
  border-radius: 22rpx;
  box-shadow: var(--shadow-card);
}
.empty-hot-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
}
.empty-hot-row + .empty-hot-row { border-top: 1rpx solid var(--color-border); }
.empty-hot-row:active { background: #FAF5EC; }
.empty-hot-img {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #EDE0C8, #DBCDBB);
}
.empty-hot-main {
  flex: 1;
  min-width: 0;
}
.empty-hot-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-strong);
}
.empty-hot-status {
  display: block;
  margin-top: 3rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #936F5B;
}
.empty-hot-status.today { color: var(--color-primary); font-weight: 600; }
.empty-hot-status.future { color: var(--action-green); }
.empty-hot-diff {
  flex: none;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  line-height: 1.35;
}
.empty-hot-diff.diff-EXTREME { background: var(--diff-extreme-bg); color: var(--diff-extreme-text); }
.empty-hot-diff.diff-NORMAL { background: var(--diff-normal-bg); color: var(--diff-normal-text); }
.empty-hot-diff.diff-EASY { background: var(--diff-easy-bg); color: var(--diff-easy-text); }

/* ===== 历史行程：一行收纳，点开平铺 ===== */
.history {
  margin-top: 48rpx;
  border-top: 1rpx solid var(--color-border);
  padding-top: 24rpx;
}
.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 16rpx;
}
.hh-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-muted);
}

/* ===== 悬浮新增入口 =====
   ⚠️ 2026-09-23 改为**水平居中**（原先 right:30rpx 贴右下）：
   left:50% + translateX(-50%) 让按钮左右居中，bottom 不变。 */
.fab-btn {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 110;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--color-primary);
  color: #FDF6EE;
  font-size: 27rpx;
  font-weight: 600;
  padding: 22rpx 34rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 22rpx rgba(150,51,31,.32);
}
.fab-btn:active { opacity: .88; }

/* ===== 通用 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
