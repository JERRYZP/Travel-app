<view class="navbar" style="height: {{statusBarHeight + navBarHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-content" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="onBack">
      <svg-icon name="back-thick" size="18px" />
    </view>
    <text class="navbar-title">帮助与反馈</text>
  </view>
</view>
<view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="page-body">
  <view class="feedback-reward-banner">
    <view class="feedback-reward-head">
      <view class="feedback-reward-title-row">
        <svg-icon name="gift" size="17px" />
        <text class="feedback-reward-title">反馈建议有礼</text>
      </view>
    </view>
    <text class="feedback-reward-copy">欢迎反馈问题与建议。我们会逐条核实；对确有帮助且经我们确认采纳的反馈，将酌情赠送 30 天会员。奖励并非提交即得，是否赠送由我们根据反馈质量和采纳情况决定。</text>
  </view>

  <view class="setting-card">
    <button class="setting-row service-row" open-type="contact" hover-class="setting-row-hover">
      <text class="setting-row-label">在线客服</text>
      <view class="setting-row-right">
        <text class="setting-row-hint">有问题直接沟通</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </button>

    <view class="setting-row" bindtap="onFeedback">
      <text class="setting-row-label">意见反馈</text>
      <view class="setting-row-right">
        <text class="setting-row-hint">建议 / Bug</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>

    <view class="setting-row" bindtap="onReportError">
      <text class="setting-row-label">信息纠错</text>
      <view class="setting-row-right">
        <text class="setting-row-hint">景点信息有误</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
  </view>

  <view class="setting-card my-feedback-card">
    <view class="setting-row" bindtap="onMyFeedback">
      <view class="setting-row-title">
        <text class="setting-row-label">我的反馈</text>
        <text wx:if="{{feedbackUnreadCount > 0}}" class="setting-pending-badge">{{feedbackUnreadText}}</text>
      </view>
      <view class="setting-row-right">
        <text class="setting-row-hint">查看处理进度</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
  </view>
</view>
