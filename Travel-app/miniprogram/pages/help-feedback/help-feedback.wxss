.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back { position: absolute; left: 20rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 30rpx; font-weight: 600; color: var(--color-ink); }

.page-body { padding: 24rpx 30rpx 120rpx; }

.setting-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.setting-row:last-child { border-bottom: none; }
.setting-row-label { font-size: 28rpx; color: var(--color-ink); }
.setting-row-right { display: flex; align-items: center; gap: 8rpx; }
.setting-row-hint { font-size: 24rpx; color: var(--color-muted); }

.service-row {
  width: 100%;
  margin: 0;
  padding: 28rpx 0;
  box-sizing: border-box;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid var(--color-border);
  border-radius: 0;
  color: var(--color-ink);
  font-size: 28rpx;
  line-height: normal;
  text-align: left;
}

.service-row::after { border: none; }
.setting-row-hover { opacity: 0.65; }

.my-feedback-card { margin-top: 16rpx; margin-bottom: 0; }
