.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back { position: absolute; left: 20rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); color: var(--color-ink); font-size: 30rpx; font-weight: 600; }
.page-body { padding: 20rpx 28rpx 100rpx; }
.migration-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 18rpx; padding: 20rpx 22rpx; border: 1rpx solid #E2C896; border-radius: 17rpx; background: #FFF9EA; }
.migration-copy { display: flex; flex: 1; flex-direction: column; gap: 7rpx; }
.migration-title { color: var(--color-ink); font-size: 24rpx; font-weight: 600; }
.migration-desc, .migration-message { color: var(--color-muted); font-size: 20rpx; line-height: 1.45; }
.migration-message { color: #8A5A12; }
.migration-action { flex-shrink: 0; padding: 14rpx 18rpx; border-radius: 13rpx; background: #B8904A; color: #FFFDF7; font-size: 21rpx; }
.migration-action.disabled { opacity: .55; }
.filter-scroll { width: 100%; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 12rpx; padding: 4rpx 2rpx 18rpx; }
.filter-chip { padding: 12rpx 20rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: var(--color-surface); color: var(--color-muted); font-size: 21rpx; }
.filter-chip.active { border-color: #B8904A; background: #B8904A; color: #FFFDF7; }
.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }
.state-box { display: flex; flex-direction: column; align-items: center; gap: 15rpx; padding: 110rpx 30rpx; text-align: center; }
.state-title { color: var(--color-ink); font-size: 26rpx; font-weight: 600; }
.state-desc { color: var(--color-muted); font-size: 21rpx; line-height: 1.55; }
.retry-btn { padding: 15rpx 28rpx; border-radius: 14rpx; background: var(--color-cream); color: var(--color-text); font-size: 23rpx; }
.case-list { display: flex; flex-direction: column; gap: 14rpx; }
.case-card { display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--color-border); border-radius: 17rpx; background: var(--color-surface); box-shadow: var(--shadow-card); }
.case-head { display: flex; justify-content: space-between; gap: 18rpx; }
.case-no { color: var(--color-muted); font-size: 20rpx; }
.case-status { color: #8A5A12; font-size: 21rpx; font-weight: 600; }
.case-title { color: var(--color-ink); font-size: 25rpx; font-weight: 600; }
.case-meta { color: var(--color-muted); font-size: 20rpx; }
.case-amount { color: var(--color-primary); font-size: 26rpx; font-weight: 700; }
.detail-mask { position: fixed; inset: 0; z-index: 250; display: flex; align-items: flex-end; background: rgba(34,25,19,.5); }
.detail-sheet { width: 100%; max-height: 88vh; padding: 26rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #FFFDF8; box-sizing: border-box; }
.detail-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.detail-title { color: var(--color-ink); font-size: 27rpx; font-weight: 700; }
.detail-close { color: var(--color-muted); font-size: 42rpx; line-height: 1; }
.detail-scroll { max-height: 72vh; }
.detail-status { display: inline-block; padding: 5rpx 14rpx; border-radius: 999rpx; background: #FFF5DD; color: #8A5A12; font-size: 21rpx; }
.detail-section { display: flex; flex-direction: column; gap: 8rpx; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid var(--color-border); border-radius: 15rpx; color: var(--color-muted); font-size: 21rpx; line-height: 1.55; word-break: break-all; }
.detail-section-title { color: var(--color-ink); font-size: 24rpx; font-weight: 600; }
.decision-input { width: 100%; min-height: 130rpx; padding: 16rpx 18rpx; border: 1rpx solid var(--color-border); border-radius: 13rpx; box-sizing: border-box; background: var(--color-page); color: var(--color-text); font-size: 22rpx; }
.action-message { padding: 14rpx 16rpx; border-radius: 12rpx; background: var(--color-cream); color: var(--color-text); font-size: 21rpx; }
.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 8rpx; }
.admin-action { min-height: 70rpx; padding: 10rpx; border: 1rpx solid var(--color-border); border-radius: 13rpx; background: var(--color-surface); color: var(--color-text); font-size: 21rpx; display: flex; align-items: center; justify-content: center; text-align: center; }
.admin-action.primary { border-color: var(--color-primary); background: var(--color-primary); color: #FFFEFB; }
.admin-action.danger { border-color: #D8A08E; color: #A7462B; }
.history-row { display: flex; flex-direction: column; gap: 4rpx; padding: 10rpx 0; border-top: 1rpx solid var(--color-border); }
.action-empty { grid-column: 1 / 3; color: var(--color-muted); font-size: 21rpx; text-align: center; }
.audit-note { color: var(--color-muted); font-size: 19rpx; }
