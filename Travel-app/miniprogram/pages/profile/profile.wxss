.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; justify-content: center; position: relative; }
.navbar-title { font-size: 30rpx; font-weight: 600; color: var(--color-ink); }

.page-body { padding: 16rpx 38rpx 160rpx; }

/* 用户信息 */
.profile-header {
  display: flex; align-items: center; gap: 10rpx;
  padding: 0; margin-bottom: 46rpx;
}
.profile-avatar {
  width: 126rpx; height: 126rpx; border-radius: 63rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; overflow: hidden;
  background: linear-gradient(135deg, #EDE0C8, #DBCDBB);
}
.profile-avatar-img { width: 126rpx; height: 126rpx; border-radius: 63rpx; }
.profile-info { display: flex; flex-direction: column; gap: 9rpx; flex: 1; min-width: 0; }
.profile-name-row { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.profile-name { font-size: 30rpx; font-weight: 600; color: var(--color-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-tag {
  display: inline-block; width: fit-content;
  padding: 3rpx 16rpx;
  background: #FFF7E7;
  border: 1rpx solid #E7DAC5;
  border-radius: 7rpx;
  font-size: 22rpx;
  color: #8D7764;
}
.profile-tag.member {
  background: #B8904A;
  border-color: #B8904A;
  color: #FFFDF7;
  font-weight: 600;
}

/* 会员身份：独立于头像卡和设置列表，普通/会员用两种明度区分。 */
.membership-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 134rpx;
  padding: 0 26rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid #F0E0C8;
  border-radius: 22rpx;
}
.membership-entry.normal { background: #FFF7E7; }
.membership-entry.member {
  background: #FFF7E7;
  border-color: #F0E0C8;
}
.membership-entry-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }
.membership-entry-title-row { display: flex; align-items: center; gap: 12rpx; }
.membership-entry-title { color: #4A2D23; font-size: 29rpx; font-weight: 600; }
.membership-entry.member .membership-entry-title { color: #B8904A; }
.membership-entry-desc {
  color: #A38E78;
  font-size: 22rpx;
  line-height: 1.45;
}
.membership-entry.member .membership-entry-desc { color: #A38E78; }
.membership-entry-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 54rpx;
  border-radius: 11rpx;
  background: #B8904A;
  color: #FFFDF7;
  font-size: 24rpx;
  font-weight: 600;
}
.membership-entry.member .membership-entry-action { background: #B8904A; }
.membership-entry-chevron { flex-shrink: 0; opacity: 0.34; }

/* 设置卡片 */
.setting-card {
  background: var(--color-surface); border-radius: 24rpx;
  box-shadow: var(--shadow-card); padding: 0 24rpx;
  margin-bottom: 24rpx;
}
.setting-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 0; border-bottom: 1rpx solid var(--color-border);
}
.setting-row:last-child { border-bottom: none; }
.setting-row-label { font-size: 28rpx; color: var(--color-ink); }
.setting-row-right { display: flex; align-items: center; gap: 8rpx; }
.setting-row-hint { font-size: 24rpx; color: var(--color-muted); }
.setting-row-hint-none { color: var(--color-primary); font-weight: 600; }
.setting-row-hint-partial { color: var(--color-muted); }
.setting-row-hint-low { color: #B8860B; font-weight: 600; }
.setting-row-hint-short { color: #C0472A; font-weight: 600; }
.setting-row-hint-exhausted { color: var(--color-primary); font-weight: 600; }
.setting-row-hint-all { color: #4A7C59; }
