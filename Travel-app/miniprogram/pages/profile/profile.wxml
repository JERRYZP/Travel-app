<view class="navbar" style="height: {{statusBarHeight + navBarHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-content" style="height: {{navBarHeight}}px;">
    <text class="navbar-title">我的</text>
  </view>
</view>
<view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="page-body">
  <!-- 用户信息：无感登录常驻登录态；点头像/昵称进编辑资料页；管理员入口右对齐 -->
  <view class="profile-header">
    <view class="profile-avatar" bindtap="onEditProfile">
      <image wx:if="{{user.avatarUrl}}" class="profile-avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" />
      <svg-icon wx:else name="profile" size="36px" />
    </view>
    <view class="profile-info">
      <view class="profile-name-row">
        <text class="profile-name" bindtap="onEditProfile">{{user.nickname || '用户'}}</text>
      </view>
      <view class="profile-tag {{isMember ? 'member' : ''}}">{{memberTagText}}</view>
    </view>
    <button wx:if="{{showFeedbackAdminEntry}}" class="profile-feedback-entry"
      hover-class="profile-feedback-entry-hover" bindtap="onFeedbackAdmin">
      <text class="profile-feedback-entry-label">反馈管理</text>
      <text wx:if="{{feedbackAdminPendingCount > 0}}" class="profile-feedback-entry-badge">{{feedbackAdminPendingText}}</text>
    </button>
  </view>

  <view wx:if="{{membershipUpgradeNotice}}" class="membership-entry upgrade-notice" bindtap="onMembership">
    <svg-icon name="sparkle" size="17px" />
    <view class="membership-entry-copy">
      <text class="upgrade-notice-title">{{membershipUpgradeNotice.title}}</text>
      <text class="membership-entry-desc">{{membershipUpgradeNotice.body}}</text>
    </view>
    <text class="upgrade-action">查看</text>
    <view class="upgrade-close" catchtap="onDismissMembershipUpgradeNotice"><svg-icon name="close" size="11px" /></view>
  </view>

  <!-- 会员身份独立成块：普通用户与有效会员使用不同的底色、标签和行动文案。 -->
  <view class="membership-entry {{isMember ? 'member' : 'normal'}}" bindtap="onMembership">
    <view class="membership-entry-copy">
      <view class="membership-entry-title-row">
        <text class="membership-entry-title">{{memberCardTitle}}</text>
      </view>
      <text class="membership-entry-desc">{{memberCardDesc}}</text>
    </view>
    <view class="membership-entry-action">
      <text>{{memberCardAction}}</text>
    </view>
    <svg-icon class="membership-entry-chevron" name="chevron-down" size="13px" rotate="270" />
  </view>

  <view wx:if="{{showAfterSalesEntry}}" class="setting-card">
    <view class="setting-row" bindtap="onAfterSalesAdmin">
      <view class="setting-row-title">
        <text class="setting-row-label">客服工作台</text>
        <text wx:if="{{afterSalesPendingCount > 0}}" class="setting-pending-badge">{{afterSalesPendingText}}</text>
      </view>
      <view class="setting-row-right">
        <text class="setting-row-hint {{afterSalesFundingBlocked ? 'funding-blocked' : ''}}">{{afterSalesAdminHint}}</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
  </view>

  <!-- 设置列表 1 -->
  <view class="setting-card">
    <view class="setting-row" bindtap="onNotifySettings">
      <text class="setting-row-label">提醒设置</text>
      <view class="setting-row-right">
        <text class="setting-row-hint setting-row-hint-{{notifyState}}">{{notifyHint}}</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
    <view class="setting-row" bindtap="onGuide">
      <text class="setting-row-label">使用攻略</text>
      <view class="setting-row-right">
        <text class="setting-row-hint">3分钟上手</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
  </view>

  <!-- 帮助与反馈：在线客服、反馈、纠错与反馈记录统一收口 -->
  <view class="setting-card">
    <view class="setting-row" bindtap="onHelpFeedback">
      <view class="setting-row-title">
        <text class="setting-row-label">帮助与反馈</text>
        <text wx:if="{{feedbackUnreadCount > 0}}" class="setting-pending-badge">{{feedbackUnreadText}}</text>
      </view>
      <view class="setting-row-right">
        <text class="setting-row-hint">在线客服 / 反馈与纠错</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
  </view>

  <!-- 隐私与协议：与微信后台《用户隐私保护指引》同步核验入口 -->
  <view class="setting-card">
    <view class="setting-row" bindtap="onLegal" data-type="privacy">
      <text class="setting-row-label">隐私政策</text>
      <svg-icon name="chevron-down" size="14px" rotate="270" />
    </view>
    <view class="setting-row" bindtap="onLegal" data-type="terms">
      <text class="setting-row-label">用户服务协议</text>
      <svg-icon name="chevron-down" size="14px" rotate="270" />
    </view>
  </view>

  <!-- 公众号：单独一张卡放最下面，与其他设置项隔开；只留入口，点开才是二维码 -->
  <view class="setting-card">
    <view class="setting-row" bindtap="onFollowOa">
      <text class="setting-row-label">{{oaRowLabel}}</text>
      <view class="setting-row-right">
        <text class="setting-row-hint">{{oaRowHint}}</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
  </view>

</view>

<oa-follow-sheet show="{{showOaSheet}}" bind:close="onCloseOaSheet" />

<tabbar active="profile" />
