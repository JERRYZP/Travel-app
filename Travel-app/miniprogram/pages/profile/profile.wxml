<view class="navbar" style="height: {{statusBarHeight + navBarHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-content" style="height: {{navBarHeight}}px;">
    <text class="navbar-title">我的</text>
  </view>
</view>
<view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="page-body">
  <!-- 用户信息（长按进入反馈管理，后端 openid 白名单鉴权） -->
  <view class="profile-header" bindlongpress="onAdminEntry">
    <view class="profile-avatar" style="background: linear-gradient(135deg, #EDE0C8, #DBCDBB);">
      <svg-icon name="profile" size="36px" />
    </view>
    <view class="profile-info">
      <text class="profile-name">{{user.nickname || '游客'}}</text>
      <view class="profile-tag">普通用户</view>
    </view>
  </view>

  <!-- 设置列表 1 -->
  <view class="setting-card">
    <view class="setting-row" bindtap="onNotifySettings">
      <text class="setting-row-label">通知设置</text>
      <view class="setting-row-right">
        <text class="setting-row-hint setting-row-hint-{{notifyState}}">{{notifyHint}}</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
    <view class="setting-row" bindtap="onGuide">
      <text class="setting-row-label">使用攻略</text>
      <view class="setting-row-right">
        <text class="setting-row-hint">建议观看</text>
        <svg-icon name="chevron-down" size="14px" rotate="270" />
      </view>
    </view>
  </view>

  <!-- 设置列表 2 -->
  <view class="setting-card">
    <view class="setting-row" bindtap="onFeedback">
      <text class="setting-row-label">意见反馈</text>
      <svg-icon name="chevron-down" size="14px" rotate="270" />
    </view>
    <view class="setting-row" bindtap="onReportError">
      <text class="setting-row-label">信息纠错</text>
      <svg-icon name="chevron-down" size="14px" rotate="270" />
    </view>
  </view>
</view>

<tabbar active="profile" badge="{{badge}}" />
