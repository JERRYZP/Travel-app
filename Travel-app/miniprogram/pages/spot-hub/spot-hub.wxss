/* 景点规则聚合页（V3.1）：1:1 对齐 UI-V1.0/景点UI.png（402px 基准），全部沿用全局 token */

.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; justify-content: center; position: relative; }
.navbar-title { font-size: 30rpx; font-weight: 600; color: var(--color-ink); }
.navbar-city {
  position: absolute; left: 30rpx; top: 50%; transform: translateY(-50%);
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 22rpx;
  background: var(--color-surface); border-radius: 999rpx;
  box-shadow: var(--shadow-input);
}
.navbar-city-text { font-size: 24rpx; font-weight: 500; color: var(--color-ink); }

.page-body { padding: 24rpx 30rpx 140rpx; }

/* ===== 今日放票 Banner（1:1 对齐 景点UI.png：紧凑单行列表 + 大标题 + 轨道式指示器） ===== */
.release-banner {
  position: relative; overflow: hidden;
  border-radius: 24rpx;
  margin-bottom: 22rpx;
  box-shadow: var(--shadow-card);
}
.release-banner-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.release-banner-inner { position: relative; padding: 24rpx 20rpx 16rpx; }
.release-banner-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 8rpx 18rpx;
}
.release-banner-head-left {
  display: flex; align-items: baseline; gap: 10rpx;
}
.release-banner-date { font-size: 28rpx; font-weight: 400; color: var(--color-primary); }
.release-banner-sep { font-size: 28rpx; font-weight: 400; color: var(--color-primary); opacity: 0.4; }
.release-banner-title { font-size: 32rpx; font-weight: 700; color: var(--color-primary); line-height: 1.2; }
.release-banner-more {
  font-size: 24rpx; color: #936F5B;
  text-decoration: underline;
}

.release-swiper { height: 224rpx; }
.release-panel {
  height: 100%; box-sizing: border-box;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 4rpx 24rpx;
}
.release-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 17rpx 0;
  white-space: nowrap;
}
.release-row + .release-row { border-top: 0.6px solid var(--color-border); }
.release-row-name {
  flex: 0 0 185rpx;
  font-size: 26rpx; font-weight: 400; color: #936F5B;
  text-decoration: underline;
  overflow: hidden; text-overflow: ellipsis;
}
.release-row-time {
  flex: 1; min-width: 0;
  display: flex; align-items: center; gap: 8rpx;
  overflow: hidden;
  margin-left: 14rpx;
}
.release-row-hh { font-size: 26rpx; font-weight: 400; color: var(--color-primary); flex-shrink: 0; }
.release-row-date { font-size: 22rpx; font-weight: 400; color: #936F5B; flex-shrink: 0; }
.release-row-released { font-size: 22rpx; font-weight: 400; color: var(--diff-easy-text); flex-shrink: 0; }
.release-row-diff {
  flex-shrink: 0; white-space: nowrap;
  padding: 3rpx 14rpx; border-radius: 8rpx;
  font-size: 20rpx; line-height: 1.4;
}
.diff-extreme { background: #F5DDD5; color: #C0472A; }
.diff-normal { background: #F2E4C0; color: #C26B0C; }
.diff-easy { background: #D8EAD8; color: #4A7C59; }

/* 指示器：浅色轨道 pill + 金色当前段（对齐设计稿） */
.release-dots {
  display: flex; align-items: center; gap: 6rpx;
  width: fit-content; margin: 14rpx auto 0;
  padding: 5rpx 12rpx;
  background: rgba(255, 254, 251, 0.55);
  border-radius: 999rpx;
}
.release-dot { width: 39rpx; height: 6rpx; border-radius: 999rpx; background: transparent; }
.release-dot.active { background: #D5BD77; }

/* ===== 类型 Tab 筛选行 ===== */
.pin-wrap {
  position: sticky; z-index: 80;
  margin: 0 -30rpx; padding: 0 30rpx 2rpx;
  background: var(--color-page);
}

.type-tabs { width: 100%; white-space: nowrap; }
.type-tabs-inner { display: inline-flex; gap: 16rpx; padding: 2rpx; }
.type-tab {
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 13rpx 28rpx;
  background: var(--color-surface); border-radius: 20rpx;
  box-shadow: var(--shadow-input);
  font-size: 26rpx; color: var(--color-text);
}
.type-tab.active { background: var(--diff-extreme-bg); color: var(--color-primary); font-weight: 600; }

/* ===== 两列宫格（与 home hot-grid 同构：卡片定宽 337rpx + 自带下间距） ===== */
.spot-grid {
  display: flex; flex-wrap: wrap; justify-content: space-between;
  margin-top: 20rpx;
}
spot-card { display: block; margin-bottom: 16rpx; }

.loading-wrap { display: flex; justify-content: center; padding: 80rpx 0; }
.empty-state { display: flex; justify-content: center; padding: 120rpx 0; font-size: 26rpx; color: var(--color-placeholder); }
