/* 景点规则聚合页（V3.1）：1:1 对齐 UI-V1.0/景点UI.png（402px 基准），全部沿用全局 token */

.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; justify-content: center; position: relative; }
.navbar-title { font-size: 30rpx; font-weight: 600; color: var(--color-ink); }
.navbar-city {
  position: absolute; left: 30rpx; top: 50%; transform: translateY(-50%);
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 22rpx;
  background: var(--color-surface); border-radius: 999rpx;
  box-shadow: var(--shadow-input);
}
.navbar-city-text { font-size: 24rpx; font-weight: 500; color: var(--color-ink); }

.page-body { padding: 24rpx 30rpx 140rpx; }

/* ===== 今日放票 Banner（1:1 对齐 景点UI.png：紧凑单行列表 + 大标题 + 轨道式指示器） ===== */
.release-banner {
  position: relative; overflow: hidden;
  border-radius: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}
.release-banner-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.release-banner-inner { position: relative; padding: 26rpx 20rpx 18rpx; }
.release-banner-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  padding: 0 12rpx 18rpx;
}
.release-banner-date { display: block; font-size: 28rpx; font-weight: 600; color: var(--color-primary); }
.release-banner-title { display: block; font-size: 40rpx; font-weight: 700; color: var(--color-primary); margin-top: 2rpx; line-height: 1.3; }
.release-banner-more {
  font-size: 22rpx; color: var(--color-text);
  text-decoration: underline;
  padding-bottom: 10rpx;
}

.release-swiper { height: 224rpx; }
.release-panel {
  min-height: 100%; box-sizing: border-box;
  background: var(--color-surface);
  border-radius: 18rpx;
  padding: 4rpx 20rpx;
}
.release-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 17rpx 0;
  white-space: nowrap;
}
.release-row + .release-row { border-top: 1rpx solid var(--color-border); }
.release-row-name {
  flex: 0 0 140rpx;
  font-size: 26rpx; font-weight: 600; color: var(--color-ink);
  text-decoration: underline;
  overflow: hidden; text-overflow: ellipsis;
}
.release-row-time {
  flex: 1; min-width: 0;
  display: flex; align-items: center; gap: 8rpx;
  overflow: hidden;
}
.release-row-hh { font-size: 26rpx; font-weight: 700; color: var(--color-primary); flex-shrink: 0; }
.release-row-date { font-size: 22rpx; font-weight: 500; color: var(--color-primary); flex-shrink: 0; }
.release-row-released { font-size: 22rpx; font-weight: 600; color: var(--diff-easy-text); flex-shrink: 0; }
.release-row-flames { display: flex; align-items: center; gap: 4rpx; flex-shrink: 0; }
.release-flame { width: 22rpx; height: 22rpx; }

/* 指示器：浅色轨道 pill + 金色当前段（对齐设计稿） */
.release-dots {
  display: flex; align-items: center; gap: 6rpx;
  width: fit-content; margin: 14rpx auto 0;
  padding: 5rpx 12rpx;
  background: rgba(255, 254, 251, 0.55);
  border-radius: 999rpx;
}
.release-dot { width: 26rpx; height: 6rpx; border-radius: 999rpx; background: rgba(255, 254, 251, 0.9); }
.release-dot.active { background: var(--color-muted); }

/* ===== 搜索 + 类型 Tab 吸顶容器 ===== */
.pin-wrap {
  position: sticky; z-index: 80;
  margin: 0 -30rpx; padding: 8rpx 30rpx 16rpx;
  background: var(--color-page);
}

.search-bar { display: flex; align-items: center; gap: 20rpx; }
.search-input-wrap {
  flex: 1; display: flex; align-items: center; gap: 12rpx;
  padding: 0 24rpx; height: 76rpx;
  background: var(--color-surface); border: 1rpx solid var(--color-border);
  border-radius: 38rpx; box-shadow: var(--shadow-input);
}
.search-input { flex: 1; font-size: 26rpx; color: var(--color-ink); }
.search-placeholder { color: var(--color-placeholder); }
.search-clear { display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 8rpx; opacity: 0.5; }
.search-cancel { flex-shrink: 0; font-size: 28rpx; color: var(--color-text); }

.type-tabs { width: 100%; white-space: nowrap; margin-top: 20rpx; }
.type-tabs-inner { display: inline-flex; gap: 16rpx; padding: 2rpx; }
.type-tab {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 14rpx 32rpx;
  background: var(--color-surface); border-radius: 16rpx;
  box-shadow: var(--shadow-input);
  font-size: 26rpx; color: var(--color-text);
}
.type-tab.active { background: var(--diff-extreme-bg); color: var(--color-primary); font-weight: 600; }

/* ===== 两列宫格（与 home hot-grid 同构：卡片定宽 337rpx + 自带下间距） ===== */
.spot-grid {
  display: flex; flex-wrap: wrap; justify-content: space-between;
  margin-top: 24rpx;
}
spot-card { display: block; margin-bottom: 16rpx; }

.loading-wrap { display: flex; justify-content: center; padding: 80rpx 0; }
.empty-state { display: flex; justify-content: center; padding: 120rpx 0; font-size: 26rpx; color: var(--color-placeholder); }
