.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 90;
  background: var(--color-page);
}
.navbar-content {
  display: flex; align-items: center; padding-left: 20rpx; position: relative;
}
.navbar-back {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
}
.navbar-title {
  position: absolute; left: 50%; transform: translateX(-50%);
  font-size: 30rpx; font-weight: 600; color: var(--color-ink);
}

.page-body { padding: 24rpx 30rpx 190rpx; }

/* 搜索框 */
.search-bar { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.search-input-wrap {
  flex: 1; display: flex; align-items: center; gap: 12rpx;
  padding: 0 24rpx; height: 76rpx;
  background: var(--color-surface); border: 1rpx solid var(--color-border);
  border-radius: 38rpx; box-shadow: var(--shadow-input);
}
.search-input { flex: 1; font-size: 26rpx; color: var(--color-ink); }
.search-placeholder { color: var(--color-placeholder); }
.search-clear { display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 8rpx; opacity: 0.5; }
.search-cancel { font-size: 26rpx; color: var(--color-muted); flex-shrink: 0; padding: 0 8rpx; }

.card {
  background: var(--color-surface); border-radius: 24rpx;
  box-shadow: var(--shadow-card); padding: 24rpx; margin-bottom: 24rpx;
}

/* 已选景点 */
.selected-section { margin-bottom: 24rpx; }
.selected-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;
}
.selected-title { font-size: 26rpx; font-weight: 600; color: var(--color-ink); }
.selected-clear { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: var(--color-muted); }
.selected-scroll { white-space: nowrap; }
.selected-card {
  display: inline-flex; flex-direction: column; align-items: center;
  width: 140rpx; margin-right: 16rpx; position: relative;
  border: 1rpx solid var(--color-border); border-radius: 16rpx; padding: 12rpx;
}
.selected-card-img {
  width: 116rpx; height: 90rpx; border-radius: 12rpx;
  display: block; background: linear-gradient(135deg, #EDE0C8, #DBCDBB); margin-bottom: 8rpx;
}
.selected-card-img-text { font-size: 18rpx; color: var(--color-muted); max-width: 100rpx; text-align: center; overflow: hidden; }
.selected-card-name { font-size: 22rpx; color: var(--color-ink); max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.selected-card-x {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 28rpx; height: 28rpx; border-radius: 14rpx;
  background: var(--color-primary); display: flex; align-items: center; justify-content: center;
}

/* 历史搜索 */
.history-section { margin-bottom: 24rpx; }
.history-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; padding: 0 8rpx; }
.history-title { font-size: 26rpx; font-weight: 600; color: var(--color-ink); }
.history-clear { display: flex; align-items: center; padding: 4rpx 8rpx; }
.history-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.history-tag {
  padding: 8rpx 24rpx; background: var(--color-cream);
  border-radius: 24rpx; font-size: 24rpx; color: var(--color-text);
}

/* 热门景点 */
.hot-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx;
}
.hot-header-left { display: flex; align-items: center; gap: 8rpx; }
.hot-header-title { font-size: 28rpx; font-weight: 600; color: var(--color-ink); }
.hot-shuffle { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: var(--color-muted); }

/* 景点卡 - 左右结构（图左文右），单列满宽 */
.spot-grid { display: flex; flex-direction: column; gap: 16rpx; }
.spot-card {
  display: flex; align-items: center;
  width: 100%;
  background: var(--color-surface); border-radius: 24rpx;
  box-shadow: var(--shadow-card); padding: 16rpx;
  box-sizing: border-box;
}
.spot-card-img {
  width: 100rpx; height: 75rpx; border-radius: 12rpx;
  display: block; background: linear-gradient(135deg, #EDE0C8, #DBCDBB);
  flex-shrink: 0; margin-right: 20rpx;
}
.spot-card-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.spot-card-title { display: flex; align-items: center; gap: 8rpx; }
.spot-card-name {
  flex: 0 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  font-size: 26rpx; font-weight: 500; color: var(--color-text); text-decoration: underline;
}
.spot-card-diff { display: inline-block; flex-shrink: 0; padding: 2rpx 12rpx; border-radius: 8rpx; font-size: 20rpx; width: fit-content; }
.diff-EXTREME { background: var(--diff-extreme-bg); color: var(--diff-extreme-text); }
.diff-NORMAL { background: var(--diff-normal-bg); color: var(--diff-normal-text); }
.diff-EASY { background: var(--diff-easy-bg); color: var(--diff-easy-text); }
.spot-card-tags { display: flex; gap: 8rpx; flex-wrap: wrap; }
.spot-card-tag { font-size: 20rpx; color: var(--color-muted); }
.card-desc { line-height: 1.5; }
.spot-card-select {
  flex-shrink: 0; margin-left: 16rpx;
  display: flex; align-items: center; gap: 4rpx;
  padding: 8rpx 18rpx; border-radius: 24rpx;
  border: 1rpx solid var(--color-primary); font-size: 20rpx; color: var(--color-primary);
  background: var(--color-surface);
}
.spot-card-select.selected { background: var(--color-primary-soft); border-color: var(--color-primary-soft); color: #fff; }

/* B 层免预约：选择按钮位置改为信息 tag */
.spot-card-nobook {
  flex-shrink: 0; margin-left: 16rpx;
  display: flex; align-items: center;
  padding: 8rpx 18rpx; border-radius: 24rpx;
  border: 1rpx solid var(--color-border);
  font-size: 20rpx; color: var(--color-muted);
  background: var(--color-surface);
}

.loading-wrap { display: flex; justify-content: center; padding: 80rpx 0; }
.empty-state { display: flex; justify-content: center; padding: 120rpx 0; font-size: 26rpx; color: var(--color-placeholder); }

.done-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  justify-content: center;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 254, 251, 0.96);
  box-shadow: 0 -2rpx 12rpx rgba(100, 60, 20, 0.06);
}
.done-btn {
  min-width: 300rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #FFFEFB;
  font-size: 27rpx;
  font-weight: 600;
}
.done-btn:active { opacity: .88; }

.dialog-body {
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4A2D23;
}
