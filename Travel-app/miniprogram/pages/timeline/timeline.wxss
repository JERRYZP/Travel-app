.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: transparent; overflow: hidden; }
.navbar::after {
  content: '';
  position: absolute;
  top: 0; right: -40rpx;
  width: 360rpx; height: 100%;
  background: radial-gradient(ellipse at 70% 30%, rgba(234,160,145,0.12), transparent 70%);
  pointer-events: none;
}
.navbar-content { display: flex; align-items: center; padding-left: 30rpx; position: relative; }
.navbar-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 30rpx; font-weight: 600; color: var(--color-ink); white-space: nowrap; }

.page-scroll { width: 100%; }
.page-body { padding: 24rpx 30rpx calc(140rpx + env(safe-area-inset-bottom)); position: relative; }
.city-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 485rpx;
  z-index: 0;
  pointer-events: none;
}
/* 表单与时间线内容浮于背景图之上 */
.form-section, .primary-btn, .timeline-section {
  position: relative;
  z-index: 1;
}

.timeline-section {
  margin: 0 -30rpx;
  padding: 0 0 8rpx;
  background: var(--color-surface);
}

/* 白底面板头部 */
.timeline-panel {
  padding: 24rpx 0 8rpx;
  margin-bottom: 16rpx;
}
.timeline-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 16rpx;
}
.timeline-title-wrap { display: flex; align-items: center; gap: 8rpx; }
.timeline-title { font-size: 28rpx; font-weight: 600; color: var(--color-primary); }

.view-switcher {
  display: flex;
  gap: 0;
  background: #F3EEE3;
  border-radius: 12rpx;
  padding: 4rpx;
}
.view-switcher-item {
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: #A99180;
  border-radius: 8rpx;
  line-height: 1.4;
}
.view-switcher-item.active {
  background: var(--color-surface);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(100,60,20,0.08);
}

/* 出游日 Tab */
.tab-row {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.tab-row-inner {
  display: inline-flex;
  align-items: center;
  padding: 0 30rpx;
}
.tab-prefix {
  font-size: 22rpx;
  color: #B59E80;
  margin-right: 12rpx;
}
.tab-item {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #9B7F6F;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}
.tab-item.active {
  background: #F7E7E1;
  border-color: #F7E7E1;
  color: var(--color-primary);
  font-weight: 500;
}

/* 说明 + 一键全部提醒 */
.timeline-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 30rpx;
}
.timeline-caption {
  flex: 1;
  font-size: 22rpx;
  color: #B59E80;
}
.timeline-batch-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  background: #F5DDD5;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

/* ===== 时间线事件 ===== */
.timeline-list { padding: 4rpx 30rpx 0; }
.timeline-event {
  display: flex;
  align-items: stretch;
  margin-bottom: 8rpx;
}

/* 左侧时间列（白底） */
.event-rail {
  width: 112rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  padding-top: 20rpx;
}
.event-rail-date {
  font-size: 24rpx;
  color: #6B5248;
}
.event-rail-time {
  font-size: 24rpx;
  color: var(--color-primary);
}
.event-rail-line {
  flex: 1;
  width: 2rpx;
  margin: 12rpx 0 0 18rpx;
  background: #DDD0B5;
}

/* 事件卡：左侧信息 + 竖虚线 + 右侧按钮 */
.event-card {
  flex: 1;
  min-width: 0;
  display: flex;
  background: #F8F3EA;
  border: 1rpx solid rgba(237,224,200,0.55);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(100,60,20,0.04);
}
.event-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-right: 20rpx;
}
.event-status {
  font-size: 20rpx;
  color: #8A6955;
}
.event-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.event-name {
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-ink);
  text-decoration: underline;
}
.event-diff {
  display: inline-block;
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  width: fit-content;
}
.diff-EXTREME { background: var(--diff-extreme-bg); color: var(--diff-extreme-text); }
.diff-NORMAL { background: var(--diff-normal-bg); color: var(--diff-normal-text); }
.diff-EASY { background: var(--diff-easy-bg); color: var(--diff-easy-text); }
.event-visit {
  font-size: 24rpx;
  color: var(--color-primary);
}
.event-visit-ticket {
  color: #997D6B;
}

/* 竖虚线分隔 */
.event-divider {
  width: 2rpx;
  background-image: linear-gradient(to bottom, #DDD0B5 50%, transparent 50%);
  background-size: 2rpx 8rpx;
  background-repeat: repeat-y;
  margin: 4rpx 0;
  flex-shrink: 0;
}

/* 右侧按钮区 */
.event-action {
  width: 190rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding-left: 16rpx;
}
.event-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 10rpx 0;
  width: 100%;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}
.event-btn-SELECTABLE { background: #F5DDD5; color: var(--color-primary); }
.event-btn-IN_CART { background: #FAF7F2; border: 1rpx solid #D7BF96; color: #A68045; }
.event-btn-WAITING, .event-btn-REMINDERED { background: var(--color-surface); border: 1rpx solid #E8E0D0; color: #A99180; }
.event-btn-BOOKABLE { background: #B8904A; color: #fff; }
.event-btn-FULL { background: #EDE5D2; color: #B8904A; }
.event-btn-sub {
  font-size: 20rpx;
  color: #B59E80;
  text-align: center;
}

.closed-spots { margin-top: 24rpx; }
.closed-spot { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 0; font-size: 24rpx; color: var(--color-muted); }

.loading-wrap { display: flex; justify-content: center; padding: 80rpx 0; }
.empty-state { display: flex; justify-content: center; align-items: center; padding: 120rpx 0; font-size: 26rpx; color: var(--color-placeholder); text-align: center; }

.cart-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-surface); box-shadow: 0 -2rpx 12rpx rgba(100,60,20,0.06);
  z-index: 80;
}
.cart-bar-icon {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #B8904A;
  border-radius: 50%;
}
.cart-bar-badge { position: absolute; top: -4rpx; right: -8rpx; min-width: 28rpx; height: 28rpx; line-height: 28rpx; padding: 0 6rpx; border-radius: 14rpx; background: var(--color-primary); color: #fff; font-size: 18rpx; text-align: center; }
.cart-bar-text { flex: 1; font-size: 24rpx; color: var(--color-text); }
.cart-bar-btn { display: flex; align-items: center; gap: 8rpx; padding: 16rpx 36rpx; background: var(--color-primary); border-radius: 32rpx; color: #fff; font-size: 26rpx; font-weight: 500; }

/* ===== 表单（与首页形态1一致） ===== */
.form-section { margin-bottom: 30rpx; }
.form-section-first { margin-top: 60rpx; }
.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 16rpx;
}
.form-input-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  box-shadow: var(--shadow-input);
}
.form-placeholder {
  font-size: 26rpx;
  color: var(--color-placeholder);
  flex: 1;
}
.form-value {
  font-size: 26rpx;
  color: var(--color-ink);
  flex: 1;
}
.form-tags-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.form-tags {
  display: inline-flex;
  gap: 8rpx;
}
.form-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  background: var(--color-cream);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--color-text);
}
.form-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-placeholder);
}
.form-date-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.form-day-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-placeholder);
}

/* ===== 主按钮 ===== */
.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  background: var(--color-primary);
  border-radius: 24rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(192,71,42,0.2);
}
