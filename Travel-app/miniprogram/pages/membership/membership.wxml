<view class="navbar" style="height: {{statusBarHeight + navBarHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-content" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="onBack">
      <svg-icon name="back-thick" size="18px" />
    </view>
    <text class="navbar-title">会员与提醒名额</text>
  </view>
</view>
<view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="page-body">
  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading size="36rpx" color="#B8904A" />
  </view>

  <view wx:elif="{{loadFailed}}" class="load-failed">
    <text class="load-failed-title">会员状态加载失败</text>
    <view class="retry-btn" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <view wx:if="{{previewMode}}" class="preview-banner">{{previewLabel}}</view>

    <view class="status-band first">
      <view class="status-head">
        <view>
          <text class="status-title">{{memberStateText}}</text>
          <text class="status-expiry">{{expiryText}}</text>
        </view>
        <text class="status-badge {{membership.member ? 'active' : ''}}">{{membership.member ? '会员' : '免费版'}}</text>
      </view>
      <view wx:if="{{membership.unlimited}}" class="usage-row">
        <text>已开启 {{membership.taskUsed}} 个提醒</text>
        <text class="usage-unlimited">不限名额</text>
      </view>
      <view wx:else class="usage-row">
        <text>提醒名额 {{membership.taskUsed}} / {{membership.taskLimit}}</text>
        <text>剩余 {{membership.taskRemaining}}</text>
      </view>
      <view wx:if="{{!membership.unlimited}}" class="usage-track">
        <view class="usage-fill" style="width: {{usagePercent}}%;"></view>
      </view>
      <text wx:if="{{membership.protectedTaskUsed > 0 && !membership.unlimited}}" class="protected-note">上线前已有 {{membership.protectedTaskUsed}} 个提醒已保留，不占当前新增的 {{membership.entitlementTaskLimit}} 个名额。</text>
    </view>

    <view wx:if="{{autoRefreshHint}}" class="auto-refresh-hint">
      <view class="auto-refresh-dot"></view>
      <text>{{autoRefreshHint}}</text>
    </view>

    <view wx:if="{{paymentState}}" class="payment-state {{paymentState.status}}">
      <text class="payment-state-title">{{paymentState.title}}</text>
      <text class="payment-state-desc">{{paymentState.description}}</text>
      <view wx:if="{{paymentState.orderId}}" class="payment-state-action" bindtap="onPaymentOrder">查看订单详情</view>
    </view>

    <view class="order-entry" bindtap="onOrders">
      <view class="order-entry-copy">
        <text class="order-entry-title">会员订单</text>
        <text class="order-entry-desc">查看支付结果和售后信息</text>
      </view>
      <svg-icon name="chevron-down" size="14px" rotate="270" />
    </view>

    <block wx:if="{{membership.unlimited && !membership.pricingVisible}}">
      <text class="section-label">你能得到什么</text>
      <view class="benefit-list">
        <view class="benefit-row">
          <svg-icon name="check-gold" size="16px" />
          <view class="benefit-copy">
            <text class="benefit-title">会员有效期内不限提醒名额</text>
            <text class="benefit-desc">免费版限{{membership.freeTaskSlots}}个提醒名额；开通会员后，有效期内不限提醒名额。只影响可同时开启的提醒数量</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{membership.pricingVisible && sales && !sales.purchaseEnabled}}" class="sales-paused-card">
      <text class="sales-paused-title">会员购买暂停中</text>
      <text class="sales-paused-desc">{{sales.message || '已有会员权益、订单和售后不受影响。'}}</text>
    </view>

    <block wx:if="{{membership.pricingVisible && (!sales || sales.purchaseEnabled)}}">
      <text class="section-label">{{membership.member ? '会员方案' : '开通会员以增加提醒额度'}}</text>
      <text wx:if="{{!membership.member}}" class="section-hint">提醒名额为可同时开启的提醒数量</text>
      <text wx:if="{{membership.upgradeCreditAvailable}}" class="upgrade-credit-note">{{membership.upgradeCreditText}}</text>
      <view class="package-list">
        <view
          wx:for="{{visiblePackages}}"
          wx:key="id"
          class="package-row {{item._selected ? 'selected' : ''}} {{item._available ? '' : 'disabled'}}"
          bindtap="onPackageTap"
          data-id="{{item.id}}"
        >
          <view class="package-main">
            <view class="package-title-line">
              <text class="package-title">{{item._optionTitle}}</text>
              <text wx:if="{{item.badge}}" class="package-badge">{{item.badge}}</text>
            </view>
            <text class="package-desc">{{item._optionDesc}}</text>
            <text wx:if="{{!item._available}}" class="package-lock">{{item.actionText}}</text>
          </view>
          <view class="package-price">
            <text class="package-price-value">{{item.priceText}}</text>
            <view class="package-radio {{item._selected ? 'checked' : ''}}">
              <svg-icon wx:if="{{item._selected}}" name="check-white" size="12px" />
            </view>
          </view>
        </view>
      </view>
      <text wx:if="{{membership.memberTier === 'QUOTA_10'}}" class="package-tip">当前为 10 个提醒名额档，超过后补差价升级为不限额度。</text>
      <text wx:elif="{{!membership.member}}" class="package-tip">一次性付费，无自动续费</text>

      <view class="purchase-note">
        <text wx:if="{{isIosDevice}}">iOS 购买由 Apple 处理，支付成功后权益立即生效。退款申请和审核由 Apple 独立处理，小程序客服无法决定结果；如 Apple 确认退款，系统会按本订单自动回收对应权益。</text>
        <text wx:else>虚拟权益支付成功后生效。支付后 24 小时内且没有新增任何提醒，可申请退款，需客服核实；已使用、超时或无正当理由的申请不支持。每笔订单最多一次全额退款。</text>
      </view>

      <view wx:if="{{!payCapability.supported}}" class="pay-capability-note">
        <text class="pay-capability-title">当前设备无法完成购买</text>
        <text class="pay-capability-desc">{{payUnsupportedTip}}</text>
      </view>

      <view class="pay-btn {{selectedPackage ? '' : 'disabled'}}" bindtap="onPay">
        <text>{{payButtonText}}</text>
      </view>
    </block>
  </block>
</view>

<payment-confirm-sheet
  show="{{showPayConfirm}}"
  title="{{confirmTitle}}"
  amount="{{confirmAmount}}"
  expiry="{{confirmExpiry}}"
  effect="{{confirmEffect}}"
  button-text="{{confirmPayButtonText}}"
  paying="{{purchasing}}"
  bind:close="onClosePayConfirm"
  bind:confirm="onConfirmPay"
/>
