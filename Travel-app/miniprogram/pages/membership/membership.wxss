.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back {
  position: absolute;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
}

.page-body { padding: 24rpx 30rpx 120rpx; }
.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }
.load-failed { display: flex; flex-direction: column; align-items: center; gap: 22rpx; padding: 120rpx 0; }
.load-failed-title { color: var(--color-muted); font-size: 24rpx; }
.retry-btn { padding: 16rpx 30rpx; border-radius: 14rpx; background: var(--color-cream); color: var(--color-text); font-size: 24rpx; }

.explain-card {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #FFF9EB, #F7E9CE);
  border: 1rpx solid #E8D2AA;
}
.explain-title { display: block; color: #4A2D23; font-size: 29rpx; font-weight: 700; line-height: 1.38; }
.quota-pair { display: flex; align-items: center; gap: 18rpx; margin-top: 16rpx; }
.quota-item { display: flex; flex: 1; flex-direction: column; gap: 3rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: rgba(255,255,255,.68); }
.quota-item.highlight { background: #B8904A; }
.quota-label { color: #8A7257; font-size: 19rpx; }
.quota-value { color: #4A2D23; font-size: 28rpx; font-weight: 700; }
.quota-item.highlight .quota-label, .quota-item.highlight .quota-value { color: #FFFDF7; }
.quota-arrow { color: #A98B5F; font-size: 26rpx; }
.explain-foot { display: block; margin-top: 14rpx; color: #765F4B; font-size: 21rpx; line-height: 1.5; }

.status-band {
  margin-top: 18rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.status-band.member-first { margin-top: 0; }
.status-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.status-title { display: block; color: var(--color-ink); font-size: 30rpx; font-weight: 600; }
.status-expiry { display: block; margin-top: 7rpx; color: var(--color-muted); font-size: 22rpx; }
.status-badge { flex-shrink: 0; padding: 6rpx 16rpx; border-radius: 999rpx; background: var(--color-cream); color: var(--color-text); font-size: 21rpx; }
.status-badge.active { background: #F2E4C0; color: #8A5A12; }
.usage-row { display: flex; justify-content: space-between; margin-top: 24rpx; color: var(--color-text); font-size: 23rpx; }
.usage-unlimited { color: #9A6B22; font-weight: 600; }
.usage-track { height: 10rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: #EFE8DA; }
.usage-fill { height: 10rpx; border-radius: 999rpx; background: #B8904A; }
.protected-note { display: block; margin-top: 16rpx; padding-top: 15rpx; border-top: 1rpx solid var(--color-border); color: #7E6238; font-size: 21rpx; line-height: 1.55; }

.payment-state {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid #E5D4B4;
  background: #FFF9EA;
}
.payment-state.PAID_GRANT_FAILED, .payment-state.FAILED { border-color: #E6C0B3; background: #FFF4F0; }
.payment-state-title { color: var(--color-ink); font-size: 26rpx; font-weight: 600; }
.payment-state-desc { color: var(--color-muted); font-size: 22rpx; line-height: 1.55; }
.payment-state-action { margin-top: 6rpx; color: var(--color-primary); font-size: 22rpx; font-weight: 600; }

.order-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 18rpx;
  background: var(--color-surface);
}
.order-entry-copy { display: flex; flex-direction: column; gap: 5rpx; }
.order-entry-title { color: var(--color-ink); font-size: 25rpx; font-weight: 600; }
.order-entry-desc { color: var(--color-muted); font-size: 21rpx; }

.section-label { display: block; margin: 34rpx 4rpx 14rpx; color: var(--color-ink); font-size: 26rpx; font-weight: 600; }
.benefit-list { overflow: hidden; border-radius: 20rpx; background: var(--color-surface); box-shadow: var(--shadow-card); }
.benefit-row { display: flex; gap: 16rpx; padding: 24rpx 26rpx; border-bottom: 1rpx solid var(--color-border); }
.benefit-row:last-child { border-bottom: none; }
.benefit-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; }
.benefit-title { color: var(--color-ink); font-size: 25rpx; font-weight: 600; }
.benefit-desc { color: var(--color-muted); font-size: 22rpx; line-height: 1.5; }

.package-list { display: flex; flex-direction: column; gap: 16rpx; }
.package-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 26rpx; border: 1rpx solid var(--color-border); border-radius: 18rpx; background: var(--color-surface); }
.package-row.selected { border-color: #C8A15E; background: #FFFBEF; }
.package-row.disabled { opacity: 0.58; }
.package-main { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; }
.package-title-line { display: flex; align-items: center; gap: 10rpx; }
.package-title { color: var(--color-ink); font-size: 26rpx; font-weight: 600; }
.package-badge { padding: 3rpx 10rpx; border-radius: 6rpx; background: #F2E4C0; color: #8A5A12; font-size: 19rpx; }
.package-desc { color: var(--color-muted); font-size: 22rpx; line-height: 1.5; }
.package-lock { color: var(--color-primary); font-size: 21rpx; }
.package-price { display: flex; align-items: center; gap: 16rpx; flex-shrink: 0; }
.package-price-value { color: var(--color-primary); font-size: 28rpx; font-weight: 700; }
.package-check { width: 30rpx; height: 30rpx; border: 2rpx solid var(--color-border); border-radius: 7rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.package-check.checked { border-color: #B8904A; background: #B8904A; }
.purchase-note { margin-top: 24rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: var(--color-cream); color: var(--color-text); font-size: 21rpx; line-height: 1.65; }
.sales-paused-card { display: flex; flex-direction: column; gap: 10rpx; margin-top: 28rpx; padding: 24rpx 22rpx; border: 1rpx solid #D8A08E; border-radius: 16rpx; background: #FFF1EC; }
.sales-paused-title { color: #A7462B; font-size: 25rpx; font-weight: 600; }
.sales-paused-desc { color: #8F4B37; font-size: 21rpx; line-height: 1.6; }
.pay-capability-note { display: flex; flex-direction: column; gap: 10rpx; margin-top: 24rpx; padding: 22rpx; border: 1rpx solid #E6C0B3; border-radius: 16rpx; background: #FFF4F0; }
.pay-capability-title { color: #A7462B; font-size: 25rpx; font-weight: 600; }
.pay-capability-desc { color: #8F4B37; font-size: 21rpx; line-height: 1.6; }
.pay-btn { height: 84rpx; margin-top: 24rpx; border-radius: 18rpx; background: var(--color-primary); color: #FFFEFB; font-size: 27rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.pay-btn.disabled { background: var(--color-placeholder); }

.auto-refresh-hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #F1F7FB;
  color: #356A8A;
  font-size: 21rpx;
  line-height: 1.55;
}
.auto-refresh-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #5D93B2;
}
