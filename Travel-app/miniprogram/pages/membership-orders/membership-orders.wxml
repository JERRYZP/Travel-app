<view class="navbar" style="height: {{statusBarHeight + navBarHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-content" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="onBack">
      <svg-icon name="back-thick" size="18px" />
    </view>
    <text class="navbar-title">订单与退款</text>
  </view>
</view>
<view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="page-body">
  <view class="payment-faq-entry" bindtap="onOpenPaymentFaq">
    <view class="payment-faq-icon"><svg-icon name="chat-linear" size="18px" /></view>
    <view class="payment-faq-copy">
      <text class="payment-faq-title">支付、到账、退款有疑问？</text>
      <text class="payment-faq-desc">先看会员与支付常见问题</text>
    </view>
    <svg-icon name="chevron-right-gold" size="12px" />
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading size="36rpx" color="#B8904A" />
  </view>

  <view wx:elif="{{loadFailed}}" class="load-failed">
    <text class="load-failed-title">订单加载失败</text>
    <view class="retry-btn" bindtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <text class="empty-title">还没有会员订单</text>
    <text class="empty-desc">开通会员或加购提醒名额后，支付和退款进度会显示在这里。</text>
  </view>

  <block wx:else>
    <view class="order-summary">
      <text class="order-summary-title">会员与提醒名额记录</text>
      <text class="order-summary-count">共 {{count}} 笔</text>
    </view>

    <view wx:if="{{autoRefreshHint}}" class="auto-refresh-hint">
      <view class="auto-refresh-dot"></view>
      <text>{{autoRefreshHint}}</text>
    </view>

    <view class="order-list">
      <view
        wx:for="{{items}}"
        wx:key="_id"
        class="order-card"
        bindtap="onOrderDetail"
        data-id="{{item._id}}"
      >
        <view class="order-head">
          <text class="order-title">{{item.title}}</text>
          <text class="order-status {{item._statusTone}}">{{item.statusLabel}}</text>
        </view>
        <view class="order-meta">
          <text>{{item.paidAtText ? '支付于 ' + item.paidAtText : '创建于 ' + item.createdAtText}}</text>
          <text class="order-amount">{{item.amountText}}</text>
        </view>
        <view wx:if="{{item.refundStatusLabel}}" class="refund-line {{item._refundTone}}">
          <text>退款进度</text>
          <text>{{item.refundStatusLabel}}</text>
        </view>
        <view class="order-no-row">
          <text class="order-no">订单号 {{item.outTradeNo}}</text>
          <text class="order-copy" catchtap="onCopyOrderNo" data-no="{{item.outTradeNo}}">复制</text>
        </view>
        <view class="order-detail-hint">查看订单详情与可执行操作 <svg-icon name="chevron-down" size="11px" rotate="270" /></view>
      </view>
    </view>
  </block>
</view>
