.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; padding-left: 20rpx; position: relative; }
.navbar-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
  white-space: nowrap;
}

.page-body { position: relative; padding: 0 30rpx 150rpx; }

/* 页头：标题左对齐 + 右上角中国风插画（宝塔+云） */
.page-illustration {
  position: absolute; top: 20rpx; right: 0;
  width: 265rpx; height: 124rpx; z-index: 0;
  pointer-events: none;
}
.auth-guide {
  display: flex; align-items: flex-start; gap: 14rpx;
  margin-top: 30rpx; padding: 22rpx 24rpx;
  background: #FBF5E6; border: 1rpx solid #EAD9B7; border-radius: 18rpx;
  color: #7A5540; font-size: 23rpx; line-height: 1.65;
}
.auth-guide text { flex: 1; }

.section-label {
  position: relative;
  z-index: 1;
  display: block; font-size: 28rpx; color: var(--color-ink);
  margin-top: 44rpx; margin-bottom: 18rpx;
}

.setting-card {
  position: relative; z-index: 1;
  margin-top: 16rpx;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 0 24rpx;
}

.setting-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #EDE5D2;
}
.setting-row:last-child { border-bottom: none; }
.setting-row-left { display: flex; align-items: center; gap: 16rpx; }
.setting-row-info { display: flex; flex-direction: column; gap: 4rpx; }
.setting-row-label { font-size: 28rpx; color: var(--color-ink); }
.setting-row-hint { font-size: 22rpx; color: #C3B199; }
.setting-row-coming { font-size: 24rpx; color: #BAA588; }

/* 图2：选中勾选框为金色 #B8904A */
.checkbox {
  width: 30rpx; height: 30rpx; border-radius: 8rpx;
  border: 2rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
}
.checkbox.checked { background: #B8904A; border-color: #B8904A; }

.offset-options { display: flex; align-items: center; gap: 72rpx; }
.offset-option { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--color-ink); }

/* 图2：居中窄按钮 */
.submit-btn {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  width: 380rpx; height: 80rpx; margin: 48rpx auto 0;
  background: var(--color-primary); border-radius: 24rpx;
  color: #fff; font-size: 28rpx; font-weight: 600;
}
.submit-btn.disabled { background: #DBCDBB; opacity: 1; color: #FFFEFB; }

.auth-card { margin-top: 32rpx; padding-bottom: 24rpx; }
.auth-title-row { border-bottom: none; }
.auth-divider { height: 1rpx; background: #EDE5D2; }
.auth-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  font-size: 25rpx;
  color: #5E3D32;
}
.auth-label { color: #5E3D32; }
.quota-summary { font-size: 23rpx; }
.auth-status.ok, .quota-ok { color: #4A7C59; }
.auth-status.off, .quota-short { color: var(--color-primary); }
.auth-inline-action {
  align-self: flex-end;
  margin-top: -40rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #F5DDD5;
  color: var(--color-primary);
  font-size: 22rpx;
}
.quota-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  /* 本行文案整体上移 12px，贴近上方授权结果。 */
  margin-top: -24rpx;
  min-height: 72rpx;
  font-size: 23rpx;
  color: #9B7F6F;
}
.quota-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.quota-reserved {
  color: #B07E35;
  font-size: 20rpx;
  line-height: 1.4;
}
.fill-quota-btn {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: #F5DDD5;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 600;
}
.auth-feedback {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #FBF5E6;
  font-size: 22rpx;
  line-height: 1.5;
}
.auth-feedback.ok { color: #4A7C59; background: #EEF6EF; }
.auth-feedback.warn { color: #B05C3C; background: #FBF0EA; }
.auth-note {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FBF5E6;
  color: #7A5540;
  font-size: 22rpx;
  line-height: 1.6;
}
.sample-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 24rpx 0 6rpx;
  color: #B07E35;
  font-size: 24rpx;
}
.sms-card { margin-top: 24rpx; }

.membership-gate {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #E8D6B8;
  border-radius: 20rpx;
  background: #FBF5E6;
}
.membership-gate-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}
.membership-gate-title {
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 700;
}
.membership-quota {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  margin: 4rpx 0 2rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #E8D6B8;
  border-bottom: 1rpx solid #E8D6B8;
}
.membership-quota-label {
  color: #9B7F6F;
  font-size: 21rpx;
  font-weight: 600;
}
.membership-quota-formula {
  color: #5E3D32;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}
.membership-quota-requested {
  color: #B05C3C;
  font-size: 22rpx;
  line-height: 1.5;
}
.membership-gate-desc {
  color: #7A5540;
  font-size: 22rpx;
  line-height: 1.6;
}
.membership-gate-note {
  display: block;
  margin-top: 2rpx;
  color: #9B7F6F;
  font-size: 21rpx;
}
.membership-gate-action {
  width: 100%;
  min-height: 72rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #FFFEFB;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.membership-gate-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E8D6B8;
  color: #8A6A43;
  font-size: 22rpx;
}
.gate-hint {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  color: #B59E80;
  font-size: 22rpx;
}

/* 提交成功态：轻量卡片，不做关注拦截 —— 点卡片外任意处立即回首页 */
.success-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 230;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(74, 45, 35, 0.45);
}
.success-card {
  position: relative;
  width: 540rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 24rpx;
  border-radius: 24rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
/* 右上角主动关闭：和「点卡片外」同一条动线，都是立刻回首页 */
.success-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.45;
}
.success-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #D8EAD8;
}
.success-title {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}
.success-oa {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 22rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #FBF5E6;
}
.success-oa-text {
  font-size: 23rpx;
  color: #B07E35;
}
/* 弱化提示：只做预期管理，不抢公众号入口的视线 */
.success-countdown {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: var(--text-faint);
}

.payment-state {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #E5D4B4;
  border-radius: 16rpx;
  background: #FFF9EA;
}
.payment-state.PAID_GRANTED { border-color: #BFD8C2; background: #F1F8F1; }
.payment-state.PAID_GRANT_FAILED, .payment-state.FAILED { border-color: #E6C0B3; background: #FFF4F0; }
.payment-state-title { color: var(--color-ink); font-size: 25rpx; font-weight: 600; }
.payment-state-desc { color: var(--color-muted); font-size: 21rpx; line-height: 1.55; }
.payment-state-action {
  align-self: flex-start;
  margin-top: 4rpx;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.upgrade-mask {
  position: fixed;
  inset: 0;
  z-index: 240;
  display: flex;
  align-items: flex-end;
  background: rgba(34, 25, 19, .46);
}
.upgrade-sheet {
  width: 100%;
  padding: 30rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #FFFDF8;
  box-sizing: border-box;
}
.upgrade-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.upgrade-title { color: var(--color-ink); font-size: 30rpx; font-weight: 700; }
.upgrade-close { color: var(--color-muted); font-size: 42rpx; line-height: 1; padding: 0 8rpx; }
.upgrade-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 12rpx 0; color: var(--color-text); font-size: 24rpx; }
.upgrade-row text:last-child { max-width: 72%; text-align: right; }
.upgrade-amount { color: var(--color-primary); font-weight: 700; }
.upgrade-desc, .upgrade-rule { display: block; margin-top: 14rpx; color: var(--color-muted); font-size: 21rpx; line-height: 1.55; }
.upgrade-rule { padding: 16rpx 18rpx; border-radius: 13rpx; background: var(--color-cream); }
.upgrade-confirm-btn { height: 82rpx; margin-top: 24rpx; border-radius: 18rpx; background: var(--color-primary); color: #FFFEFB; font-size: 28rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
