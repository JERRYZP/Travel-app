.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; padding-left: 20rpx; position: relative; }
.navbar-back { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
  white-space: nowrap;
}

.page-body { position: relative; padding: 0 30rpx 150rpx; }

/* 页头：标题左对齐 + 右上角中国风插画（宝塔+云） */
.page-illustration {
  position: absolute; top: 20rpx; right: 0;
  width: 265rpx; height: 124rpx; z-index: 0;
  pointer-events: none;
}
.auth-guide {
  display: flex; align-items: flex-start; gap: 14rpx;
  margin-top: 30rpx; padding: 22rpx 24rpx;
  background: #FBF5E6; border: 1rpx solid #EAD9B7; border-radius: 18rpx;
  color: #7A5540; font-size: 23rpx; line-height: 1.65;
}
.auth-guide text { flex: 1; }

.section-label {
  position: relative;
  z-index: 1;
  display: block; font-size: 28rpx; color: var(--color-ink);
  margin-top: 44rpx; margin-bottom: 18rpx;
}

.setting-card {
  position: relative; z-index: 1;
  margin-top: 16rpx;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 0 24rpx;
}

.setting-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #EDE5D2;
}
.setting-row:last-child { border-bottom: none; }
.setting-row-left { display: flex; align-items: center; gap: 16rpx; }
.setting-row-info { display: flex; flex-direction: column; gap: 4rpx; }
.setting-row-label { font-size: 28rpx; color: var(--color-ink); }
.setting-row-hint { font-size: 22rpx; color: #C3B199; }
.setting-row-coming { font-size: 24rpx; color: #BAA588; }

/* 图2：选中勾选框为金色 #B8904A */
.checkbox {
  width: 30rpx; height: 30rpx; border-radius: 8rpx;
  border: 2rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
}
.checkbox.checked { background: #B8904A; border-color: #B8904A; }

.offset-options { display: flex; align-items: center; gap: 72rpx; }
.offset-option { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--color-ink); }

/* 图2：居中窄按钮 */
.submit-btn {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  width: 380rpx; height: 80rpx; margin: 48rpx auto 0;
  background: var(--color-primary); border-radius: 24rpx;
  color: #fff; font-size: 28rpx; font-weight: 600;
}
.submit-btn.disabled { background: #DBCDBB; opacity: 1; color: #FFFEFB; }

.auth-card { padding-bottom: 24rpx; }
.auth-title-row { border-bottom: none; }
.auth-divider { height: 1rpx; background: #EDE5D2; }
.auth-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  font-size: 25rpx;
  color: #5E3D32;
}
.auth-label { color: #5E3D32; }
.quota-summary { font-size: 23rpx; }
.auth-status.ok, .quota-ok { color: #4A7C59; }
.auth-status.off, .quota-short { color: var(--color-primary); }
.auth-inline-action {
  align-self: flex-end;
  margin-top: -40rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #F5DDD5;
  color: var(--color-primary);
  font-size: 22rpx;
}
.quota-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  /* 本行文案整体上移 12px，贴近上方授权结果。 */
  margin-top: -24rpx;
  min-height: 72rpx;
  font-size: 23rpx;
  color: #9B7F6F;
}
.fill-quota-btn {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: #F5DDD5;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 600;
}
.auth-note {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FBF5E6;
  color: #7A5540;
  font-size: 22rpx;
  line-height: 1.6;
}
.sample-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 24rpx 0 6rpx;
  color: #B07E35;
  font-size: 24rpx;
}
.sms-card { margin-top: 24rpx; }
.gate-hint {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  color: #B59E80;
  font-size: 22rpx;
}
