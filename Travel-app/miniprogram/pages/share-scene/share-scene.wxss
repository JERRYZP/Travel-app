.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 90;
  background: var(--color-page);
}
.navbar-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar-back {
  position: absolute;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar-back:active { opacity: .6; }
.navbar-title {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
}
/* 返回主页悬浮按钮：底部居中，距底 28px（含安全区） */
.home-float {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(28px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  box-shadow: 0 8rpx 24rpx rgba(192, 71, 42, 0.32);
  z-index: 95;
}
.home-float-hover { opacity: 0.85; }
.home-float-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}
.page-body {
  /* 底部 152rpx：避开 88rpx 的「返回主页」悬浮按钮 + 28px 间距 */
  padding: 24rpx 30rpx 152rpx;
}

.scene-hero {
  padding: 30rpx 28rpx;
  border: 1rpx solid #E8D4B0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF9EC 0%, #F3E3C1 100%);
  box-shadow: 0 4rpx 16rpx rgba(100, 60, 20, 0.055);
}
.scene-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--color-ink);
}
.scene-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #8F6B57;
}

.scene-notice {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FDF3F2;
  border: 1rpx solid #F5C6C0;
  color: #9B4E43;
  font-size: 23rpx;
  line-height: 1.6;
}

.scene-list { margin-top: 22rpx; }

.scene-footnote {
  padding: 24rpx 12rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.6;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 360rpx;
  padding: 48rpx 24rpx;
  color: var(--color-muted);
  font-size: 25rpx;
}
.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
}
.state-desc { font-size: 23rpx; }
.state-action {
  margin-top: 8rpx;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
}
