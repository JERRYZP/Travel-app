.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back { position: absolute; left: 20rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 30rpx; font-weight: 600; color: var(--color-ink); }

.page-body { padding: 32rpx 30rpx 120rpx; }

.form-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.form-label-row { display: flex; align-items: center; justify-content: space-between; }
.form-label { font-size: 26rpx; font-weight: 600; color: var(--color-ink); }
.form-count { font-size: 22rpx; color: var(--color-muted); }

.search-box {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--color-page);
  border-radius: 16rpx;
}
.search-input { flex: 1; font-size: 26rpx; color: var(--color-ink); }
.search-btn {
  padding: 8rpx 24rpx;
  background: var(--color-primary);
  border-radius: 12rpx;
  color: #fff; font-size: 24rpx;
}
.form-placeholder { color: var(--color-placeholder); }

.selected-spot {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #FBF5E6;
  border: 2rpx solid #B8904A;
  border-radius: 16rpx;
}
.selected-info { display: flex; flex-direction: column; gap: 4rpx; }
.selected-name { font-size: 26rpx; font-weight: 600; color: var(--color-ink); }
.selected-hint { font-size: 20rpx; color: var(--color-muted); }

.result-list { margin-top: 20rpx; }
.result-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.result-item:last-child { border-bottom: none; }
.result-name { font-size: 26rpx; color: var(--color-ink); }
.result-meta { font-size: 22rpx; color: var(--color-muted); }
.result-empty { padding: 24rpx 0; text-align: center; font-size: 24rpx; color: var(--color-placeholder); }

.type-chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.chip {
  padding: 12rpx 26rpx;
  background: var(--color-page);
  border: 2rpx solid var(--color-border);
  border-radius: 32rpx;
  font-size: 24rpx; color: var(--color-text);
}
.chip.active { border-color: #B8904A; background: #FBF5E6; color: #7A5540; }

.form-textarea {
  width: 100%; height: 220rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--color-page);
  border-radius: 16rpx;
  font-size: 26rpx; color: var(--color-ink);
}
.form-input {
  width: 100%;
  margin-top: 20rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--color-page);
  border-radius: 16rpx;
  font-size: 26rpx; color: var(--color-ink);
}

.submit-btn {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  width: 380rpx; height: 80rpx; margin: 48rpx auto 0;
  background: var(--color-primary); border-radius: 24rpx;
  color: #fff; font-size: 28rpx; font-weight: 600;
}
.submit-btn.disabled { opacity: 0.6; }
