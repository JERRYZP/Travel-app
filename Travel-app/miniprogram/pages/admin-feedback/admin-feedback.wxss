.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back { position: absolute; left: 20rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 30rpx; font-weight: 600; color: var(--color-ink); }

.page-body { padding: 24rpx 30rpx 120rpx; }

/* 筛选 Tab */
.filter-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.filter-item {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  height: 64rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: 32rpx;
  font-size: 24rpx; color: var(--color-ink);
}
.filter-item.active { border-color: #B8904A; background: #FBF5E6; color: #B8904A; font-weight: 600; }

/* 状态块 */
.state-block { padding: 120rpx 0; display: flex; justify-content: center; }
.state-text { font-size: 26rpx; color: var(--color-muted); }

/* 卡片 */
.fb-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.fb-card-head { display: flex; align-items: center; justify-content: space-between; }
.fb-tags { display: flex; align-items: center; gap: 12rpx; }
.fb-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}
.fb-tag-suggestion { background: #FBF5E6; color: #B8904A; }
.fb-tag-bug { background: #FBEAE5; color: #C0563C; }
.fb-tag-correction { background: #E8F0F8; color: #4A7BA8; }
.fb-status-open { background: #FBF5E6; color: #B8904A; }
.fb-status-processed { background: #EDF5E8; color: #5E8C4A; }
.fb-status-ignored { background: var(--color-page); color: var(--color-muted); }
.fb-time { font-size: 22rpx; color: var(--color-muted); }

.fb-spot { margin-top: 16rpx; font-size: 24rpx; color: var(--color-ink); font-weight: 600; }
.fb-spot-divider { margin: 0 8rpx; color: var(--color-muted); font-weight: 400; }

.fb-content {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx; line-height: 1.6; color: var(--color-ink);
}

.fb-card-foot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.fb-contact { font-size: 22rpx; color: var(--color-muted); flex: 1; margin-right: 16rpx; min-width: 0; }
.fb-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 16rpx; margin-left: auto; }
.fb-btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--color-border);
  font-size: 22rpx; color: var(--color-ink);
  background: var(--color-surface);
}
.fb-btn-primary { border-color: #B8904A; color: #B8904A; background: #FBF5E6; }
.fb-btn.disabled { opacity: .5; }

/* 提交人：昵称 + OpenID + 复制 */
.fb-user-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 16rpx; padding: 10rpx 14rpx;
  background: var(--color-page); border-radius: 12rpx;
}
.fb-nickname {
  flex-shrink: 0; max-width: 220rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: 22rpx; font-weight: 600; color: var(--color-ink);
}
.fb-openid {
  flex: 1; min-width: 0;
  color: var(--color-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx; line-height: 1.4; word-break: break-all;
}
.copy-link { flex-shrink: 0; padding: 3rpx 0 3rpx 10rpx; color: #8A5A12; font-size: 19rpx; font-weight: 600; }

/* 管理员回复 */
.fb-tag-reply { background: #EAF6EE; color: #2D6B42; }
.fb-reply {
  margin-top: 16rpx; padding: 16rpx 18rpx;
  background: #FBF5E6;
  border-left: 4rpx solid #B8904A;
  border-radius: 12rpx;
}
.fb-reply-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.fb-reply-label { font-size: 21rpx; font-weight: 600; color: #8A5A12; }
.fb-reply-time { font-size: 19rpx; color: var(--color-muted); }
.fb-reply-text {
  display: block; margin-top: 8rpx;
  font-size: 25rpx; line-height: 1.6; color: var(--color-ink);
  white-space: pre-wrap;
}

/* 卡片内回复编辑器 */
.reply-editor { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--color-border); }
.reply-textarea {
  width: 100%; height: 220rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--color-page);
  border-radius: 16rpx;
  font-size: 26rpx; color: var(--color-ink);
}
.reply-placeholder { color: var(--color-placeholder); }
.reply-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.reply-count { font-size: 22rpx; color: var(--color-muted); }
.reply-actions { display: flex; gap: 16rpx; }

.load-more {
  min-height: 76rpx; margin-top: 18rpx;
  border: 1rpx solid var(--color-border); border-radius: 14rpx;
  background: var(--color-surface); color: var(--color-text);
  font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.load-more.disabled { opacity: .55; }
