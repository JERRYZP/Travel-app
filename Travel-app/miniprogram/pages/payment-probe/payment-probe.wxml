<view class="page">
  <view class="hero">
    <text class="eyebrow">CLOUDBASE PAYMENT PROBE</text>
    <text class="title">真实微信支付测试</text>
    <text class="subtitle">不创建会员、不写订单、不发权益，只验证 API v3 下单、拉起支付和回调。</text>
  </view>

  <view class="card">
    <text class="label">运行环境</text>
    <text class="value">{{cloudEnv || '未初始化'}}</text>
    <text class="label">环境版本</text>
    <text class="value">{{envVersion || '未知'}}</text>
    <view wx:if="{{blocked}}" class="warning">仅允许在开发版或真机调试中使用，体验版和正式版不会执行此探针。</view>
  </view>

  <view class="card">
    <text class="label">测试金额</text>
    <text class="amount">¥0.01</text>
    <text class="hint">这是隔离测试订单，不会发放会员权益。</text>
    <view class="button {{blocked || loading ? 'disabled' : ''}}" bindtap="onCreatePayment">
      {{loading ? '处理中…' : '创建支付并打开微信支付'}}
    </view>
  </view>

  <view class="card result-card">
    <text class="label">测试状态</text>
    <text class="status">{{status}}</text>
    <text wx:if="{{detail}}" class="detail">{{detail}}</text>
  </view>
</view>
