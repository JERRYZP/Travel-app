.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back { position: absolute; left: 20rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 30rpx; font-weight: 600; color: var(--color-ink); }

.page-body { padding: 24rpx 30rpx 120rpx; }

.hero {
  padding: 28rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #C65941 0%, #B8432A 100%);
  color: #FDF6EE;
  box-shadow: 0 8rpx 20rpx rgba(150, 51, 31, .18);
}
.hero-title { display: block; font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.hero-sub { display: block; margin-top: 8rpx; color: #F7DECF; font-size: 23rpx; line-height: 1.5; }

.guide-card { margin-top: 24rpx; padding: 28rpx 26rpx; background: var(--color-surface); border-radius: 24rpx; box-shadow: var(--shadow-card); }
.section-head { display: flex; align-items: flex-start; gap: 16rpx; }
.section-index { flex: none; width: 46rpx; height: 46rpx; border-radius: 15rpx; background: #F5DDD5; color: var(--color-primary); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; }
.section-title { display: block; color: var(--color-ink); font-size: 30rpx; font-weight: 700; }
.section-sub { display: block; margin-top: 4rpx; color: #AA927C; font-size: 22rpx; }

.mode-list { margin-top: 10rpx; }
.mode-item { padding: 20rpx 0; }
.mode-item + .mode-item { border-top: 1rpx solid var(--color-border); }
.mode-head { display: flex; align-items: center; gap: 12rpx; }
.mode-tag { flex: none; padding: 5rpx 12rpx; border-radius: 8rpx; background: #F5DDD5; color: var(--color-primary); font-size: 20rpx; font-weight: 600; }
.mode-tag.secondary { background: #EAF2FA; color: #356A8A; }
.mode-title { color: var(--color-ink); font-size: 26rpx; font-weight: 600; }
.mode-desc { display: block; margin-top: 10rpx; color: #6B5A4D; font-size: 23rpx; line-height: 1.65; }
.mode-steps { display: block; margin-top: 8rpx; color: #B07E35; font-size: 21rpx; }

.tip-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 22rpx; color: #6B5A4D; font-size: 24rpx; line-height: 1.7; }
.sample-entry {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #B07E35;
  font-size: 24rpx;
}
.card-action { margin-top: 24rpx; height: 72rpx; border-radius: 18rpx; background: var(--color-primary); color: #FFF8F2; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; }
.card-action.secondary { background: #F8F3EA; color: #8A5A12; border: 1rpx solid #EAD9B7; }
.action-row { display: flex; gap: 16rpx; }
.action-row .card-action { flex: 1; }

.faq-section { margin-top: 36rpx; }
.faq-section-head { margin-bottom: 18rpx; }
.faq-title { display: block; color: var(--color-ink); font-size: 30rpx; font-weight: 700; }
.faq-section-sub { display: block; margin-top: 4rpx; color: #A38E78; font-size: 22rpx; }
.faq-group-title { display: block; margin: 22rpx 4rpx 12rpx; color: #7A5540; font-size: 24rpx; font-weight: 600; }
.payment-faq-group { margin-top: 28rpx; padding-top: 6rpx; }
.payment-faq-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.payment-faq-head .faq-group-title { margin: 0 4rpx 12rpx; }
.payment-faq-sub { display: block; margin: 0 4rpx 12rpx; color: #A38E78; font-size: 21rpx; }
.payment-faq-count { flex: none; margin-bottom: 14rpx; color: var(--color-muted); font-size: 20rpx; }
.faq-item { margin-bottom: 14rpx; padding: 24rpx; background: var(--color-surface); border-radius: 20rpx; box-shadow: var(--shadow-card); }
.faq-question { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: var(--color-ink); font-size: 26rpx; font-weight: 600; }
.faq-answer { display: block; margin-top: 16rpx; color: #78685A; font-size: 24rpx; line-height: 1.75; }
.guide-disclaimer { display: block; margin: 34rpx 12rpx 0; color: #A99B8C; font-size: 21rpx; line-height: 1.7; text-align: center; }
