<view class="navbar" style="height: {{statusBarHeight + navBarHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-content" style="height: {{navBarHeight}}px;">
    <view class="navbar-back" bindtap="onBack"><svg-icon name="back-thick" size="18px" /></view>
    <text class="navbar-title">客服工作台</text>
  </view>
</view>
<view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="page-body">
  <view wx:if="{{forbidden}}" class="state-box">
    <text class="state-title">无权限</text>
    <text class="state-desc">当前账号不在 AFTER_SALES_ADMIN_OPENIDS 白名单内。</text>
  </view>

  <block wx:else>
    <view class="top-dashboard">
      <view class="admin-control-card quality-card tone-{{reminderQuality.statusTone}}">
        <view class="quality-head">
          <text class="quality-title">提醒质量</text>
          <text class="quality-status">{{reminderQuality.statusLabel}}</text>
        </view>
        <view class="quality-primary">
          <text class="quality-rate">{{reminderQuality.rateText}}</text>
          <view class="quality-primary-copy">
            <view class="quality-caption-row">
              <text class="quality-caption">2 分钟内送达率</text>
              <text class="quality-sample">{{reminderQuality.sampleText}}</text>
            </view>
          </view>
        </view>
        <view class="quality-baseline">
          <text class="quality-baseline-label">前 5 日均值</text>
          <text class="quality-baseline-value">{{reminderQuality.baselineText}}</text>
        </view>
        <view wx:if="{{reminderQuality.showRetry}}" class="quality-foot">
          <text class="quality-issue">{{reminderQuality.issueText}}</text>
          <text class="quality-retry" bindtap="onRetryReminderQuality">重试</text>
        </view>
      </view>

      <view class="dashboard-control-stack">
        <view wx:if="{{membershipSales}}" class="admin-control-card sales-card {{membershipSales.purchaseEnabled ? '' : 'paused'}}">
          <view class="sales-main">
            <view class="sales-title-row">
              <text class="sales-title">会员购买</text>
              <text class="sales-status {{membershipSales.purchaseEnabled ? 'open' : 'paused'}}">{{membershipSales.purchaseEnabled ? '销售中' : '已暂停'}}</text>
            </view>
            <text class="sales-desc">{{membershipSales.purchaseEnabled ? '新订单与支付可用' : '新购买已暂停；已有权益不受影响'}}</text>
            <text wx:if="{{!membershipSales.purchaseEnabled && membershipSales.reason}}" class="sales-reason">暂停原因：{{membershipSales.reason}}</text>
            <text wx:if="{{membershipSales.readError}}" class="sales-warning">配置读取失败，当前按暂停处理</text>
          </view>
          <view class="sales-action {{salesSaving ? 'disabled' : ''}}" bindtap="onToggleMembershipSales">
            {{salesSaving ? '处理中' : (membershipSales.purchaseEnabled ? '暂停' : '恢复')}}
          </view>
        </view>

        <view wx:if="{{membershipEnforcement}}" class="admin-control-card enforcement-card">
          <view class="enforcement-main">
            <view class="enforcement-title-row">
              <text class="enforcement-title">会员限制</text>
              <text class="enforcement-source">{{membershipEnforcement.sourceLabel}}</text>
            </view>
            <text class="enforcement-desc {{membershipEnforcement.readError ? 'warning' : ''}}">{{membershipEnforcement.shortDescription || membershipEnforcement.description}}</text>
          </view>
          <picker
            class="enforcement-picker"
            mode="selector"
            range="{{enforcementPickerLabels}}"
            value="{{enforcementPickerIndex}}"
            disabled="{{enforcementSaving || membershipEnforcement.unavailable}}"
            bindchange="onEnforcementModeChange"
          >
            <view class="enforcement-select {{enforcementSaving || membershipEnforcement.unavailable ? 'disabled' : ''}}">
              <text class="enforcement-select-value">{{enforcementSaving ? '处理中' : membershipEnforcement.modeLabel}}</text>
              <svg-icon name="chevron-down-muted" size="10px" />
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view wx:if="{{membershipPricing}}" class="admin-control-card pricing-card">
      <view class="enforcement-main">
        <view class="enforcement-title-row">
          <text class="enforcement-title">两档定价</text>
          <text class="enforcement-source">{{membershipPricing.sourceLabel}}</text>
        </view>
        <text class="enforcement-desc {{membershipPricing.readError ? 'warning' : ''}}">{{membershipPricing.shortDescription || membershipPricing.description}}</text>
      </view>
      <picker
        class="enforcement-picker"
        mode="selector"
        range="{{pricingPickerLabels}}"
        value="{{pricingPickerIndex}}"
        disabled="{{pricingSaving || membershipPricing.unavailable}}"
        bindchange="onPricingModeChange"
      >
        <view class="enforcement-select {{pricingSaving || membershipPricing.unavailable ? 'disabled' : ''}}">
          <text class="enforcement-select-value">{{pricingSaving ? '处理中' : membershipPricing.modeLabel}}</text>
          <svg-icon name="chevron-down-muted" size="10px" />
        </view>
      </picker>
    </view>

    <view wx:if="{{fundingBlockedCount > 0}}" class="funding-alert">
      <view class="funding-alert-copy">
        <text class="funding-alert-title">退款资金阻断</text>
        <text class="funding-alert-desc">{{fundingBlockedCount}} 笔退款因基本账户余额不足未发起。请先充值，再打开异常售后单重新退款。</text>
      </view>
      <view class="funding-alert-action" bindtap="onShowFundingBlocked">查看异常单</view>
    </view>

    <view wx:if="{{migrationEntryEnabled && !migrationCompleted}}" class="migration-card">
      <view class="migration-copy">
        <text class="migration-title">上线前数据迁移</text>
        <text class="migration-desc">为老用户回填固定保护额度，每批 50 人；自动模式会连续执行。不会删除或改写已有提醒。</text>
        <text wx:if="{{migrationMessage}}" class="migration-message">{{migrationMessage}}</text>
      </view>
      <view class="migration-actions">
        <view class="migration-action primary {{migrating && !migrationAutoRunning ? 'disabled' : ''}}" bindtap="onMigrateAllProtection">
          {{migrationAutoRunning ? '停止迁移' : '一键迁移全部'}}
        </view>
        <view class="migration-action secondary {{migrating ? 'disabled' : ''}}" bindtap="onMigrateProtection">
          {{migrating && !migrationAutoRunning ? '迁移中...' : (migrationHasMore ? '仅迁移下一批' : '仅迁移一批')}}
        </view>
      </view>
    </view>

    <view class="workspace-tabs">
      <view class="workspace-tab {{activeTab === 'orders' ? 'active' : ''}}" bindtap="onTabTap" data-tab="orders">
        <text>会员订单</text>
      </view>
      <view class="workspace-tab {{activeTab === 'afterSales' ? 'active' : ''}}" bindtap="onTabTap" data-tab="afterSales">
        <text>售后工单</text>
        <text wx:if="{{pendingCount > 0}}" class="tab-count">{{pendingCount > 99 ? '99+' : pendingCount}}</text>
      </view>
    </view>

    <view wx:if="{{activeTab === 'orders'}}" class="order-stats">
      <view class="order-stat">
        <text class="order-stat-value">{{orderStats ? orderStats.totalOrders : '—'}}</text>
        <text class="order-stat-label">今日订单</text>
      </view>
      <view class="order-stat">
        <text class="order-stat-value">{{orderStats ? orderStats.paidOrders : '—'}}</text>
        <text class="order-stat-label">已支付</text>
      </view>
      <view class="order-stat">
        <text class="order-stat-value">{{orderStats ? orderStats.refundedOrdersText : '—'}}</text>
        <text class="order-stat-label">已退款</text>
      </view>
      <view class="order-stat">
        <text class="order-stat-value amount">{{orderStats ? orderStats.netAmountText : '—'}}</text>
        <text class="order-stat-label">当日净赚</text>
      </view>
    </view>
    <view
      wx:if="{{activeTab === 'orders' && orderStatsPendingBackend}}"
      class="order-stats-note"
    >统计服务待部署</view>
    <view
      wx:elif="{{activeTab === 'orders' && orderStatsFailed}}"
      class="order-stats-note action"
      bindtap="loadOrderStats"
    >统计加载失败，点击重试</view>

    <view class="filter-sticky" style="top: {{filterStickyTop}}px;">
      <view class="admin-search">
        <svg-icon name="search" size="15px" />
        <input
          class="admin-search-input"
          value="{{keywordInput}}"
          placeholder="{{searchPlaceholder}}"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <view wx:if="{{keywordInput}}" class="admin-search-clear" bindtap="onClearSearch">
          <svg-icon name="close" size="12px" />
        </view>
        <view class="admin-search-submit" bindtap="onSearchConfirm">搜索</view>
      </view>

      <view class="filter-toolbar">
        <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="filter-row">
            <view
              wx:for="{{filters}}"
              wx:key="key"
              class="filter-chip {{activeFilter === item.key ? 'active' : ''}}"
              bindtap="onFilterTap"
              data-key="{{item.key}}"
            >{{item.label}}</view>
          </view>
        </scroll-view>
        <picker
          wx:if="{{activeTab === 'orders'}}"
          class="order-time-picker"
          mode="selector"
          range="{{orderTimeRangeLabels}}"
          value="{{orderTimeRangeIndex}}"
          bindchange="onOrderTimeRangeChange"
        >
          <view class="order-time-select">
            <text class="order-time-value">{{orderTimeRangeLabel}}</text>
            <svg-icon name="chevron-down-muted" size="10px" />
          </view>
        </picker>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-wrap"><van-loading size="36rpx" color="#B8904A" /></view>
    <view wx:elif="{{loadFailed}}" class="state-box">
      <text class="state-title">加载失败</text>
      <view class="retry-btn" bindtap="loadList">重新加载</view>
    </view>
    <view wx:elif="{{items.length === 0}}" class="state-box">
      <text class="state-title">{{emptyTitle}}</text>
      <text class="state-desc">{{emptyDesc}}</text>
    </view>

    <block wx:else>
      <view wx:if="{{activeTab === 'orders'}}" class="order-list">
        <view wx:for="{{items}}" wx:key="_id" class="order-card" bindtap="onOrderTap" data-id="{{item.orderId}}">
          <view class="order-card-head">
            <view class="order-user-line">
              <text class="order-nickname">{{item.user.nickname || '未设置昵称'}}</text>
              <text class="order-status tone-{{item._statusTone}}">{{item.statusLabel}}</text>
            </view>
            <text class="order-amount">{{item.amountText}}</text>
          </view>
          <view class="openid-row">
            <text class="openid-value">OpenID {{item.user.openId}}</text>
            <view class="copy-link" catchtap="onCopyText" data-value="{{item.user.openId}}">复制</view>
          </view>
          <text class="order-title">{{item.title}}</text>
          <view class="order-tags">
            <text class="meta-tag">{{item.paymentChannelLabel}}</text>
            <text class="meta-tag">{{item.entitlementStatusLabel}}</text>
            <text wx:if="{{item.refundStatusLabel}}" class="meta-tag warning">{{item.refundStatusLabel}}</text>
            <text wx:if="{{item.cases.count > 0}}" class="meta-tag case {{item.cases.latestStatus === 'UNDER_REVIEW' ? 'reviewing' : ''}}">{{item.cases.latestStatusLabel}}</text>
          </view>
          <view class="order-foot">
            <text>订单 {{item.outTradeNo}}</text>
            <text>{{item.createdAtText}}</text>
          </view>
        </view>
      </view>

      <view wx:else class="case-list">
        <view wx:for="{{items}}" wx:key="_id" class="case-card" bindtap="onCaseTap" data-id="{{item._id}}">
          <view class="case-head">
            <text class="case-no">{{item.caseNo}}</text>
            <view class="case-head-right">
              <text wx:if="{{item.systemGenerated}}" class="case-auto">系统自动</text>
              <text wx:if="{{item.fundingBlocked}}" class="case-funding">资金不足</text>
              <text class="case-status {{item.status === 'CANCELLED' ? 'cancelled' : ''}} {{item.status === 'UNDER_REVIEW' ? 'reviewing' : ''}}">{{item.statusLabel}}</text>
            </view>
          </view>
          <view class="case-user-row">
            <text class="case-user-name">{{item.user.nickname || '未设置昵称'}}</text>
            <text class="case-openid">{{item.user.openId}}</text>
            <view class="copy-link" catchtap="onCopyText" data-value="{{item.user.openId}}">复制</view>
          </view>
          <text class="case-title">{{item.typeLabel}} · {{item.title}}</text>
          <text class="case-meta">订单 {{item.outTradeNo}}</text>
          <text class="case-meta">申请时间 {{item.createdAtText}}</text>
          <text class="case-amount">{{item.amountText}}</text>
        </view>
      </view>

      <view wx:if="{{hasMore}}" class="load-more {{loadingMore ? 'disabled' : ''}}" bindtap="onLoadMore">
        {{loadingMore ? '加载中...' : '加载更多'}}
      </view>
    </block>
  </block>
</view>

<view wx:if="{{showSalesConfirm}}" class="sales-confirm-mask" bindtap="onCloseSalesConfirm">
  <view class="sales-confirm-sheet" catchtap="noop">
    <view class="sales-confirm-head">
      <text class="sales-confirm-title">暂停会员购买</text>
      <view class="sales-confirm-close" bindtap="onCloseSalesConfirm">×</view>
    </view>
    <text class="sales-confirm-desc">暂停后不能再创建新订单或对待支付订单发起支付；已打开支付窗口、已付款权益、退款和售后不受影响。</text>
    <textarea
      class="sales-confirm-input"
      placeholder="请填写暂停原因（必填）"
      value="{{salesReason}}"
      bindinput="onSalesReasonInput"
      maxlength="160"
      focus
    />
    <view class="sales-confirm-actions">
      <view class="sales-confirm-btn cancel" bindtap="onCloseSalesConfirm">取消</view>
      <view class="sales-confirm-btn primary {{salesSaving ? 'disabled' : ''}}" bindtap="onConfirmMembershipSalesPause">
        {{salesSaving ? '暂停中...' : '确认暂停'}}
      </view>
    </view>
  </view>
</view>

<view wx:if="{{orderDetail}}" class="detail-mask" bindtap="onCloseOrderDetail">
  <view class="detail-sheet" catchtap="noop">
    <view class="detail-head">
      <text class="detail-title">会员订单详情</text>
      <view class="detail-close" bindtap="onCloseOrderDetail">×</view>
    </view>
    <scroll-view class="detail-scroll" scroll-y>
      <view class="detail-status">{{orderDetail.order.statusLabel}}</view>
      <view class="detail-section">
        <text class="detail-section-title">用户信息</text>
        <view class="detail-user-head">
          <text class="detail-user-name">{{orderDetail.user.nickname || '未设置昵称'}}</text>
          <text class="detail-user-member {{orderDetail.user.member ? 'active' : ''}}">{{orderDetail.user.member ? '会员有效' : '非会员'}}</text>
        </view>
        <view class="detail-copy-row">
          <text class="detail-break">OpenID {{orderDetail.user.openId}}</text>
          <view class="copy-link" catchtap="onCopyText" data-value="{{orderDetail.user.openId}}">复制</view>
        </view>
        <text wx:if="{{orderDetail.user.memberExpiresAtText}}">会员到期：{{orderDetail.user.memberExpiresAtText}}</text>
        <text>历史名额包：{{orderDetail.user.taskPackCount}} 包 / {{orderDetail.user.taskPackSlots}} 个名额</text>
      </view>
      <view class="detail-section">
        <text class="detail-section-title">订单信息</text>
        <text>商品：{{orderDetail.order.title}}</text>
        <text>金额：{{orderDetail.order.amountText}}</text>
        <view class="detail-copy-row">
          <text class="detail-break">订单号：{{orderDetail.order.outTradeNo}}</text>
          <view class="copy-link" catchtap="onCopyText" data-value="{{orderDetail.order.outTradeNo}}">复制</view>
        </view>
        <text>支付渠道：{{orderDetail.order.paymentChannelLabel}}</text>
        <text wx:if="{{orderDetail.order.transactionId}}">微信交易号：{{orderDetail.order.transactionId}}</text>
        <text>创建时间：{{orderDetail.order.createdAtText || '—'}}</text>
        <text>支付时间：{{orderDetail.order.paidAtText || '—'}}</text>
        <text wx:if="{{orderDetail.order.expiresAtText}}">支付截止：{{orderDetail.order.expiresAtText}}</text>
        <text wx:if="{{orderDetail.order.closedAtText}}">关闭时间：{{orderDetail.order.closedAtText}}</text>
      </view>
      <view class="detail-section">
        <text class="detail-section-title">权益与退款</text>
        <text>权益状态：{{orderDetail.order.entitlementStatusLabel}}</text>
        <text>发放状态：{{orderDetail.order.grantStatusLabel}}</text>
        <text wx:if="{{orderDetail.order.refundStatusLabel}}">退款状态：{{orderDetail.order.refundStatusLabel}}</text>
        <text wx:if="{{orderDetail.order.paymentState.tradeState}}">最近查单：{{orderDetail.order.paymentState.tradeState}}</text>
        <text wx:if="{{orderDetail.order.paymentState.amountFen}}">查单金额：{{orderDetail.order.paymentState.amountFen}} 分</text>
        <view wx:if="{{orderDetail.order.entitlementGrant}}" class="entitlement-snapshot">
          <text>本单会员时长增量：{{orderDetail.order.entitlementGrant.memberDaysAdded || 0}} 天</text>
          <text wx:if="{{orderDetail.order.unlimitedReminders}}">本单权益：会员有效期内不限提醒名额</text>
          <text>本单名额包增量：{{orderDetail.order.entitlementGrant.taskPackCountAdded || 0}}</text>
          <text>本单提醒名额增量：{{orderDetail.order.entitlementGrant.taskPackSlotsAdded || 0}}</text>
        </view>
      </view>
      <view class="detail-section">
        <text class="detail-section-title">关联售后</text>
        <view wx:if="{{orderDetail.order.relatedCases.length > 0}}" class="related-case-list">
          <view
            wx:for="{{orderDetail.order.relatedCases}}"
            wx:key="_id"
            class="related-case-row"
            bindtap="onOrderCaseTap"
            data-id="{{item._id}}"
          >
            <view class="related-case-head">
              <text>{{item.caseNo}}</text>
              <text>{{item.statusLabel}}</text>
            </view>
            <text>{{item.typeLabel}} · {{item.createdAtText}}</text>
          </view>
        </view>
        <text wx:else>本订单暂无售后记录</text>
      </view>
      <text class="audit-note">查看用户身份、订单和交易号均写入 admin_audit_logs。</text>
    </scroll-view>
  </view>
</view>

<view wx:if="{{detail}}" class="detail-mask" bindtap="onCloseDetail">
  <view class="detail-sheet" catchtap="noop">
    <view class="detail-head">
      <text class="detail-title">售后单 {{detail.case.caseNo}}</text>
      <view class="detail-close" bindtap="onCloseDetail">×</view>
    </view>
    <scroll-view class="detail-scroll" scroll-y>
      <view class="detail-status {{detail.case.status === 'CANCELLED' ? 'cancelled' : ''}}">{{detail.case.statusLabel}}</view>
      <view class="detail-section">
        <text class="detail-section-title">用户信息</text>
        <view class="detail-user-head">
          <text class="detail-user-name">{{detail.user.nickname || '未设置昵称'}}</text>
          <text class="detail-user-member">{{detail.user.memberExpiresAt ? '会员有效' : '非会员'}}</text>
        </view>
        <view class="detail-copy-row">
          <text class="detail-break">OpenID {{detail.user.openId}}</text>
          <view class="copy-link" catchtap="onCopyText" data-value="{{detail.user.openId}}">复制</view>
        </view>
        <text>历史名额包：{{detail.user.taskPackCount || 0}} 包</text>
        <text>历史保护额度：{{detail.user.protectedTaskQuota || 0}} 个</text>
      </view>
      <view class="detail-section">
        <text class="detail-section-title">售后信息</text>
        <text wx:if="{{detail.case.systemGenerated}}">生成方式：系统自动创建</text>
        <text wx:if="{{detail.case.cancelledAtText}}">用户取消时间：{{detail.case.cancelledAtText}}</text>
        <text wx:if="{{detail.case.cancelledBy === 'USER'}}">用户已主动取消本次售后申请，不会继续发起退款。</text>
        <text>类型：{{detail.case.typeLabel}}</text>
        <text>说明：{{detail.case.description || '未填写'}}</text>
        <text>金额：{{detail.case.amountText}}</text>
        <text wx:if="{{detail.case.outRefundNo}}">退款单号：{{detail.case.outRefundNo}}</text>
        <text wx:if="{{detail.case.refundAmountFen}}">退款金额：{{detail.case.refundAmountText}}</text>
      </view>
      <view class="detail-section">
        <text class="detail-section-title">订单与权益证据</text>
        <view class="detail-link" bindtap="onOpenRelatedOrder">查看会员订单详情</view>
        <text>优先级：{{detail.case.priorityLabel}}</text>
        <text wx:if="{{detail.order.paymentChannelLabel}}">支付渠道：{{detail.order.paymentChannelLabel}}</text>
        <text>订单状态：{{detail.order.status}} / 退款 {{detail.order.refundStatus}}</text>
        <text>权益发放：{{detail.order.grantStatus}} / {{detail.order.entitlementStatus}}</text>
        <text wx:if="{{detail.order.paymentResult.tradeState}}">最近查单：{{detail.order.paymentResult.tradeState}}，金额 {{detail.order.paymentResult.amountFen}} 分</text>
        <text>本单增加会员时长：{{detail.order.entitlementGrant.memberDaysAddedMs || 0}} ms</text>
        <text>本单增加名额包：{{detail.order.entitlementGrant.taskPackDelta || 0}}</text>
        <text>支付时间：{{detail.order.paidAt || '—'}}</text>
        <text>最近新增提醒：{{detail.user.lastReminderCreatedAt || '无'}}</text>
        <text>支付后是否使用权益：{{detail.case.evidence.eligibility.usedAfterPurchase ? '是' : '否'}}</text>
        <text>距离支付：{{detail.case.evidence.eligibility.hoursSincePaid}} 小时</text>
        <text wx:if="{{detail.case.evidence.duplicate}}">重复支付证据：{{detail.case.evidence.duplicate.duplicate ? '已发现同商品订单' : '未发现'}}</text>
      </view>
      <view wx:if="{{detail.case.failureReason}}" class="detail-section funding-detail">
        <text class="detail-section-title">退款失败原因</text>
        <text>{{detail.case.failureReason}}</text>
        <text wx:if="{{detail.case.fundingBlocked}}">处理方式：先在微信支付商户平台充值基本账户，再点击下方「重新发起退款」。</text>
        <text wx:if="{{detail.case.fundingBlockedAtText}}">阻断时间：{{detail.case.fundingBlockedAtText}}</text>
      </view>
      <view class="detail-section">
        <text class="detail-section-title">历史售后与退款</text>
        <text>累计申请 {{detail.history.stats.total}} 次；退款完成 {{detail.history.stats.refunded}} 次；驳回 {{detail.history.stats.rejected}} 次；用户取消 {{detail.history.stats.cancelled}} 次；处理中 {{detail.history.stats.active}} 次。</text>
        <text>本订单累计申请 {{detail.history.stats.sameOrder}} 次。</text>
        <view wx:for="{{detail.history.items}}" wx:key="_id" class="history-row">
          <text>{{item.createdAtText}} · {{item.typeLabel}} · {{item.statusLabel}}</text>
          <text wx:if="{{item.decisionNote}}">说明：{{item.decisionNote}}</text>
        </view>
      </view>
      <view class="detail-section">
        <text class="detail-section-title">审核操作</text>
        <textarea class="decision-input" placeholder="驳回时必须填写用户可见原因" value="{{decisionNote}}" bindinput="onDecisionInput" />
        <view wx:if="{{actionMessage}}" class="action-message">{{actionMessage}}</view>
        <view class="action-grid">
          <view wx:if="{{detail.actionCapabilities.canSyncPayment}}" class="admin-action" bindtap="onSyncPayment">同步支付结果</view>
          <view wx:if="{{detail.actionCapabilities.canRetryGrant}}" class="admin-action" bindtap="onRetryGrant">补发权益</view>
          <view wx:if="{{detail.actionCapabilities.canSyncRefund}}" class="admin-action" bindtap="onSyncRefund">同步退款结果</view>
          <view wx:if="{{detail.actionCapabilities.canApproveRefund}}" class="admin-action primary" bindtap="onApprove">{{detail.actionCapabilities.approveRefundLabel}}</view>
          <view wx:if="{{detail.actionCapabilities.canReject}}" class="admin-action danger" bindtap="onReject">驳回申请</view>
          <view wx:if="{{!detail.actionCapabilities.canSyncPayment && !detail.actionCapabilities.canRetryGrant && !detail.actionCapabilities.canSyncRefund && !detail.actionCapabilities.canApproveRefund && !detail.actionCapabilities.canReject}}" class="action-empty">当前售后单没有可执行操作</view>
        </view>
        <text class="audit-note">所有查看、同步、补发、同意、驳回和重试退款操作均写入 admin_audit_logs。</text>
      </view>
    </scroll-view>
  </view>
</view>
