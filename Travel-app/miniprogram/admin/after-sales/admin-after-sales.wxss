.navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 90; background: var(--color-page); }
.navbar-content { display: flex; align-items: center; position: relative; }
.navbar-back { position: absolute; left: 20rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.navbar-title { position: absolute; left: 50%; transform: translateX(-50%); color: var(--color-ink); font-size: 30rpx; font-weight: 600; }
.page-body { padding: 20rpx 28rpx 100rpx; }
.migration-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 18rpx; padding: 20rpx 22rpx; border: 1rpx solid #E2C896; border-radius: 17rpx; background: #FFF9EA; }
.migration-copy { display: flex; flex: 1; flex-direction: column; gap: 7rpx; }
.migration-title { color: var(--color-ink); font-size: 24rpx; font-weight: 600; }
.migration-desc, .migration-message { color: var(--color-muted); font-size: 20rpx; line-height: 1.45; }
.migration-message { color: #8A5A12; }
.migration-actions { flex-shrink: 0; display: flex; flex-direction: column; gap: 10rpx; width: 176rpx; }
.migration-action { flex-shrink: 0; padding: 14rpx 18rpx; border-radius: 13rpx; background: #B8904A; color: #FFFDF7; font-size: 21rpx; }
.migration-action.primary { background: #8A5A12; text-align: center; }
.migration-action.secondary { border: 1rpx solid #D7BD8E; background: transparent; color: #8A5A12; text-align: center; }
.migration-action.disabled { opacity: .55; }
.funding-alert { display: flex; align-items: center; gap: 18rpx; margin-bottom: 18rpx; padding: 20rpx 22rpx; border: 1rpx solid #D8A08E; border-radius: 17rpx; background: #FFF1EC; }
.funding-alert-copy { display: flex; flex: 1; flex-direction: column; gap: 7rpx; }
.funding-alert-title { color: #A7462B; font-size: 24rpx; font-weight: 600; }
.funding-alert-desc { color: #8F4B37; font-size: 20rpx; line-height: 1.45; }
.funding-alert-action { flex-shrink: 0; padding: 13rpx 18rpx; border-radius: 13rpx; background: #A7462B; color: #FFFDF7; font-size: 21rpx; }
.top-dashboard { display: grid; grid-template-columns: minmax(0, 40fr) minmax(0, 60fr); align-items: stretch; gap: 12rpx; margin-bottom: 18rpx; }
.dashboard-control-stack { display: flex; flex-direction: column; min-width: 0; min-height: 236rpx; gap: 12rpx; }
.admin-control-card { display: flex; align-items: center; min-width: 0; gap: 14rpx; padding: 16rpx; border: 1rpx solid var(--color-border); border-radius: 17rpx; background: var(--color-surface); box-sizing: border-box; }
.dashboard-control-stack .admin-control-card { flex: 1 1 0; min-height: 104rpx; padding: 14rpx 16rpx; }
.quality-card { height: 100%; min-height: 0; flex-direction: column; align-items: stretch; justify-content: space-between; gap: 8rpx; padding: 18rpx; overflow: hidden; }
.quality-card.tone-alert { border-color: #D8A08E; background: #FFF1EC; }
.quality-head { display: flex; align-items: center; justify-content: space-between; min-width: 0; gap: 8rpx; }
.quality-title { color: var(--color-ink); font-size: 24rpx; font-weight: 600; }
.quality-status { flex-shrink: 0; padding: 3rpx 9rpx; border-radius: 999rpx; background: #F1F0ED; color: #77736B; font-size: 18rpx; font-weight: 600; }
.quality-card.tone-healthy .quality-status { background: #EAF6EE; color: #2D6B42; }
.quality-card.tone-alert .quality-status { background: #F7DED5; color: #A7462B; }
.quality-primary { display: flex; align-items: stretch; min-width: 0; flex-direction: column; gap: 4rpx; }
.quality-rate { flex-shrink: 0; color: var(--color-ink); font-size: 40rpx; font-weight: 700; line-height: 1; }
.quality-card.tone-alert .quality-rate { color: #A7462B; }
.quality-primary-copy { width: 100%; min-width: 0; }
.quality-caption-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8rpx; min-width: 0; }
.quality-caption { flex-shrink: 0; color: var(--color-text); font-size: 18rpx; font-weight: 600; line-height: 1.2; }
.quality-sample { min-width: 0; overflow: hidden; color: var(--color-muted); font-size: 18rpx; line-height: 1.2; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.quality-baseline { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding-top: 7rpx; border-top: 1rpx solid var(--color-border); }
.quality-baseline-label { color: var(--color-muted); font-size: 20rpx; }
.quality-baseline-value { color: var(--color-ink); font-size: 25rpx; font-weight: 700; }
.quality-foot { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: auto; padding-top: 2rpx; }
.quality-issue { min-width: 0; color: var(--color-muted); font-size: 16rpx; line-height: 1.25; }
.quality-card.tone-alert .quality-issue { color: #A7462B; font-weight: 600; }
.quality-retry { flex-shrink: 0; color: #A7462B; font-size: 18rpx; font-weight: 600; }
.sales-card.paused { border-color: #D8A08E; background: #FFF1EC; }
.sales-main { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; }
.sales-title-row { display: flex; align-items: center; gap: 10rpx; }
.sales-title { color: var(--color-ink); font-size: 21rpx; font-weight: 600; }
.sales-desc, .sales-reason, .sales-warning { color: var(--color-muted); font-size: 18rpx; line-height: 1.4; word-break: break-word; }
.sales-reason { color: #8F4B37; }
.sales-warning { color: #A7462B; font-weight: 600; }
.sales-status { flex-shrink: 0; padding: 3rpx 9rpx; border-radius: 999rpx; background: #EAF6EE; color: #2D6B42; font-size: 16rpx; font-weight: 600; }
.sales-status.paused { background: #F7DED5; color: #A7462B; }
.sales-action { flex-shrink: 0; width: 88rpx; min-height: 54rpx; border-radius: 11rpx; background: #B8904A; color: #FFFDF7; font-size: 19rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.sales-card.paused .sales-action { background: #8A5A12; }
.sales-action.disabled { opacity: .55; }
.enforcement-main { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; }
.enforcement-title-row { display: flex; align-items: center; min-width: 0; gap: 9rpx; }
.enforcement-title { color: var(--color-ink); font-size: 21rpx; font-weight: 600; }
.enforcement-source { min-width: 0; overflow: hidden; color: var(--color-muted); font-size: 16rpx; text-overflow: ellipsis; white-space: nowrap; }
.enforcement-desc { display: block; color: var(--color-muted); font-size: 18rpx; line-height: 1.4; word-break: break-word; }
.enforcement-desc.warning { color: #A7462B; }
.enforcement-picker { flex-shrink: 0; }
.enforcement-select { width: 112rpx; height: 54rpx; padding: 0 9rpx; border: 1rpx solid #D8CBB3; border-radius: 11rpx; box-sizing: border-box; background: #F7F2E8; color: var(--color-text); display: flex; align-items: center; justify-content: space-between; gap: 5rpx; }
.enforcement-select.disabled { opacity: .55; }
.enforcement-select-value { min-width: 0; overflow: hidden; font-size: 18rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.pricing-card { margin-bottom: 18rpx; padding: 18rpx 20rpx; }
.upgrade-notice-card { margin-bottom: 18rpx; padding: 18rpx 20rpx; }
.upgrade-notice-card.active { border-color: #E2C896; background: #FFF9EA; }
.upgrade-notice-card.active .upgrade-notice-status { background: #F7ECD4; color: #8A5A12; }
.upgrade-notice-status.upgrade-inactive { background: #F1F0ED; color: #77736B; }
.upgrade-notice-time { min-width: 0; overflow: hidden; color: var(--color-muted); font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.upgrade-notice-action { width: 112rpx; }
.sales-confirm-mask { position: fixed; inset: 0; z-index: 320; display: flex; align-items: flex-end; background: rgba(34,25,19,.5); }
.sales-confirm-sheet { width: 100%; padding: 26rpx 30rpx calc(22rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; box-sizing: border-box; background: #FFFDF8; }
.sales-confirm-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.sales-confirm-title { color: var(--color-ink); font-size: 29rpx; font-weight: 700; }
.sales-confirm-close { color: var(--color-muted); font-size: 42rpx; line-height: 1; }
.sales-confirm-desc { display: block; color: var(--color-muted); font-size: 21rpx; line-height: 1.6; }
.sales-confirm-input { width: 100%; min-height: 150rpx; margin-top: 18rpx; padding: 16rpx 18rpx; border: 1rpx solid var(--color-border); border-radius: 14rpx; box-sizing: border-box; background: var(--color-page); color: var(--color-text); font-size: 22rpx; }
.sales-confirm-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 18rpx; }
.sales-confirm-btn { min-height: 76rpx; border-radius: 14rpx; font-size: 24rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.sales-confirm-btn.cancel { border: 1rpx solid var(--color-border); background: var(--color-surface); color: var(--color-text); }
.sales-confirm-btn.primary { background: #A7462B; color: #FFFDF7; }
.sales-confirm-btn.disabled { opacity: .55; }
.workspace-tabs { display: grid; grid-template-columns: 1fr 1fr; margin: 8rpx 0 18rpx; border-bottom: 1rpx solid var(--color-border); }
.workspace-tab { position: relative; min-height: 72rpx; color: var(--color-muted); font-size: 24rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.workspace-tab.active { color: var(--color-ink); }
.workspace-tab.active::after { position: absolute; right: 28%; bottom: -1rpx; left: 28%; height: 4rpx; border-radius: 999rpx; background: #B8904A; content: ''; }
.tab-count { min-width: 30rpx; height: 30rpx; padding: 0 8rpx; border-radius: 999rpx; box-sizing: border-box; background: #A7462B; color: #FFFDF7; font-size: 17rpx; line-height: 30rpx; text-align: center; }
.order-stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-bottom: 10rpx; padding: 14rpx 8rpx; border: 1rpx solid var(--color-border); border-radius: 14rpx; background: var(--color-surface); }
.order-stat { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.order-stat:nth-child(2), .order-stat:nth-child(3), .order-stat:nth-child(4) { border-left: 1rpx solid var(--color-border); }
.order-stat-value { max-width: 100%; overflow: hidden; color: var(--color-ink); font-size: 29rpx; font-weight: 700; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
.order-stat-value.amount { color: #8A5A12; }
.order-stat-label { color: var(--color-muted); font-size: 18rpx; line-height: 1.3; white-space: nowrap; }
.order-stats-note { margin-bottom: 12rpx; color: var(--color-muted); font-size: 18rpx; line-height: 1.4; text-align: center; }
.order-stats-note.action { color: #8A5A12; font-weight: 600; }
.filter-sticky { position: sticky; z-index: 50; padding-top: 2rpx; background: var(--color-page); box-shadow: 0 8rpx 18rpx rgba(66,52,36,.05); }
.admin-search { display: flex; align-items: center; gap: 14rpx; min-height: 72rpx; padding: 0 14rpx 0 20rpx; border: 1rpx solid var(--color-border); border-radius: 14rpx; box-sizing: border-box; background: var(--color-surface); }
.admin-search-input { flex: 1; min-width: 0; height: 70rpx; color: var(--color-text); font-size: 22rpx; }
.admin-search-clear { flex-shrink: 0; width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; }
.admin-search-submit { flex-shrink: 0; padding: 12rpx 8rpx 12rpx 14rpx; border-left: 1rpx solid var(--color-border); color: #8A5A12; font-size: 22rpx; font-weight: 600; }
.filter-toolbar { display: flex; align-items: center; gap: 12rpx; padding-top: 12rpx; }
.filter-scroll { flex: 1; min-width: 0; width: auto; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 12rpx; padding: 2rpx 2rpx 12rpx; }
.filter-chip { padding: 12rpx 20rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: var(--color-surface); color: var(--color-muted); font-size: 21rpx; }
.filter-chip.active { border-color: #B8904A; background: #B8904A; color: #FFFDF7; }
.order-time-picker { flex-shrink: 0; margin-bottom: 10rpx; }
.order-time-select { width: 148rpx; height: 58rpx; padding: 0 12rpx; border: 1rpx solid #D8CBB3; border-radius: 11rpx; box-sizing: border-box; background: #F7F2E8; color: var(--color-text); display: flex; align-items: center; justify-content: space-between; gap: 6rpx; }
.order-time-value { min-width: 0; overflow: hidden; font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }
.state-box { display: flex; flex-direction: column; align-items: center; gap: 15rpx; padding: 110rpx 30rpx; text-align: center; }
.state-title { color: var(--color-ink); font-size: 26rpx; font-weight: 600; }
.state-desc { color: var(--color-muted); font-size: 21rpx; line-height: 1.55; }
.retry-btn { padding: 15rpx 28rpx; border-radius: 14rpx; background: var(--color-cream); color: var(--color-text); font-size: 23rpx; }
.order-list { display: flex; flex-direction: column; gap: 14rpx; }
.order-card { display: flex; flex-direction: column; gap: 9rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-surface); box-shadow: var(--shadow-card); }
.order-card-head, .order-user-line, .openid-row, .order-foot { display: flex; align-items: center; }
.order-card-head { justify-content: space-between; gap: 18rpx; }
.order-user-line { min-width: 0; gap: 10rpx; }
.order-nickname { max-width: 360rpx; overflow: hidden; color: var(--color-ink); font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.order-status { flex-shrink: 0; padding: 4rpx 10rpx; border-radius: 999rpx; background: #F1F0ED; color: #77736B; font-size: 18rpx; font-weight: 600; }
.order-status.tone-pending { background: #FFF5DD; color: #8A5A12; }
.order-status.tone-paid { background: #EAF6EE; color: #2D6B42; }
.order-status.tone-closed { background: #F1F0ED; color: #77736B; }
.order-amount { flex-shrink: 0; color: var(--color-primary); font-size: 27rpx; font-weight: 700; }
.openid-row { gap: 12rpx; }
.openid-value { flex: 1; min-width: 0; color: var(--color-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 18rpx; line-height: 1.4; word-break: break-all; }
.copy-link { flex-shrink: 0; padding: 3rpx 0 3rpx 10rpx; color: #8A5A12; font-size: 19rpx; font-weight: 600; }
.order-title { color: var(--color-text); font-size: 22rpx; font-weight: 600; }
.order-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.meta-tag { padding: 4rpx 10rpx; border-radius: 7rpx; background: var(--color-cream); color: var(--color-muted); font-size: 18rpx; }
.meta-tag.warning { background: #FFF1EC; color: #A7462B; }
.meta-tag.case { background: #EEF4FF; color: #396BAF; }
.meta-tag.case.reviewing { background: #FFF1EC; color: #A7462B; font-weight: 600; }
.order-foot { justify-content: space-between; gap: 18rpx; padding-top: 8rpx; border-top: 1rpx solid var(--color-border); color: var(--color-muted); font-size: 18rpx; }
.order-foot text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.load-more { min-height: 76rpx; margin-top: 18rpx; border: 1rpx solid var(--color-border); border-radius: 14rpx; background: var(--color-surface); color: var(--color-text); font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.load-more.disabled { opacity: .55; }
.case-list { display: flex; flex-direction: column; gap: 14rpx; }
.case-card { display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--color-border); border-radius: 17rpx; background: var(--color-surface); box-shadow: var(--shadow-card); }
.case-head { display: flex; justify-content: space-between; gap: 18rpx; }
.case-head-right { display: flex; align-items: center; gap: 12rpx; }
.case-no { color: var(--color-muted); font-size: 20rpx; }
.case-auto { padding: 3rpx 9rpx; border-radius: 7rpx; background: #EEF4FF; color: #396BAF; font-size: 18rpx; }
.case-funding { padding: 3rpx 9rpx; border-radius: 7rpx; background: #FFF1EC; color: #A7462B; font-size: 18rpx; font-weight: 600; }
.case-status { color: #8A5A12; font-size: 21rpx; font-weight: 600; }
.case-status.reviewing { color: #A7462B; }
.case-status.cancelled { color: #77736B; }
.case-user-row { display: flex; align-items: center; gap: 10rpx; padding: 8rpx 10rpx; border-radius: 9rpx; background: var(--color-page); }
.case-user-name { flex-shrink: 0; max-width: 180rpx; overflow: hidden; color: var(--color-text); font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.case-openid { flex: 1; min-width: 0; color: var(--color-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 17rpx; word-break: break-all; }
.case-title { color: var(--color-ink); font-size: 25rpx; font-weight: 600; }
.case-meta { color: var(--color-muted); font-size: 20rpx; }
.case-amount { color: var(--color-primary); font-size: 26rpx; font-weight: 700; }
.detail-mask { position: fixed; inset: 0; z-index: 250; display: flex; align-items: flex-end; background: rgba(34,25,19,.5); }
.detail-sheet { width: 100%; max-height: 88vh; padding: 26rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #FFFDF8; box-sizing: border-box; }
.detail-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.detail-title { color: var(--color-ink); font-size: 27rpx; font-weight: 700; }
.detail-close { color: var(--color-muted); font-size: 42rpx; line-height: 1; }
.detail-scroll { max-height: 72vh; }
.detail-status { display: inline-block; padding: 5rpx 14rpx; border-radius: 999rpx; background: #FFF5DD; color: #8A5A12; font-size: 21rpx; }
.detail-status.cancelled { background: #F1F0ED; color: #77736B; }
.detail-section { display: flex; flex-direction: column; gap: 8rpx; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid var(--color-border); border-radius: 15rpx; color: var(--color-muted); font-size: 21rpx; line-height: 1.55; word-break: break-all; }
.detail-section-title { color: var(--color-ink); font-size: 24rpx; font-weight: 600; }
.detail-section.funding-detail { border-color: #D8A08E; background: #FFF1EC; color: #8F4B37; }
.detail-user-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.detail-user-name { color: var(--color-ink); font-size: 24rpx; font-weight: 700; }
.detail-user-member { flex-shrink: 0; padding: 4rpx 10rpx; border-radius: 999rpx; background: #F1F0ED; color: #77736B; font-size: 18rpx; }
.detail-user-member.active { background: #FFF5DD; color: #8A5A12; }
.detail-copy-row { display: flex; align-items: flex-start; gap: 12rpx; }
.detail-break { flex: 1; min-width: 0; word-break: break-all; }
.detail-link { align-self: flex-start; padding: 8rpx 0; color: #8A5A12; font-size: 21rpx; font-weight: 600; }
.entitlement-snapshot, .related-case-list { display: flex; flex-direction: column; gap: 8rpx; }
.entitlement-snapshot { padding-top: 8rpx; border-top: 1rpx solid var(--color-border); }
.related-case-row { display: flex; flex-direction: column; gap: 5rpx; padding: 12rpx 0; border-top: 1rpx solid var(--color-border); }
.related-case-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; color: var(--color-ink); font-weight: 600; }
.decision-input { width: 100%; min-height: 130rpx; padding: 16rpx 18rpx; border: 1rpx solid var(--color-border); border-radius: 13rpx; box-sizing: border-box; background: var(--color-page); color: var(--color-text); font-size: 22rpx; }
.action-message { padding: 14rpx 16rpx; border-radius: 12rpx; background: var(--color-cream); color: var(--color-text); font-size: 21rpx; }
.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 8rpx; }
.admin-action { min-height: 70rpx; padding: 10rpx; border: 1rpx solid var(--color-border); border-radius: 13rpx; background: var(--color-surface); color: var(--color-text); font-size: 21rpx; display: flex; align-items: center; justify-content: center; text-align: center; }
.admin-action.primary { border-color: var(--color-primary); background: var(--color-primary); color: #FFFEFB; }
.admin-action.danger { border-color: #D8A08E; color: #A7462B; }
.history-row { display: flex; flex-direction: column; gap: 4rpx; padding: 10rpx 0; border-top: 1rpx solid var(--color-border); }
.action-empty { grid-column: 1 / 3; color: var(--color-muted); font-size: 21rpx; text-align: center; }
.audit-note { color: var(--color-muted); font-size: 19rpx; }

@media (max-width: 340px) {
  .top-dashboard, .dashboard-control-stack { gap: 10rpx; }
  .dashboard-control-stack { min-height: 226rpx; }
  .dashboard-control-stack .admin-control-card { min-height: 104rpx; gap: 10rpx; padding: 12rpx; }
  .quality-card { padding: 14rpx; }
  .quality-rate { font-size: 36rpx; }
  .quality-primary { gap: 3rpx; }
  .quality-caption { font-size: 17rpx; }
  .quality-sample { font-size: 16rpx; }
  .quality-baseline-label { font-size: 18rpx; }
  .quality-baseline-value { font-size: 22rpx; }
  .sales-action { width: 80rpx; }
  .enforcement-select { width: 112rpx; padding: 0 6rpx; }
  .enforcement-select-value { font-size: 17rpx; }
  .upgrade-notice-card { gap: 10rpx; padding: 16rpx; }
  .upgrade-notice-action { width: 104rpx; }
}
