<view wx:if="{{show}}" class="sample-mask" bindtap="onClose">
  <view class="sample-sheet" catchtap="noop">
    <view class="sample-head">
      <text class="sample-title">提醒样式示例</text>
      <view class="sample-close" bindtap="onClose"><svg-icon name="close" size="16px" /></view>
    </view>
    <text class="sample-note">示意图，实际样式以手机系统和微信版本为准。</text>
    <scroll-view scroll-x class="sample-scroll">
      <view class="sample-list">
        <view class="sample-item" wx:for="{{sampleShots}}" wx:key="key">
          <text class="sample-label">{{item.label}}</text>
          <image
            wx:if="{{item.src}}"
            class="sample-img"
            src="{{item.src}}"
            mode="widthFix"
            bindtap="onPreview"
            data-src="{{item.src}}"
          />
          <view wx:else class="sample-placeholder">
            <text>示例图待补充</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
