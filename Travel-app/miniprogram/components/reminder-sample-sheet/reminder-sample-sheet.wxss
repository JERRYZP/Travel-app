.sample-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 260;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.5);
}
.sample-sheet {
  width: 100%;
  padding: 28rpx 0 calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #FFFEFB;
}
.sample-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}
.sample-title { font-size: 30rpx; font-weight: 600; color: var(--color-ink); }
.sample-close {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sample-note {
  display: block;
  padding: 14rpx 30rpx 20rpx;
  color: #B59E80;
  font-size: 22rpx;
}
.sample-scroll { white-space: nowrap; }
.sample-list { display: inline-flex; gap: 18rpx; padding: 0 30rpx; }
.sample-item {
  width: 468rpx;
  display: inline-flex;
  flex-direction: column;
  gap: 12rpx;
  vertical-align: top;
}
.sample-label { font-size: 23rpx; color: #5E3D32; }
.sample-img {
  /* widthFix 已按原图比例算高度；不要再用 max-height 约束，否则图片会被压扁。 */
  width: 468rpx;
  border-radius: 20rpx;
  background: #F3EEE3;
}
.sample-placeholder {
  width: 468rpx;
  height: 648rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  border: 1rpx dashed #E2D5C4;
  background: #F8F3EA;
  color: #B59E80;
  font-size: 24rpx;
}
