<view
  wx:if="{{visible}}"
  class="fc-root {{expanded ? 'is-expanded' : 'is-docked'}} {{dragging ? 'is-dragging' : ''}} phase-{{phase}} dock-{{dockedSide}} {{isDemo ? 'is-demo' : ''}}"
  style="{{rootStyle}}"
  bindtouchstart="onTouchStart"
  catchtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchCancel"
  bindtap="onRootTap"
>
  <view wx:if="{{expanded}}" class="fc-card">
    <view class="fc-topline">
      <view class="fc-live"><view class="fc-dot"></view><text>北京抢票时间</text></view>
      <view class="fc-collapse" bindtap="onClose" aria-role="button" aria-label="收起悬浮时钟"><svg-icon name="chevron-up" size="12px" /><text>收起</text></view>
    </view>
    <view class="fc-clock"><text>{{clockMain}}</text><text class="fc-millis">{{clockMillis}}</text></view>
    <view class="fc-release">
      <view class="fc-release-main">
        <view class="fc-status-wrap">
          <svg-icon name="clock-gold" size="12px" />
          <block wx:if="{{phase === 'before'}}">
            <text class="fc-status-prefix">距 </text>
            <view class="fc-spot-hit" bindtap="onSpotTap" aria-role="button" aria-label="查看景点详情"><text class="fc-spot-link">{{spotName}}</text></view>
            <text class="fc-status-prefix"> 开抢</text>
          </block>
          <block wx:else>
            <text class="fc-status-prefix">开抢中 </text>
            <view class="fc-spot-hit" bindtap="onSpotTap" aria-role="button" aria-label="查看景点详情"><text class="fc-spot-link">{{spotName}} ></text></view>
          </block>
        </view>
        <view class="fc-countdown-wrap">
          <text class="fc-countdown {{phase === 'after' ? 'is-live' : ''}}">{{countdownText}}</text>
          <text wx:if="{{openedElapsedText}}" class="fc-elapsed">{{openedElapsedText}}</text>
        </view>
      </view>
      <view class="fc-meta">
        <text>{{releaseTime}} 放票</text>
        <text wx:if="{{extraCount > 0}}" class="fc-same-time">{{sameTimeText}}</text>
        <text class="fc-sync">{{timeLabel}}</text>
      </view>
    </view>
    <view wx:if="{{isDemo}}" class="fc-demo-footer">
      <text class="fc-demo-badge">示例</text>
      <view class="fc-demo-close" bindtap="onCloseDemo" aria-role="button">关闭演示</view>
    </view>
  </view>

  <view wx:else class="fc-edge" bindtap="onOpen" aria-role="button" aria-label="展开悬浮时钟">
    <svg-icon name="clock-gold" size="16px" />
    <view class="fc-edge-spot">
      <text wx:for="{{dockedSpotChars}}" wx:key="key">{{item.text}}</text>
    </view>
    <text wx:if="{{extraCount > 0}}" class="fc-edge-more">+{{extraCount}}</text>
    <view class="fc-edge-title"><text>抢</text><text>票</text></view>
    <view class="fc-edge-time {{phase === 'after' ? 'is-live' : ''}}">
      <text class="fc-edge-number">{{dockedCountdownNumber}}</text>
      <view wx:if="{{phase === 'after'}}" class="fc-edge-elapsed">
        <text class="fc-edge-elapsed-number">{{dockedElapsedNumber}}</text>
        <text class="fc-edge-elapsed-unit">{{dockedCountdownUnit}}</text>
      </view>
      <text wx:else class="fc-edge-unit">{{dockedCountdownUnit}}</text>
    </view>
  </view>
</view>
