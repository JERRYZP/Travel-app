/* 景点 Tab 卡片：图片顶部承载难度/票务信息，名称行右侧直接给出提醒入口。 */
.spot-card {
  width: 337rpx;
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 16rpx;
  position: relative;
  box-sizing: border-box;
}
.spot-card-img-wrap {
  position: relative;
  margin-bottom: 12rpx;
}
.spot-card-img {
  width: 100%;
  height: 127rpx;
  border-radius: 12rpx;
  display: block;
  background: linear-gradient(135deg, #EDE0C8, #DBCDBB);
}
.spot-card-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.spot-card-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.spot-card-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
  text-decoration: underline;
}
.spot-card-diff {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
  line-height: 1.35;
  width: fit-content;
  box-shadow: 0 2rpx 8rpx rgba(100, 60, 20, 0.14);
}
.diff-EXTREME { background: var(--diff-extreme-bg); color: var(--diff-extreme-text); }
.diff-NORMAL { background: var(--diff-normal-bg); color: var(--diff-normal-text); }
.diff-EASY { background: var(--diff-easy-bg); color: var(--diff-easy-text); }
.spot-card-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.spot-card-tag {
  font-size: 20rpx;
  color: var(--color-muted);
}
.card-desc { line-height: 1.5; }

/* 名称行右侧的纯文字提醒入口：不使用标签底色，橙色文字 + 右箭头。 */
.spot-card-remind {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--diff-normal-text);
  font-size: 22rpx;
  line-height: 1.2;
}
.spot-card-remind-arrow {
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid var(--diff-normal-text);
  border-right: 2rpx solid var(--diff-normal-text);
  transform: rotate(45deg);
  box-sizing: border-box;
}

/* B 层免预约 / 无固定放票时刻：信息 tag 与难度共用图片右上角位置。 */
.spot-card-nobook {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 8rpx rgba(100, 60, 20, 0.14);
}
