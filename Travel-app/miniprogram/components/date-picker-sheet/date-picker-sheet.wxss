.dp-mask {
  position: fixed; inset: 0; z-index: 250;
  background: rgba(40,30,18,.45);
  display: flex; align-items: flex-end;
}
.dp-sheet {
  width: 100%;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: dp-up .24s cubic-bezier(.22,1,.36,1);
}
@keyframes dp-up { from { transform: translateY(100%); } to { transform: none; } }

.dp-title {
  text-align: center;
  font-size: 32rpx; font-weight: 600; color: var(--color-ink);
  margin-bottom: 32rpx;
}

/* 月份标题：**只剩指示作用**（翻页改成上下滑动日历本身）。
   原来是左右两个箭头夹着标题，箭头已随 2026-09-24 的改版删除。 */
.dp-month-bar {
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
}
.dp-month-label {
  font-size: 32rpx; font-weight: 600; color: var(--color-ink);
}

/* 星期头 */
.dp-weekdays {
  display: flex;
  padding-bottom: 16rpx;
}
.dp-weekday {
  flex: 1; text-align: center;
  font-size: 24rpx; color: #8B7355;
}

/* 日历：纵向 swiper，item 内是一个整月网格。
   高度由 JS 下发的 `gridHeight`（6 行 × 88rpx）以内联 style 给，
   各月行数不一时才不会整体跳动。 */
.dp-swiper {
  width: 100%;
}
.dp-grid {
  display: flex; flex-wrap: wrap;
  align-content: flex-start;
}
.dp-cell {
  width: calc(100% / 7);
  height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
  position: relative;
}
.dp-day-inner {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--color-ink);
  position: relative; z-index: 1;
}
.dp-cell.other-month .dp-day-inner {
  color: #C4B5A0;
}
.dp-cell.is-disabled .dp-day-inner {
  color: #C4B5A0;
}

/* 已有行程浅色条带 */
.dp-cell.in-trip::before {
  content: '';
  position: absolute; left: 0; right: 0; top: 50%;
  transform: translateY(-50%);
  height: 64rpx;
  background: #F0E2C4;
}
.dp-cell.in-trip.trip-start::before {
  left: 50%;
  border-radius: 32rpx 0 0 32rpx;
}
.dp-cell.in-trip.trip-end::before {
  right: 50%;
  border-radius: 0 32rpx 32rpx 0;
}
.dp-cell.in-trip.trip-start.trip-end::before {
  left: 0; right: 0;
  border-radius: 32rpx;
}

/* 选中态 */
.dp-cell.is-selected .dp-day-inner {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

/* 底部按钮 */
.dp-acts {
  display: flex; gap: 20rpx; margin-top: 32rpx;
}
.dp-confirm {
  flex: 1;
  text-align: center;
  background: var(--color-primary);
  color: #FDF6EE;
  border-radius: 40rpx;
  padding: 24rpx 0;
  font-size: 30rpx; font-weight: 600;
}
.dp-confirm.disabled {
  background: var(--color-placeholder);
}
.dp-cancel {
  flex: 0 0 200rpx;
  text-align: center;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 40rpx;
  padding: 24rpx 0;
  font-size: 30rpx; color: var(--color-text);
}
