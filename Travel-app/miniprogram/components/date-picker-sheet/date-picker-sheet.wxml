<view wx:if="{{show}}" class="dp-mask" bindtap="onClose" catchtouchmove="noop">
  <view class="dp-sheet" catchtap="noop">
    <view class="dp-title">{{spotName}}·{{title}}</view>

    <!-- 月份标题：**只做指示，不再承担翻页**（翻页改成上下滑动日历本身）。
         它跟着滑动实时更新，所以用户滑到哪个月看一眼标题就知道。 -->
    <view class="dp-month-bar">
      <text class="dp-month-label">{{monthLabel}}</text>
    </view>

    <!-- 星期头 -->
    <view class="dp-weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this" class="dp-weekday">{{item}}</text>
    </view>

    <!-- 日历：**纵向 swiper 切月**（2026-09-24 由左右点箭头改版而来）。
         每个 swiper-item 是一个整月网格，上下滑动翻页。
         ⚠️ `previous-margin`/`next-margin` 都不用：上下相邻月份露边会让人以为
            可以横向滑。这里要的是「一屏一个月、上下拨动」的干脆手感。
         ⚠️ 高度写死（gridHeight）：各月行数 4~6 不等，不固定的话滑过去会整体跳动。 -->
    <swiper
      class="dp-swiper"
      style="height: {{gridHeight}}rpx;"
      vertical="{{true}}"
      circular="{{false}}"
      current="{{monthIndex}}"
      bindchange="onMonthSwipe"
    >
      <swiper-item wx:for="{{months}}" wx:key="key" wx:for-item="month">
        <view class="dp-grid" style="min-height: {{gridHeight}}rpx;">
          <view
            wx:for="{{month.days}}"
            wx:key="index"
            class="dp-cell {{item.cellClass}} {{item.disabled ? 'is-disabled' : ''}} {{item.inTrip ? 'in-trip ' + item.tripEdge : ''}} {{item.date && item.date === choice ? 'is-selected' : ''}}"
            bindtap="onDayTap"
            data-date="{{item.date}}"
            data-disabled="{{item.disabled}}"
          >
            <view class="dp-day-inner">{{item.day}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 底部按钮 -->
    <view class="dp-acts">
      <view class="dp-confirm {{choice ? '' : 'disabled'}}" bindtap="onConfirm">确定</view>
      <view class="dp-cancel" bindtap="onClose">取消</view>
    </view>
  </view>
</view>
