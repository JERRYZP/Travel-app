.snackbar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  /* 抬到底部导航之上，避免被 tabbar 压住 */
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  /* ⚠️ 2026-09-22 按设计稿由**深色底改成纸感金底**。整条反过来后，
     文字色 / 撤销色 / 进度条色三个都要跟着重配——只换底色会让白字直接看不见。 */
  background: var(--snackbar-paper);
  color: var(--color-text);
  border-radius: 24rpx;
  padding: 24rpx 32rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 300;
  box-shadow: 0 6rpx 20rpx rgba(100,60,20,.16);
  overflow: hidden;
  animation: sb-in .22s cubic-bezier(.22,1,.36,1);
}
@keyframes sb-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: none; }
}
.sb-text { flex: 1; min-width: 0; font-size: 25rpx; }
/* 结果高亮：抢到了 → 绿、没抢到 → 朱砂。与卡片上的票务 chip 同色，
   让「刚标记的结果」和「卡上现在的状态」看起来是同一件事。 */
.sb-hl { font-weight: 600; }
.sb-hl-success { color: var(--chip-green-text); }
.sb-hl-failed { color: var(--chip-red-text); }
.sb-undo {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  padding: 4rpx 8rpx;
}
.sb-undo:active { opacity: .7; }
/* 底部进度条：把剩余时间画出来 */
.sb-bar {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 4rpx;
  background: rgba(100,60,20,.10);
}
.sb-bar-fill { height: 100%; background: var(--color-primary); opacity: .55; transition: width .05s linear; }
