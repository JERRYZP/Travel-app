.pcs-mask {
  position: fixed;
  inset: 0;
  z-index: 340;
  display: flex;
  align-items: flex-end;
  background: rgba(34, 25, 19, .46);
}

.pcs-sheet {
  width: 100%;
  padding: 30rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #FFFDF8;
  box-sizing: border-box;
  animation: pcs-up .24s cubic-bezier(.22, 1, .36, 1);
}

@keyframes pcs-up {
  from { transform: translateY(100%); }
  to { transform: none; }
}

.pcs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.pcs-title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.pcs-close {
  color: var(--color-muted);
  font-size: 42rpx;
  line-height: 1;
  padding: 0 8rpx;
}

.pcs-close.disabled {
  opacity: .35;
}

.pcs-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 13rpx 0;
  color: var(--color-text);
  font-size: 24rpx;
}

.pcs-row text:last-child {
  max-width: 72%;
  text-align: right;
}

.pcs-amount {
  color: var(--color-primary);
  font-weight: 700;
}

.pcs-rule {
  display: flex;
  flex-direction: column;
  gap: 9rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: var(--color-cream);
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.pcs-hint {
  display: block;
  margin-top: 14rpx;
  color: #8F4B37;
  font-size: 21rpx;
  line-height: 1.6;
}

.pcs-feedback {
  display: block;
  margin-top: 16rpx;
  color: #B05C3C;
  font-size: 22rpx;
  line-height: 1.55;
}

.pcs-legal {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.65;
}

.pcs-consent {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pcs-consent-choice {
  display: flex;
  align-items: flex-start;
  flex-shrink: 0;
  gap: 12rpx;
  min-height: 44rpx;
}

.pcs-consent-choice.disabled {
  opacity: .55;
}

.pcs-checkbox {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  margin-top: 2rpx;
  border: 2rpx solid #B9AA97;
  border-radius: 6rpx;
  background: #FFFDF8;
  box-sizing: border-box;
}

.pcs-checkbox.checked {
  border-color: #8A642C;
  background: #8A642C;
}

.pcs-checkbox.checked::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 4rpx;
  width: 7rpx;
  height: 14rpx;
  border-right: 3rpx solid #FFFDF8;
  border-bottom: 3rpx solid #FFFDF8;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.pcs-legal-links {
  flex: 1;
  min-width: 200rpx;
}

.pcs-legal-link {
  padding: 4rpx 0;
  color: #8A642C;
  text-decoration: underline;
}

.pcs-pay-btn {
  height: 82rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: #FFFEFB;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pcs-pay-btn.disabled {
  background: var(--color-placeholder);
}
