.rs-mask {
  position: fixed; inset: 0; z-index: 250;
  background: rgba(40,30,18,.45);
  display: flex; align-items: flex-end;
}
.rs-sheet {
  width: 100%;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: rs-up .24s cubic-bezier(.22,1,.36,1);
}
@keyframes rs-up { from { transform: translateY(100%); } to { transform: none; } }

.rs-head { margin-bottom: 24rpx; }
.rs-title { font-size: 32rpx; font-weight: 700; color: var(--color-ink); display: block; }
.rs-sub { font-size: 24rpx; color: var(--color-muted); margin-top: 4rpx; display: block; }

.rs-opts { display: flex; gap: 16rpx; }
.rs-opt {
  flex: 1;
  display: flex; align-items: center; gap: 12rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 18rpx;
  font-size: 27rpx;
  color: var(--color-text);
}
.rs-opt.active { border-color: var(--color-primary); background: rgba(192,71,42,.06); color: var(--color-ink); }
.rs-radio {
  width: 26rpx; height: 26rpx; border-radius: 13rpx;
  border: 2rpx solid var(--color-placeholder);
  flex-shrink: 0;
}
.rs-radio.on { border-color: var(--color-primary); background: var(--color-primary); }

.rs-acts { display: flex; gap: 16rpx; margin-top: 32rpx; align-items: center; }
.rs-confirm {
  flex: 1; text-align: center;
  background: var(--color-primary); color: #FDF6EE;
  border-radius: 18rpx; padding: 22rpx 0;
  font-size: 28rpx; font-weight: 600;
}
.rs-confirm.disabled { background: var(--color-placeholder); }
.rs-skip { flex: 0 0 auto; padding: 22rpx 24rpx; font-size: 26rpx; color: var(--color-muted); }
