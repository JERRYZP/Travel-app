.tss-mask {
  position: fixed;
  inset: 0;
  z-index: 260;
  display: flex;
  align-items: flex-end;
  background: rgba(40, 30, 18, .45);
}
.tss-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--color-surface);
  animation: tss-up .22s cubic-bezier(.22,1,.36,1);
}
@keyframes tss-up {
  from { transform: translateY(100%); }
  to { transform: none; }
}
.tss-handle {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #E6D8C2;
}
.tss-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tss-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink);
}
.tss-close {
  width: 56rpx;
  height: 56rpx;
  margin: -8rpx -8rpx -8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: .55;
}
.tss-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--color-text);
}
.tss-state {
  min-height: 164rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #967F6D;
  font-size: 24rpx;
  text-align: center;
}
.tss-state-error { color: #9B4E43; }
.tss-retry {
  margin-top: 4rpx;
  padding: 12rpx 26rpx;
  border: 1rpx solid #E4C8B8;
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 23rpx;
}
.tss-expiry {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #FAF5EC;
  color: #8A6B54;
  font-size: 22rpx;
  line-height: 1.45;
}
.tss-primary {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  margin: 24rpx 0 0;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #FDF6EE;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 88rpx;
}
.tss-primary::after { border: 0; }
.tss-primary:active { opacity: .86; }
.tss-manage-note {
  margin-top: 24rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #FAF5EC;
  color: #8A6B54;
  font-size: 23rpx;
  line-height: 1.55;
}
.tss-revoke {
  min-height: 72rpx;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #A45B48;
  font-size: 24rpx;
}
.tss-revoke:active { opacity: .6; }
.tss-revoke.is-busy { color: var(--color-placeholder); }
