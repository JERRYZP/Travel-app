/* 弹窗容器：fixed 全屏，不拦截点击（pointer-events 交给遮罩/弹层） */
.cart-popup {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  pointer-events: none;
}

/* 遮罩：点击关闭 + 拦截背景滚动；bottom 由 JS 内联 px 控制（让出底部清单栏） */
.cart-mask {
  position: absolute;
  top: 0; left: 0; right: 0;
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
  animation: cart-mask-in 0.2s ease;
}

/* 底部弹层：从底部升起；bottom 由 JS 内联 px 控制。
   高度 = 头部 + 列表，列表高度由 JS 限制为 ≤80% 屏高 - 头部（确定性 px，非 max-height） */
.cart-sheet {
  position: absolute;
  left: 0; right: 0;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  pointer-events: auto;
  animation: cart-sheet-up 0.25s ease;
}

@keyframes cart-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes cart-sheet-up {
  from { transform: translateY(40rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

/* 头部 */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  background: var(--color-surface);
  box-shadow: 0 2rpx 8rpx rgba(100, 60, 20, 0.08);
}
.cart-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #7A5540;
}
.cart-clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #B09878;
}

/* 列表：米色底 + 日期分组白卡；高度由 JS 内联 px 控制 */
.cart-list {
  background: var(--color-page);
}

.cart-loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
.cart-empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--color-placeholder);
}

/* ===== 清单分组 ===== */
.cart-group { margin-bottom: 20rpx; }
.cart-group-header {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-muted);
  padding: 6rpx 4rpx 12rpx;
}

/* 分组卡片：白底圆角，行之间用细线分隔 */
.cart-group-card {
  background: var(--color-surface);
  border-radius: 20rpx;
  overflow: hidden;
}

/* 行：缩略图 + 景点名/副行 + 动作下拉 + 垃圾桶 */
.cart-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 20rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.cart-row:last-child { border-bottom: none; }

.cart-row-thumb {
  width: 84rpx; height: 84rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: var(--color-cream);
}
.cart-row-body { flex: 1; min-width: 0; }
.cart-row-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.cart-row-sub {
  display: block;
  font-size: 22rpx;
  color: var(--color-text);
  margin-top: 6rpx;
}

.cart-row-action { flex-shrink: 0; position: relative; }

/* 动作下拉二选一：这是清单里唯一的提醒开关决策点 */
.cart-drop {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
  font-size: 22rpx;
  color: var(--color-text);
  background: var(--color-page);
}
.cart-drop.open { border-color: var(--color-primary); color: var(--color-primary); }
/* 下拉浮层：渲染在 .cart-popup 这一层，position: fixed + JS 算好的视口坐标。
   为什么不用 absolute 贴着触发按钮：它会被 scroll-view 裁掉。 */
.cart-drop-pop {
  position: fixed;
  z-index: 30;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(100,60,20,.22);
  min-width: 300rpx;
  padding: 8rpx 0 0;
  animation: drop-in .16s cubic-bezier(.22,1,.36,1);
}
@keyframes drop-in {
  from { opacity: 0; transform: translateY(6rpx); }
  to   { opacity: 1; transform: none; }
}

/* 挡在下面的透明遮罩：点任意处收起。
   z-index 显式写在 wxml 内联样式里（真机上类选择器与内联混用时层级判定不稳）。 */
.cart-drop-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
}
.cart-drop-opt {
  padding: 18rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text);
  white-space: nowrap;
}
.cart-drop-opt.active { color: var(--color-primary); font-weight: 600; background: rgba(192,71,42,.06); }

/* 确定条：给这个控件一个明确的提交点，避免「点哪都是改」 */
.cart-drop-confirm {
  margin-top: 8rpx;
  border-top: 1rpx solid var(--color-border);
  padding: 18rpx 24rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 免预约项：说明必须与按钮同屏可见，不能只靠弹窗解释 */
.cart-no-remind {
  display: block;
  max-width: 260rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--color-muted);
  text-align: right;
}

.cart-row-delete {
  flex-shrink: 0;
  padding: 10rpx 4rpx 10rpx 6rpx;
  opacity: .55;
}
.cart-row-delete:active { opacity: 1; }

/* ===== 底部提交条（31.png：sheet 自带，不再依赖页面那条） ===== */
.cart-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* ⚠️ 不要再加 env(safe-area-inset-bottom)：本 sheet 通过 bottomOffset 整体坐在
     TabBar **之上**，而 TabBar 自己已经吃掉了安全区（padding-bottom: env(...)）。
     这里再加一次就会多出一整条安全区高度——用户实测「底部离 TabBar 太远」。 */
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
}
.cart-foot-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--color-text);
}
.cart-foot-btn {
  flex-shrink: 0;
  background: var(--color-primary);
  color: #FDF6EE;
  font-size: 27rpx;
  font-weight: 600;
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
}
.cart-foot-btn.disabled { background: var(--color-placeholder); }
.cart-foot-btn:active { opacity: .88; }

.dialog-body {
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-ink);
}
