/* 弹窗容器：fixed 全屏，不拦截点击（pointer-events 交给遮罩/弹层） */
.cart-popup {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  pointer-events: none;
}

/* 遮罩：点击关闭 + 拦截背景滚动；bottom 由 JS 内联 px 控制（让出底部清单栏） */
.cart-mask {
  position: absolute;
  top: 0; left: 0; right: 0;
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
  animation: cart-mask-in 0.2s ease;
}

/* 底部弹层：从底部升起；bottom 由 JS 内联 px 控制。
   高度 = 头部 + 列表，列表高度由 JS 限制为 ≤80% 屏高 - 头部（确定性 px，非 max-height） */
.cart-sheet {
  position: absolute;
  left: 0; right: 0;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  pointer-events: auto;
  animation: cart-sheet-up 0.25s ease;
}

@keyframes cart-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes cart-sheet-up {
  from { transform: translateY(40rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

/* 头部 */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  background: var(--color-surface);
  box-shadow: 0 2rpx 8rpx rgba(100, 60, 20, 0.08);
}
.cart-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #7A5540;
}
.cart-clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #B09878;
}

/* 列表：米色底 + 日期分组白卡；高度由 JS 内联 px 控制 */
.cart-list {
  background: var(--color-page);
}

.cart-loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
.cart-empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--color-placeholder);
}

.cart-group {
  margin-bottom: 24rpx;
}
.cart-group-header {
  color: #7A5540;
  font-size: 26rpx;
  padding: 24rpx 48rpx 12rpx;
}
.cart-group-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  margin: 0 30rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(100,60,20,0.04);
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.cart-item:last-child { border-bottom: none; }

.cart-item-time {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 11rpx;
  flex-shrink: 0;
}
.cart-item-clock,
.cart-item-countdown {
  line-height: 1;
}
.cart-item-clock {
  font-size: 26rpx;
  color: #7A5540;
}
.cart-item-countdown {
  font-size: 20rpx;
  color: var(--color-primary);
}

.cart-item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cart-item-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--color-ink);
}
.cart-item-visit {
  display: flex;
  align-items: baseline;
  font-size: 22rpx;
}
.cart-item-visit-pre,
.cart-item-visit-suf {
  color: #7A5540;
}
.cart-item-visit-date {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 提醒开关：仅需预约项出现 */
.cart-remind-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #A68045;
}
.cart-remind-checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 1rpx solid #D7BF96;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.cart-remind-checkbox.checked {
  background: #B8904A;
  border-color: #B8904A;
}
.cart-no-remind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #B09878;
}

/* 删除按钮：浅色描边、更小 */
.cart-item-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid #EDE0C8;
  border-radius: 12rpx;
  background: var(--color-surface);
}

.dialog-body {
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-ink);
}
