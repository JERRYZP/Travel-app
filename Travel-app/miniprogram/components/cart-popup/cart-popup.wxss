.cart-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
/* 底部让出页面自身的清单栏模块（92rpx + 安全区），弹窗与该模块共用 */
.cart-mask {
  bottom: calc(92rpx + env(safe-area-inset-bottom));
}
/* 首页弹出时：再让出底部 TabBar（100rpx + 安全区） */
.cart-mask.above-tabbar {
  bottom: calc(192rpx + env(safe-area-inset-bottom));
}

.cart-sheet {
  width: 100%;
  max-height: 80vh;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

/* 头部 */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  flex-shrink: 0;
}
.cart-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #7A5540;
}
.cart-clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #B09878;
}

/* 列表：米色底 + 日期分组白卡 */
.cart-list {
  flex: 1;
  overflow-y: auto;
  max-height: 50vh;
  background: var(--color-page);
}

.cart-loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
.cart-empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--color-placeholder);
}

.cart-group {
  margin-bottom: 24rpx;
}
.cart-group-header {
  color: #7A5540;
  font-size: 26rpx;
  padding: 24rpx 48rpx 12rpx;
}
.cart-group-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  margin: 0 30rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(100,60,20,0.04);
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.cart-item:last-child { border-bottom: none; }

.cart-item-time {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 11rpx;
  flex-shrink: 0;
}
.cart-item-clock,
.cart-item-countdown {
  line-height: 1;
}
.cart-item-clock {
  font-size: 26rpx;
  color: #7A5540;
}
.cart-item-countdown {
  font-size: 20rpx;
  color: var(--color-primary);
}

.cart-item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cart-item-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--color-ink);
}
.cart-item-visit {
  display: flex;
  align-items: baseline;
  font-size: 22rpx;
}
.cart-item-visit-pre,
.cart-item-visit-suf {
  color: #7A5540;
}
.cart-item-visit-date {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 删除按钮：浅色描边、更小 */
.cart-item-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid #EDE0C8;
  border-radius: 12rpx;
  background: var(--color-surface);
}

/* 底部操作栏 */


.dialog-body {
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-ink);
}
