/* 弹窗容器：fixed 全屏，不拦截点击（pointer-events 交给遮罩/弹层） */
.cart-popup {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  pointer-events: none;
}

/* 遮罩：点击关闭 + 拦截背景滚动；bottom 由 JS 内联 px 控制 */
.cart-mask {
  position: absolute;
  top: 0; left: 0; right: 0;
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
  animation: cart-mask-in 0.2s ease;
}

/* 底部弹层：视觉基准 402px；rpx = 设计px × 750 / 402。 */
.cart-sheet {
  position: absolute;
  left: 0; right: 0;
  background: #F8F8F8;
  border-radius: 30rpx 30rpx 0 0;
  pointer-events: auto;
  animation: cart-sheet-up 0.25s ease;
}

@keyframes cart-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes cart-sheet-up {
  from { transform: translateY(40rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

/* 头部 */
.cart-header {
  height: 90rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: #FFFEFB;
  border-bottom: 1rpx solid #F0F0E8;
}
.cart-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #7A5540;
}
.cart-clear-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #B89048;
}
.cart-clear-btn:active { opacity: .65; }

/* 列表：米色底；高度由 JS 内联 px 控制 */
.cart-list { background: #F8F3EA; }
.cart-list-inner { padding-bottom: 18rpx; }
.cart-tips-card {
  margin: 20rpx 30rpx 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #FFFEFB;
  border: 1rpx solid #F0E8DE;
}
.cart-tips-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #C87D2A;
}
.cart-tips-title-wrap { display: flex; align-items: center; gap: 8rpx; }
.cart-tips-title { font-size: 25rpx; font-weight: 400; }
.cart-tips-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #5E3D32;
}
.cart-tips-folded {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9B7F6F;
}

.cart-loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
.cart-empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #B09878;
}

/* ===== 出行日分组 ===== */
.cart-group { padding: 24rpx 30rpx 0; }
.cart-group + .cart-group { margin-top: 16rpx; }
.cart-group-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 38rpx;
  margin-bottom: 28rpx;
}
.cart-group-date {
  font-size: 26rpx;
  font-weight: 500;
  color: #5E3D32;
  white-space: nowrap;
}
.cart-day-chip {
  flex-shrink: 0;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: #F2E4C0;
  color: #C26B0C;
  font-size: 22rpx;
}
.cart-past-note {
  flex-shrink: 0;
  color: #9B7F6F;
  font-size: 20rpx;
  white-space: nowrap;
}
.cart-group-line {
  flex: 1;
  height: 1rpx;
  margin-left: 4rpx;
  background: #E7DED2;
  transform: translateY(1rpx);
}

/* ===== 行程项卡片 ===== */
.cart-group-list { display: block; }
.cart-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 108rpx;
  margin-bottom: 12rpx;
  padding: 13rpx 20rpx;
  box-sizing: border-box;
  background: #FFFEFB;
  border: 1rpx solid #F0F0E8;
  border-radius: 20rpx;
}
.cart-row:last-child { margin-bottom: 0; }

.cart-row-thumb {
  width: 82rpx;
  height: 82rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #EDE5D2;
}
.cart-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.cart-row-name-line {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}
.cart-row-name {
  max-width: 188rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 500;
  color: #4A2D23;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
.cart-row-diff {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
}
.diff-EXTREME { background: var(--diff-extreme-bg); color: var(--diff-extreme-text); }
.diff-NORMAL { background: var(--diff-normal-bg); color: var(--diff-normal-text); }
.diff-EASY { background: var(--diff-easy-bg); color: var(--diff-easy-text); }
.cart-row-sub {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 23rpx;
  color: #C04028;
}
.cart-row-sub.is-released { color: var(--chip-green-text); }

.cart-row-action {
  flex-shrink: 0;
  position: relative;
  /* 与右侧垃圾桶再留出 4px，避免点击下拉时误触删除。 */
  margin-right: 8rpx;
}

/* 可选提醒：金边下拉 Default。 */
.cart-drop {
  width: 252rpx;
  height: 60rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 0 16rpx;
  border: 1rpx solid #DFCFB4;
  border-radius: 16rpx;
  background: #FFFEFB;
  color: #5E3D32;
  font-size: 24rpx;
  white-space: nowrap;
}
.cart-drop:active { opacity: .72; }

/* 不可选提醒：与 Default 同尺寸体系，灰底灰字灰箭头。 */
.cart-drop.disabled {
  width: 252rpx;
  background: #F8F0E8;
  border-color: #F8F0E8;
  color: #B09878;
}

.cart-row-delete {
  flex-shrink: 0;
  padding: 12rpx 0 12rpx 2rpx;
  opacity: .72;
}
.cart-row-delete:active { opacity: 1; }

/* 下拉菜单：放在 scroll-view 外，用 fixed 定位避免裁切。 */
.cart-drop-catch {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 240;
}
.cart-drop-menu {
  position: fixed;
  z-index: 250;
  overflow: hidden;
  padding: 8rpx 0;
  border: 1rpx solid #F0E8E0;
  border-radius: 20rpx;
  background: #FFFEFB;
  box-shadow: 0 12rpx 28rpx rgba(74, 45, 35, 0.12);
}
.cart-drop-option {
  height: 78rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #5E3D32;
  font-size: 24rpx;
}
.cart-drop-option:active { background: #F8F0E8; }

/* ===== 底部提交条 ===== */
.cart-foot {
  /* 与行程页 .cart-bar 固定同高；图标可到 72rpx，仍留足上下空间。 */
  height: 96rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #F0F0E8;
  background: #FDFBF7;
}
.cart-foot-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cart-foot-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #B8904A;
}
.cart-foot-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #C04028;
  color: #FFFEFB;
  font-size: 20rpx;
  line-height: 1;
}
.cart-foot-text {
  min-width: 0;
  font-size: 21rpx;
  color: #5E3D32;
}
.cart-foot-reminder-count { color: var(--color-primary); }
.cart-foot-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #C04028;
  color: #FFFEFB;
  font-size: 26rpx;
  font-weight: 500;
}
.cart-foot-btn.disabled { background: #DBCDBB; }
.cart-foot-btn:active { opacity: .88; }

.dialog-body {
  padding: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4A2D23;
}
