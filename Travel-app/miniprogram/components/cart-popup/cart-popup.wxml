<view wx:if="{{show}}" class="cart-popup {{aboveTabbar ? 'above-tabbar' : ''}}">
  <!-- 遮罩层：点击关闭，并拦截背景滚动（不影响弹层内列表滚动） -->
  <view class="cart-mask" style="bottom: {{bottomOffset}};" bindtap="onMaskTap" catchtouchmove="noop"></view>

  <!-- 底部弹层：从底部升起；高度 = 头部 + 列表（列表高度由 JS 按 80% 屏高限制，px 内联） -->
  <view class="cart-sheet" style="bottom: {{bottomOffset}};" catchtap="onSheetTap">
    <!-- 头部 -->
    <view class="cart-header" catchtouchmove="noop">
      <text class="cart-title">提醒清单：共{{summary ? summary.count : 0}}项</text>
      <view class="cart-clear-btn" bindtap="onClearTap">
        <svg-icon name="trash" size="14px" />
        <text>清空</text>
      </view>
    </view>

    <!-- 列表：米色底 + 日期白卡；listStyle 为 JS 计算的确定性高度（px），超高内部滚动 -->
    <scroll-view scroll-y class="cart-list" style="{{listStyle}}">
      <view class="cart-list-inner">
        <block wx:if="{{loading}}">
          <view class="cart-loading">
            <van-loading size="40rpx" color="#B8904A" />
          </view>
        </block>
        <block wx:elif="{{groups.length === 0}}">
          <view class="cart-empty">
            <text>清单还是空的，去添加提醒吧</text>
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="cart-group">
            <view class="cart-group-header">{{group.label}}</view>
            <view class="cart-group-card">
              <view wx:for="{{group.items}}" wx:key="_id" wx:for-item="item" class="cart-item">
                <view class="cart-item-time">
                  <text class="cart-item-clock">{{item.releaseTimeLabel}}</text>
                  <text wx:if="{{item.countdown && !item.countdown.expired && item.countdown.hours < 12}}" class="cart-item-countdown">
                    {{item.countdown.text}}
                  </text>
                </view>
                <view class="cart-item-body">
                  <text class="cart-item-name">{{item.spotName}}</text>
                  <view class="cart-item-visit">
                    <text class="cart-item-visit-pre">约 </text>
                    <text class="cart-item-visit-date">{{item.visitDate}}</text>
                    <text class="cart-item-visit-suf">{{item.visitRest}}</text>
                  </view>
                </view>
                <view class="cart-item-delete" bindtap="onRemove" data-id="{{item._id}}">
                  <svg-icon name="trash" size="14px" />
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>

    <!-- 底部操作栏：复用页面自身的清单栏模块（弹窗从该模块上方开始） -->
  </view>
</view>

<van-dialog
  use-slot
  show="{{showClearDialog}}"
  show-confirm-button
  show-cancel-button
  confirm-button-text="确认清空"
  cancel-button-text="取消"
  bind:confirm="onClearConfirm"
  bind:cancel="onClearCancel"
>
  <view class="dialog-body">确认清空提醒清单？</view>
</van-dialog>
