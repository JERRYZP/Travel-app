<view wx:if="{{show}}" class="cart-popup {{aboveTabbar ? 'above-tabbar' : ''}}">
  <view class="cart-mask" style="bottom: {{bottomOffset}};" bindtap="onMaskTap" catchtouchmove="noop"></view>

  <view class="cart-sheet" style="bottom: {{bottomOffset}};" catchtap="onSheetTap">
    <!-- 头部：标题 + 清空 -->
    <view class="cart-header" catchtouchmove="noop">
      <text class="cart-title">行程清单：共{{summary ? summary.count : 0}}项</text>
      <view class="cart-clear-btn" bindtap="onClearTap">
        <svg-icon name="trash" size="14px" />
        <text>清空</text>
      </view>
    </view>

    <scroll-view scroll-y class="cart-list" style="{{listStyle}}" bindscroll="onListScroll">
      <view class="cart-list-inner">
        <block wx:if="{{loading}}">
          <view class="cart-loading"><van-loading size="40rpx" color="#B8904A" /></view>
        </block>
        <block wx:elif="{{groups.length === 0}}">
          <view class="cart-empty"><text>清单还是空的，去时间线选择景点吧</text></view>
        </block>
        <block wx:else>
          <!-- 按放票日期分组；免预约项单独一组 -->
          <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="cart-group">
            <view class="cart-group-header">{{group.label}}</view>
            <view class="cart-group-card">
            <view wx:for="{{group.items}}" wx:key="_id" wx:for-item="item" class="cart-row">
              <image class="cart-row-thumb" src="/images/spots/{{item.spotId}}.jpg" mode="aspectFill" />

              <view class="cart-row-body">
                <text class="cart-row-name">{{item.spotName}}</text>
                <text class="cart-row-sub">{{item.subline}}</text>
              </view>

              <!-- 动作下拉二选一（浮层本身渲染在最外层，见文件末尾）。
                   免预约项固定不可改：不是置灰，是压根没有这个选择 -->
              <view class="cart-row-action">
                <view
                  wx:if="{{item.canToggle}}"
                  id="drop-{{item._id}}"
                  class="cart-drop {{openDropdown === item._id ? 'open' : ''}}"
                  catchtap="onToggleDropdown"
                  data-id="{{item._id}}"
                >
                  <text>{{item.remindText}}</text>
                  <svg-icon name="{{openDropdown === item._id ? 'chevron-up' : 'chevron-down'}}" size="11px" />
                </view>
                <!-- 免预约：说明必须与按钮同屏可见，不能只靠弹窗解释 -->
                <text wx:else class="cart-no-remind">无需预约，随到随玩，不设提醒</text>
              </view>

              <!-- 清单是一次性任务，不做中间态管理：右侧直接给垃圾桶 -->
              <view class="cart-row-delete" catchtap="onRemove" data-id="{{item._id}}">
                <svg-icon name="trash" size="15px" />
              </view>
            </view>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>

    <!-- 底部提交条：已选 N 项，覆盖 M 个景点 + 提交行程清单 -->
    <view class="cart-foot" catchtouchmove="noop">
      <text class="cart-foot-text">已选 {{summary ? summary.count : 0}} 项，覆盖 {{summary ? summary.spotCount : 0}} 个景点</text>
      <view class="cart-foot-btn {{summary && summary.count ? '' : 'disabled'}}" bindtap="onSubmit">
        提交行程清单
      </view>
    </view>
  </view>

  <!-- 动作下拉浮层：**必须在最外层**。
       放进 row 会被 scroll-view 裁掉；放进 .cart-sheet 也不行 ——
       sheet 有入场动画（transform），会让 position: fixed 的后代改以它为包含块。
       坐标由 JS 按触发按钮的位置算好，见 onToggleDropdown。 -->
  <block wx:if="{{openDropdown && dropItem}}">
    <!-- ⚠️ 内联 z-index + catchtap：遮罩是满屏的，而它与浮层同为 fixed。
         真机上仅靠类里的 z-index 在部分基础库下会判错，遮罩抢走点击 →
         「点选项没反应、点空白也不消失」。内联写死并拉开层级最稳。 -->
    <view class="cart-drop-mask" style="z-index: 900;" catchtap="closeDropdown" catchtouchmove="noop"></view>
    <view class="cart-drop-pop" style="{{dropStyle}} z-index: 901;" catchtap="noop">
      <!-- 手指点一下即生效并关闭；点空白只关闭、不改动 -->
      <view class="cart-drop-opt {{dropItem.remindOn ? 'active' : ''}}"
            catchtap="onPickRemind" data-remind="{{true}}">{{OPTION_ON}}</view>
      <view class="cart-drop-opt {{!dropItem.remindOn ? 'active' : ''}}"
            catchtap="onPickRemind" data-remind="{{false}}">{{OPTION_OFF}}</view>
    </view>
  </block>
</view>

<van-dialog
  use-slot
  show="{{showClearDialog}}"
  show-confirm-button
  show-cancel-button
  confirm-button-text="确认清空"
  cancel-button-text="取消"
  bind:confirm="onClearConfirm"
  bind:cancel="onClearCancel"
>
  <view class="dialog-body">确认清空行程清单？</view>
</van-dialog>
