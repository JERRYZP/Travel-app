<view wx:if="{{show}}" class="cart-popup {{aboveTabbar ? 'above-tabbar' : ''}}">
  <view class="cart-mask" style="bottom: {{bottomOffset}};" bindtap="onMaskTap" catchtouchmove="noop"></view>

  <view class="cart-sheet" style="bottom: {{bottomOffset}};" catchtap="onSheetTap">
    <!-- 头部：标题 + 清空 -->
    <view class="cart-header" catchtouchmove="noop">
      <text class="cart-title">行程清单：共{{summary ? summary.count : 0}}项</text>
      <view class="cart-clear-btn" bindtap="onClearTap">
        <svg-icon name="trash" size="15px" />
        <text>清空</text>
      </view>
    </view>

    <scroll-view scroll-y class="cart-list" style="{{listStyle}}" bindscroll="onListScroll">
      <view class="cart-list-inner">
        <view class="cart-tips-card">
          <view class="cart-tips-head" catchtap="onToggleTips">
            <view class="cart-tips-title-wrap">
              <svg-icon name="alert-circle" size="14px" />
              <text class="cart-tips-title">温馨提示：</text>
            </view>
            <svg-icon name="{{tipsExpanded ? 'chevron-up' : 'chevron-down'}}" size="12px" />
          </view>
          <view wx:if="{{tipsExpanded}}" class="cart-tips-body">
            <text>1、超难约的景点默认开启提醒</text>
            <text>2、较容易约热门景点，默认不开启提醒，可手动选择开启</text>
            <text>3、无需预约的景点，不开启提醒，仅加入行程中</text>
          </view>
          <text wx:else class="cart-tips-folded">默认策略：超难约开启 · 较易约关闭 · 免预约不提醒</text>
        </view>
        <block wx:if="{{loading}}">
          <view class="cart-loading"><van-loading size="40rpx" color="#B8904A" /></view>
        </block>
        <block wx:elif="{{groups.length === 0}}">
          <view class="cart-empty"><text>清单还是空的，去时间线选择景点吧</text></view>
        </block>
        <block wx:else>
          <!-- 按出行日分组；同一天内的景点共用一张时间线分组 -->
          <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="cart-group">
            <view class="cart-group-header">
              <text class="cart-group-date">{{group.label}}</text>
              <text class="cart-day-chip">{{group.dayLabel}}</text>
              <view class="cart-group-line"></view>
            </view>

            <view class="cart-group-list">
              <view wx:for="{{group.items}}" wx:key="_id" wx:for-item="item" class="cart-row">
                <image class="cart-row-thumb" src="/images/spots/{{item.spotId}}.jpg" mode="aspectFill" />

                <view class="cart-row-body">
                  <view class="cart-row-name-line">
                    <text class="cart-row-name">{{item.spotName}}</text>
                    <text wx:if="{{item.difficulty}}" class="cart-row-diff diff-{{item.difficulty.key}}">{{item.difficulty.text}}</text>
                  </view>
                  <text class="cart-row-sub">{{item.subline}}</text>
                </view>

                <view class="cart-row-action">
                  <view
                    id="cart-drop-{{item._id}}"
                    class="cart-drop {{item.canToggle ? '' : 'disabled'}}"
                    catchtap="onToggleDropdown"
                    data-id="{{item._id}}"
                  >
                    <text>{{item.remindText}}</text>
                    <svg-icon name="{{item.canToggle ? 'chevron-down' : 'chevron-down-muted'}}" size="12px" />
                  </view>
                </view>

                <view class="cart-row-delete" catchtap="onRemove" data-id="{{item._id}}">
                  <svg-icon name="trash" size="17px" />
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>

    <!-- 自定义下拉层放在 scroll-view 外，避免被滚动容器裁切；位置由 JS 按触发框计算。 -->
    <view wx:if="{{dropdown.show}}" class="cart-drop-catch" catchtap="onDropdownClose" catchtouchmove="noop"></view>
    <view
      wx:if="{{dropdown.show}}"
      class="cart-drop-menu"
      style="top: {{dropdown.top}}px; left: {{dropdown.left}}px; width: {{dropdown.width}}px;"
      catchtap="noop"
    >
      <view class="cart-drop-option" catchtap="onDropdownPick" data-remind="true">开票前提醒我</view>
      <view class="cart-drop-option" catchtap="onDropdownPick" data-remind="false">仅加行程·不提醒</view>
    </view>

    <!-- 底部提交条：清单图标 + 统计 + 提交 -->
    <view class="cart-foot" catchtouchmove="noop">
      <view class="cart-foot-main">
        <view class="cart-foot-icon">
          <svg-icon name="list-white" size="22px" />
          <view wx:if="{{summary && summary.count}}" class="cart-foot-badge">{{summary.count}}</view>
        </view>
        <text class="cart-foot-text">{{cartFootText}}</text>
      </view>
      <view class="cart-foot-btn {{summary && summary.count ? '' : 'disabled'}}" bindtap="onSubmit">
        <svg-icon name="heart-add-white" size="16px" />
        <text>{{cartBtnText}}</text>
      </view>
    </view>
  </view>

</view>

<van-dialog
  use-slot
  show="{{showClearDialog}}"
  show-confirm-button
  show-cancel-button
  confirm-button-text="确认清空"
  cancel-button-text="取消"
  bind:confirm="onClearConfirm"
  bind:cancel="onClearCancel"
>
  <view class="dialog-body">确认清空行程清单？</view>
</van-dialog>
