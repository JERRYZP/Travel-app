<view wx:if="{{show}}" class="drp-mask" bindtap="onClose" catchtouchmove="noop">
  <view class="drp-sheet" catchtap="noop">
    <view class="drp-handle"></view>
    <view class="drp-header">
      <text class="drp-title">{{title}}</text>
      <text class="drp-sub">{{subtitle}}</text>
    </view>
    <view class="drp-weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this" class="drp-weekday">{{item}}</text>
    </view>
    <scroll-view scroll-y class="drp-months" scroll-into-view="{{scrollIntoView}}">
      <view id="drp-month-{{m.key}}" wx:for="{{months}}" wx:for-item="m" wx:key="key" class="drp-month">
        <text class="drp-month-title">{{m.title}}</text>
        <view class="drp-grid">
          <view
            wx:for="{{m.days}}"
            wx:for-item="d"
            wx:key="index"
            class="drp-day {{d.disabled ? 'is-disabled' : ''}} {{d.inRange ? 'in-range' : ''}} {{d.isStart ? 'is-start' : ''}} {{d.isEnd ? 'is-end' : ''}}"
            bindtap="onDayTap"
            data-date="{{d.date}}"
            data-disabled="{{d.disabled}}"
          >
            <view class="drp-day-inner">{{d.day}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <view class="drp-confirm-bar" catchtap="noop">
    <view class="drp-confirm-copy">
      <text class="drp-range-text">{{rangeText}}</text>
      <text wx:if="{{note}}" class="drp-note">{{note}}</text>
    </view>
    <view class="drp-confirm-btn {{canConfirm && !saving ? '' : 'is-disabled'}}" bindtap="onConfirm">{{saving ? '保存中…' : confirmText}}</view>
  </view>
</view>
