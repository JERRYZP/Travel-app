<view class="trip-section {{history ? 'is-history' : ''}}">
  <!-- ⚠️ 行程分段标题：**按 weak 取舍**，不是一刀切（2026-09-21 用户口径）。
       顶部摘要卡只展示**最近即将发生或正在发生**的那一趟，所以：
         - `weak === true`（就是摘要卡那趟）：标题行与摘要卡是同一批信息，同屏重复 → 不渲染；
         - `weak === false`（后面还没发生的行程）：摘要卡没有覆盖它，没有标题行就会直接
           塌成一堆裸日期，读不出「这是独立的一段、到哪结束」→ **必须渲染**。
       「未来行程」那行小字只是摘要卡上的**指路**，不是这个标题的替代品：
       小字没有进度、也不承载分段的视觉边界。
       右侧原有的「行程管理」入口与分段吸顶已废止（与摘要卡重复 / 不再有该行需求），
       连带删掉了页面的滚动测位逻辑与下发的吸顶属性。 -->
  <view wx:if="{{!weak}}" class="ts-head">
    <view class="ts-head-left">
      <text class="ts-city">{{trip.city}}</text>
      <text class="ts-range">{{dateRange}}</text>
      <text class="ts-progress">{{progressText}}</text>
    </view>
  </view>

  <!-- 已结束日期折叠入口：放在今天/未来之前，展开后仍按原时间顺序回到这里。
       只用于进行中行程；历史行程已在页面底部整趟折叠，不重复套一层。 -->
  <view wx:if="{{!history && pastCount > 0}}" class="ts-past-fold" bindtap="onPastToggle">
    <view class="ts-past-copy">
      <text class="ts-past-title">已过去{{pastElapsedDays}}天</text>
      <text class="ts-past-range">{{pastRangeText}} · {{pastItemCount}}项</text>
    </view>
    <svg-icon name="{{pastOpen ? 'chevron-up' : 'chevron-down'}}" size="14px" />
  </view>

  <block wx:for="{{days}}" wx:key="key" wx:for-index="dayIndex" wx:for-item="day">
  <view wx:if="{{history || dayIndex >= pastCount || pastOpen}}" class="ts-day">
    <!-- 日期分段标题：带「删除当天行程」菜单（删除动线第二层） -->
    <view class="ts-day-head">
      <text class="ts-day-title">{{day.title}}</text>
      <view class="ts-day-badge">{{day.badge}}</view>
      <text wx:if="{{day.daysPast > 0}}" class="ts-day-past-note">已过去{{day.daysPast}}天</text>
      <view class="ts-day-line"></view>
      <!-- ⚠️ 捕获层与 `.ts-day-menu` 平级、且在它之前 —— 与 `trip-card` 的三点菜单
           同款结构（那边有完整原理注释，包括「放进容器里就永远浮不起来」这条踩坑）。
           两者同为 z-index 31，靠文档序决胜：图标在后 → 胜出。
           展开时还要给菜单容器加 `.is-open` 抬层：否则下方景点卡的 104rpx 菜单热区
           与本弹层同为 31 且文档序更后，会盖住「删除当天行程」的右段并误开景点菜单。 -->
      <view wx:if="{{day.menuOpen && !history}}" class="ts-day-catch" catchtap="onMenuClose" catchtouchmove="noop"></view>
      <view wx:if="{{!history}}" class="ts-day-menu {{day.menuOpen ? 'is-open' : ''}}" bindtap="onDateMenuToggle" data-date="{{day.key}}">
        <view class="ts-day-btn">
          <svg-icon name="menu-muted" size="13px" />
        </view>
        <!-- ⚠️ 弹出层自己**不带关闭手势**（2026-09-23 删掉 `catchtap="onMenuClose"`）：
             它和 `.ts-day-pop-item` 各自绑 catchtap，条目会先触发关闭，
             切掉 `menuDate` 后整块 `wx:if` 被摘掉、紧接着的 `removedate` 事件
             就没人接了 —— 点「删除当天行程」静默失败。 -->
        <view wx:if="{{day.menuOpen}}" class="ts-day-pop">
          <view class="ts-day-pop-item" catchtap="onRemoveDate" data-date="{{day.key}}">
            <svg-icon name="trash" size="14px" /><text>删除当天行程</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ⚠️ wx:key 用 itemId：同一景点可以有多个备选日期，用 spotId 会重键 -->
    <trip-card
      wx:for="{{day.items}}"
      wx:key="itemId"
      wx:for-item="it"
      item="{{it}}"
      history="{{history}}"
      menu-id="{{menuId}}"
      bubble-dismissed="{{it.bubbleDismissed}}"
      recover-dismissed="{{it.recoverDismissed}}"
      recoverable="{{it.recoverable}}"
      bind:spot="onCardSpot"
      bind:menuclose="onMenuClose"
      bind:mark="onCardMark"
      bind:editreminder="onCardEditReminder"
      bind:remove="onCardRemove"
      bind:result="onCardResult"
      bind:dismiss="onCardDismiss"
      bind:dismissrecover="onCardDismissRecover"
      bind:menutoggle="onCardMenuToggle"
      bind:recover="onCardRecover"
      bind:missedreason="onCardMissedReason"
    />
  </view>
  </block>
</view>
