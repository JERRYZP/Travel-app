<wxs module="asset" src="../../utils/cloud-assets.wxs"></wxs>
<wxs module="fmt" src="../../utils/format.wxs"></wxs>
<view wx:if="{{show}}" class="popup-mask" bindtap="onMaskTap" catchtouchmove="onSheetTap">
  <view
    class="popup-sheet {{showActions ? 'popup-sheet--actions' : ''}}"
    style="{{sheetStyle}}"
    catchtap="onSheetTap"
  >
    <!-- 滚动区：底部留白由 .popup-sheet--actions > .popup-scroll-content 给，
         保证正文能滚到操作栏上方 32px 处，不被按钮压住。 -->
    <scroll-view
      scroll-y
      class="popup-scroll"
      style="{{scrollStyle}}"
      show-scrollbar="{{false}}"
    >
    <view class="popup-scroll-content {{tipsExpanded ? 'popup-scroll-content--expanded' : ''}}">
    <block wx:if="{{loading}}">
      <view class="popup-loading">
        <van-loading size="40rpx" color="#B8904A" />
      </view>
    </block>

    <block wx:elif="{{loadFailed}}">
      <view class="popup-error">
        <text class="popup-error-title">景点详情加载失败</text>
        <text class="popup-error-desc">景点可能已下线，或当前网络不可用。</text>
        <view class="popup-error-btn" bindtap="onClose">关闭</view>
      </view>
    </block>

    <block wx:elif="{{spot}}">
      <!-- 头部：缩略图 + 名称/难度 + 核心标签 -->
      <view class="popup-header {{spot.specialNotice ? 'popup-header--with-notice' : ''}} {{showShare ? 'popup-header--share' : ''}}">
        <image class="popup-spot-img" src="{{asset.spot(spot.spotId)}}" mode="aspectFill" />
        <button
          wx:if="{{showShare}}"
          class="popup-share-btn"
          open-type="share"
          hover-class="none"
          aria-label="分享景点"
        >
          <van-icon name="share-o" size="17px" color="#B8904A" />
        </button>
        <view class="popup-header-info">
          <view class="popup-name-row">
            <text class="popup-spot-name">{{spot.name}}</text>
            <view wx:if="{{spot.reservationRequired}}" class="popup-diff-tag diff-{{spot.difficultyLabel.key}}">
              {{spot.difficultyLabel.text}}
            </view>
          </view>
          <view class="popup-tag-row">
            <block wx:if="{{spot.remindable}}">
              <view class="popup-core-tag">提前{{spot.advanceDays}}天</view>
              <view wx:if="{{spot.releaseTime}}" class="popup-core-tag">每日{{fmt.releaseTimes(spot.releaseTime)}}点放票</view>
            </block>
            <block wx:elif="{{spot.reservationRequired}}">
              <view class="popup-core-tag">无固定放票时刻</view>
            </block>
            <block wx:else>
              <view class="popup-core-tag">无需预约</view>
            </block>
          </view>
        </view>
      </view>

      <!-- 分享落地摘要：不依赖展开或点击，首屏直接回答“放票/核验”两件事 -->
      <view wx:if="{{landingMode}}" class="popup-landing-summary">
        <view class="popup-landing-row">
          <text class="popup-landing-label">规则推算</text>
          <text class="popup-landing-value">最早可约 {{earliestDateLabel}}</text>
        </view>
        <view class="popup-landing-row">
          <text class="popup-landing-label">数据</text>
          <text class="popup-verify {{spot.verified ? 'verify-ok' : 'verify-warn'}}">{{spot.verifiedLabel}}</text>
          <text class="popup-landing-correct" bindtap="onCorrect">我要纠错</text>
        </view>
        <view class="popup-landing-note">库存与预约结果以官方渠道为准，不代抢代约。</view>
      </view>

      <!-- 官方临时公告（闭馆维修 / 临时停开等），specialNotice 有内容时显示 -->
      <view wx:if="{{spot.specialNotice}}" class="popup-special-notice">
        <view class="popup-notice-icon">
          <van-icon name="warning-o" size="14px" color="#C0392B" />
        </view>
        <text>{{spot.specialNotice}}</text>
      </view>

      <!-- 预约方式（B 层免预约 → 购票 / 入园方式） -->
      <view class="popup-section-title">{{spot.reservationRequired ? '预约方式' : '购票 / 入园方式'}}</view>
      <view wx:if="{{spot.reservationRequired && spot.entries.length}}" class="popup-channel-tip">
        <text>提前录入游客姓名和证件，抢票更快</text>
      </view>
      <view class="popup-entries">
        <view
          wx:for="{{spot.entries}}"
          wx:key="type"
          class="popup-entry"
          bindtap="onEntryTap"
          data-entry="{{item}}"
        >
          <view class="popup-entry-icon">
            <svg-icon name="{{item.type === 'OFFICIAL_ACCOUNT' ? 'wechat' : item.type === 'WEB' ? 'globe' : 'miniprogram'}}" size="32px" />
          </view>
          <view class="popup-entry-body">
            <view class="popup-entry-label-row">
              <text class="popup-entry-label">{{item.label}}</text>
              <view class="popup-entry-badge">{{spot.reservationRequired ? '预约方式' : '购票方式'}}{{index + 1}}</view>
            </view>
            <text class="popup-entry-hint">{{spot.reservationRequired ? item.hint : '点击打开官方购票 / 入园渠道'}}</text>
          </view>
          <view class="popup-entry-actions">
            <text
              wx:if="{{item.type === 'WEB' && item.url}}"
              class="popup-entry-copy"
              catchtap="onCopyEntry"
              data-entry="{{item}}"
            >复制链接</text>
            <view class="popup-entry-btn {{item.type === 'OFFICIAL_ACCOUNT' ? 'btn-account' : 'btn-link'}}">
              {{item.type === 'OFFICIAL_ACCOUNT' ? '查看二维码' : '打开链接'}}
            </view>
          </view>
        </view>
      </view>

      <!-- 公众号二维码弹层 -->
      <view wx:if="{{showQr && qrSpot}}" class="qr-mask" catchtap="closeQr" catchtouchmove="noop">
        <view class="qr-card" catchtap="noop">
          <text class="qr-title">{{qrSpot.name}}</text>
          <text class="qr-subtitle">长按识别二维码，关注公众号后参与预约</text>
          <image class="qr-img" src="{{qrSpot.qrCode}}" mode="aspectFit" show-menu-by-longpress />
          <view class="qr-close" bindtap="closeQr">关闭</view>
        </view>
      </view>

      <!-- 预约注意事项 -->
      <view class="popup-tips" bindtap="toggleTips">
        <text class="popup-tips-title">{{spot.reservationRequired ? '预约注意事项' : '游玩信息'}}</text>
        <van-icon name="{{tipsExpanded ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#B8904A" />
      </view>
      <view wx:if="{{tipsExpanded}}" class="popup-tips-body">
        <text>{{spot.bookingTips}}</text>
        <view wx:if="{{spot.openTime}}" class="popup-tips-row">
          <text class="popup-tips-label">开放时间</text>
          <text>{{spot.openTime}}</text>
        </view>
        <view wx:if="{{spot.ticketPrice}}" class="popup-tips-row">
          <text class="popup-tips-label">票价</text>
          <text>{{spot.ticketPrice}}</text>
        </view>
        <view wx:if="{{spot.idRequirement}}" class="popup-tips-row">
          <text class="popup-tips-label">证件要求</text>
          <text>{{spot.idRequirement}}</text>
        </view>
        <view wx:if="{{spot.closedDaysLabel}}" class="popup-tips-row">
          <text class="popup-tips-label">开放时间</text>
          <text>{{spot.closedDaysLabel}}</text>
        </view>
        <view wx:if="{{spot.closedDaysNote}}" class="popup-tips-row">
          <text class="popup-tips-label">闭馆提示</text>
          <text>{{spot.closedDaysNote}}</text>
        </view>
        <view wx:if="{{spot.ageLimit}}" class="popup-tips-row">
          <text class="popup-tips-label">优惠政策</text>
          <text>{{spot.ageLimit}}</text>
        </view>
        <!-- 规则更新时间（V3.1：仅更新时间，不含来源等级）固定在注意事项末尾；
             纠错入口同排右对齐，与内页版 spot-rule 的 onCorrect 同口径 -->
        <view class="popup-tips-row">
          <text class="popup-tips-label">数据</text>
          <text class="popup-verify {{spot.verified ? 'verify-ok' : 'verify-warn'}}">{{spot.verifiedLabel}}</text>
          <view class="popup-correct-link" bindtap="onCorrect">
            <svg-icon name="edit" size="14px" />
            <text class="popup-correct-text">我要纠错</text>
            <svg-icon name="chevron-right" size="12px" />
          </view>
        </view>
      </view>
    </block>
    </view>
    </scroll-view>

    <!-- 底部操作栏（V3.0 本期仅视觉占位，不接交互）：固定在弹窗底缘，不参与滚动。
         首页触发的浮窗不渲染此栏（showActions=false），其余入口保持带 btn。
         上方的 .popup-actions-fade 是白色→透明的渐隐层，正文从它下面滚过时淡出，
         避免出现「按钮硬切在文字中间」的观感。 -->
    <view wx:if="{{spot && !loading && showActions}}" class="popup-actions-fade"></view>
    <view wx:if="{{spot && !loading && showActions}}" class="popup-actions-bar">
      <view wx:if="{{!spot.remindable}}" class="popup-actions-note">
        {{spot.reservationRequired ? '暂无固定放票时刻，不设提醒' : '无需预约，随到随玩，不设提醒'}}
      </view>
      <view class="popup-actions">
        <block wx:if="{{spot.remindable}}">
          <view class="popup-btn popup-btn-primary" bindtap="onSetReminder">设置提醒</view>
          <view class="popup-btn popup-btn-ghost" bindtap="onAddTripOnly">仅加行程不提醒</view>
        </block>
        <view wx:else class="popup-btn popup-btn-primary" bindtap="onAddTripOnly">加入行程</view>
      </view>
    </view>
  </view>
</view>
