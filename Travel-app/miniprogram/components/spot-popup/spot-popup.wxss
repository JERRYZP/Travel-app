.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.popup-sheet {
  width: 100%;
  max-height: 80vh;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 0;
  overflow-y: auto;
}

.popup-loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* 头部：缩略图在左，名称/难度/标签在右 */
.popup-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.popup-spot-img {
  width: 200rpx;
  height: 150rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: block;
  background: linear-gradient(135deg, #EDE0C8, #DBCDBB);
}

.popup-header-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.popup-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.popup-spot-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-ink);
  line-height: 1.3;
}

.popup-diff-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  width: fit-content;
  flex-shrink: 0;
}

/* 弹窗内难度标签按参考 UI 配色；全局难度色仍生效于其他页面 */
.popup-diff-tag.diff-EXTREME { background: #FDEAEA; color: #D14747; }
.diff-EXTREME { background: var(--diff-extreme-bg); color: var(--diff-extreme-text); }
.diff-NORMAL { background: var(--diff-normal-bg); color: var(--diff-normal-text); }
.diff-EASY { background: var(--diff-easy-bg); color: var(--diff-easy-text); }

.popup-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.popup-core-tag {
  padding: 6rpx 20rpx;
  background: #F5F0E6;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #A68B5B;
}

.popup-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 16rpx;
}

.popup-entries {
  margin-bottom: 32rpx;
}

.popup-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.popup-entry:last-child { border-bottom: none; }

.popup-entry-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.popup-entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.popup-entry-label-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.popup-entry-label {
  font-size: 28rpx;
  color: var(--color-ink);
  font-weight: 500;
}

.popup-entry-badge {
  padding: 2rpx 14rpx;
  background: #F5F0E6;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #8C7350;
  flex-shrink: 0;
}

.popup-entry-hint {
  font-size: 22rpx;
  color: #6B5F53;
  line-height: 1.5;
}

.popup-entry-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.popup-entry-copy {
  font-size: 22rpx;
  color: var(--color-muted);
  text-decoration: underline;
  flex-shrink: 0;
}

.popup-entry-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.popup-entry-btn.btn-account { background: #F0F7FF; color: #4A90E2; }
.popup-entry-btn.btn-link { background: #F0FAF4; color: #4A9E6F; }

.popup-tips {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.popup-tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.popup-tips-body {
  padding: 0 0 24rpx;
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.6;
}

.popup-tips-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.popup-tips-label {
  color: var(--color-muted);
  flex-shrink: 0;
  width: 120rpx;
}

/* 数据核验状态 */
.popup-verify { font-size: 24rpx; }
.verify-ok { color: #2f6b3d; }
.verify-warn { color: #b8860b; }

/* ===== 公众号二维码弹层 ===== */
.qr-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 210;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-card {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
}

.qr-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.qr-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.qr-img {
  width: 360rpx;
  height: 360rpx;
  margin-top: 24rpx;
  background: #fff;
}

.qr-close {
  margin-top: 24rpx;
  padding-top: 20rpx;
  width: 100%;
  text-align: center;
  border-top: 1rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-text);
}

/* 官方临时公告红条（闭馆维修 / 临时停开）：上下间距 12px（402 基准 ≈ 22rpx） */
.popup-header--with-notice {
  margin-bottom: 0;
}
.popup-special-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 22rpx 0;
  padding: 14rpx 16rpx;
  background: #FDF3F2;
  border: 1rpx solid #F5C6C0;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #C0392B;
}
/* 图标包裹层与一行文字等高（24rpx × 1.5 = 36rpx）并垂直居中，使图标与首行文字对齐 */
.popup-notice-icon {
  flex-shrink: 0;
  height: 36rpx;
  display: flex;
  align-items: center;
}

/* ===== 底部操作栏（V3.0：本期仅视觉占位，不接交互） =====
   sticky 吸底：内容不超屏时随流收尾；超屏时恒贴弹窗底缘，滚动中按钮可见。
   打开/展开折叠无需 JS 判定——sticky 在两种形态下天然成立，滚动过程不切换。 */
.popup-actions-bar {
  position: sticky;
  bottom: 0;
  margin-top: 8rpx;
  padding: 20rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
}

.popup-actions {
  display: flex;
  gap: 20rpx;
}

.popup-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.popup-btn-primary { background: var(--color-primary); color: #fff; }
.popup-btn-ghost {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  background: transparent;
  box-sizing: border-box;
}

/* B 层（免预约/无固定放票时刻）固定说明 */
.popup-actions-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-muted);
  margin-bottom: 16rpx;
}
